++  drpm: number | null;
++  dgear: number | null;
++}
++
++export interface CheckpointAnalysis {
++  caseName: string;
++  comparisons: CheckpointComparison[];
++  rollout_time_offset_s: number;
++  is_monotonic_drift: boolean;
++  median_abs_dt_ms: number;
++  max_abs_dt_ms: number;
++}
++
++/**
++ * Compute rollout time offset from sim result
++ * This is the absolute time when the vehicle crosses 1 ft (rollout)
++ */
++export function computeRolloutTimeOffset(result: SimResult): number {
++  const { timeslip } = result;
++  
++  // Find entry closest to 1 ft
++  let rolloutEntry = timeslip[0];
++  for (const entry of timeslip) {
++    if (Math.abs(entry.d_ft - 1.0) < Math.abs(rolloutEntry.d_ft - 1.0)) {
++      rolloutEntry = entry;
++    }
++    if (entry.d_ft > 1.0) break;
++  }
++  
++  // Interpolate to exactly 1 ft
++  const idx = timeslip.indexOf(rolloutEntry);
++  if (idx > 0 && rolloutEntry.d_ft > 1.0) {
++    const prev = timeslip[idx - 1];
++    const frac = (1.0 - prev.d_ft) / (rolloutEntry.d_ft - prev.d_ft);
++    return prev.t_s + frac * (rolloutEntry.t_s - prev.t_s);
++  }
++  
++  return rolloutEntry.t_s;
++}
++
++/**
++ * Interpolate sim value at a specific distance
++ */
++function interpolateAtDistance(
++  timeslip: SimResult['timeslip'],
++  targetDist: number,
++  field: 't_s' | 'v_mph'
++): number | null {
++  if (timeslip.length === 0) return null;
++  
++  // Find bracketing entries
++  let before = timeslip[0];
++  let after = timeslip[timeslip.length - 1];
++  
++  for (let i = 0; i < timeslip.length - 1; i++) {
++    if (timeslip[i].d_ft <= targetDist && timeslip[i + 1].d_ft >= targetDist) {
++      before = timeslip[i];
++      after = timeslip[i + 1];
++      break;
++    }
++  }
++  
++  // Exact match
++  if (Math.abs(before.d_ft - targetDist) < 0.01) {
++    return before[field];
++  }
++  if (Math.abs(after.d_ft - targetDist) < 0.01) {
++    return after[field];
++  }
++  
++  // Interpolate
++  const frac = (targetDist - before.d_ft) / (after.d_ft - before.d_ft);
++  return before[field] + frac * (after[field] - before[field]);
++}
++
++/**
++ * Get gear at distance (no interpolation, use nearest)
++ */
++function getGearAtDistance(timeslip: SimResult['timeslip'], targetDist: number): number | null {
++  if (timeslip.length === 0) return null;
++  
++  let nearest = timeslip[0];
++  for (const entry of timeslip) {
++    if (Math.abs(entry.d_ft - targetDist) < Math.abs(nearest.d_ft - targetDist)) {
++      nearest = entry;
++    }
++    if (entry.d_ft > targetDist) break;
++  }
++  
++  return (nearest as any).gear ?? null;
++}
++
++/**
++ * Compare simulation result against checkpoint data
++ * Uses ET clock alignment (not absolute time)
++ */
++export function compareCheckpoints(
++  result: SimResult,
++  checkpointCase: CheckpointCase
++): CheckpointAnalysis {
++  const { timeslip } = result;
++  const { checkpoints, caseId } = checkpointCase;
++  
++  // Compute rollout time offset
++  const rollout_time_offset_s = computeRolloutTimeOffset(result);
++  
++  const comparisons: CheckpointComparison[] = [];
++  
++  for (const checkpoint of checkpoints) {
++    // Skip rollout row in comparisons (it's a boundary marker)
++    if (checkpoint.label === 'Rollout') {
++      continue;
++    }
++    
++    const dist_ft = checkpoint.dist_ft;
++    
++    // Interpolate sim values at checkpoint distance
++    const sim_time_abs = interpolateAtDistance(timeslip, dist_ft, 't_s');
++    const sim_mph = interpolateAtDistance(timeslip, dist_ft, 'v_mph');
++    const sim_rpm = null; // RPM not in timeslip
++    const sim_gear = getGearAtDistance(timeslip, dist_ft);
++    
++    // Convert sim absolute time to ET clock
++    const sim_time_et_s = sim_time_abs !== null ? sim_time_abs - rollout_time_offset_s : null;
++    
++    // Compute deltas
++    const dt_ms = sim_time_et_s !== null ? (sim_time_et_s - checkpoint.time_et_s) * 1000 : null;
++    const dmph = sim_mph !== null && checkpoint.mph !== null ? sim_mph - checkpoint.mph : null;
++    const drpm = null; // RPM not available
++    const dgear = sim_gear !== null && checkpoint.gear !== null ? sim_gear - checkpoint.gear : null;
++    
++    comparisons.push({
++      checkpoint,
++      sim_time_et_s,
++      sim_mph,
++      sim_rpm,
++      sim_gear,
++      dt_ms,
++      dmph,
++      drpm,
++      dgear,
++    });
++  }
++  
++  // Analyze drift pattern
++  const dt_values = comparisons.map(c => c.dt_ms).filter((v): v is number => v !== null);
++  const abs_dt_values = dt_values.map(Math.abs);
++  abs_dt_values.sort((a, b) => a - b);
++  
++  const median_abs_dt_ms = abs_dt_values.length > 0 ? abs_dt_values[Math.floor(abs_dt_values.length / 2)] : 0;
++  const max_abs_dt_ms = abs_dt_values.length > 0 ? abs_dt_values[abs_dt_values.length - 1] : 0;
++  
++  // Check for monotonic drift (no large jumps)
++  let is_monotonic_drift = true;
++  for (let i = 1; i < dt_values.length; i++) {
++    const jump = Math.abs(dt_values[i] - dt_values[i - 1]);
++    if (jump > 50) { // 50ms jump threshold
++      is_monotonic_drift = false;
++      break;
++    }
++  }
++  
++  return {
++    caseName: caseId,
++    comparisons,
++    rollout_time_offset_s,
++    is_monotonic_drift,
++    median_abs_dt_ms,
++    max_abs_dt_ms,
++  };
++}
