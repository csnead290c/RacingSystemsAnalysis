++    rawInputs.tractionIndex = environment.tractionIndex;
++  }
++  
++  // Vehicle fields
++  if (vehicle.weightLb !== undefined) {
++    rawInputs.weightLb = vehicle.weightLb;
++  }
++  if (vehicle.wheelbaseIn !== undefined) {
++    rawInputs.wheelbaseIn = vehicle.wheelbaseIn;
++  }
++  if (vehicle.rolloutIn !== undefined) {
++    rawInputs.rolloutIn = vehicle.rolloutIn;
++  }
++  if (vehicle.rearGear !== undefined) {
++    rawInputs.rearGear = vehicle.rearGear;
++  }
++  
++  // Tire fields
++  if (vehicle.tireDiameterIn !== undefined) {
++    rawInputs.tireDiaIn = vehicle.tireDiameterIn;
++  }
++  if (vehicle.tireRolloutIn !== undefined) {
++    rawInputs.tireRolloutIn = vehicle.tireRolloutIn;
++  }
++  if (vehicle.tireWidthIn !== undefined) {
++    rawInputs.tireWidthIn = vehicle.tireWidthIn;
++  }
++  
++  // Aerodynamics
++  if (vehicle.frontalArea_ft2 !== undefined) {
++    rawInputs.frontalArea_ft2 = vehicle.frontalArea_ft2;
++  }
++  if (vehicle.dragCoeff !== undefined) {
++    rawInputs.dragCoeff = vehicle.dragCoeff;
++  }
++  
++  // Drivetrain mode
++  if (vehicle.transmissionType === 'Converter') {
++    rawInputs.drivetrainMode = 'torqueConverter';
++  } else if (vehicle.transmissionType === 'Clutch') {
++    rawInputs.drivetrainMode = 'centrifugalClutch';
