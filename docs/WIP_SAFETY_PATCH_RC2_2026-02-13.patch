++/**
++ * Sim Options Builder
++ *
++ * Constructs a FromVehicleOptions object from UI-level What-If parameters.
++ * Centralises the mapping so every sim page builds options identically.
++ */
++
++import type { FromVehicleOptions } from '../../dev/vb6/fromVehicle';
++import type { SimEngineWhatIf } from './simOverrides';
++
++export interface BuildFromVehicleOptionsParams {
++  /** Force QuarterJr mode (e.g. user lacks Pro access) */
++  forceQuarterJr?: boolean;
++  /** Additive HP delta from What-If slider */
++  engineHpDelta?: number;
++  /** Multiplicative dyno curve scale (future) */
++  engineCurveScale?: number;
++  /** When false, ignore install links and use manual/legacy fields (non-Pro). Default: true */
++  allowInstall?: boolean;
++}
++
++/**
++ * Build a `FromVehicleOptions` object from UI-level parameters.
++ *
++ * Usage:
++ * ```ts
++ * const opts = buildFromVehicleOptions({ forceQuarterJr: true, engineHpDelta: 50 });
++ * const fixture = fromVehicleToVB6Fixture(vehicle, opts);
++ * ```
++ */
++export function buildFromVehicleOptions(params: BuildFromVehicleOptionsParams = {}): FromVehicleOptions {
++  const { forceQuarterJr, engineHpDelta, engineCurveScale, allowInstall } = params;
++
++  // Only create the whatIf object if at least one field is non-trivial
++  let engineWhatIf: SimEngineWhatIf | undefined;
++  if ((engineHpDelta != null && engineHpDelta !== 0) || (engineCurveScale != null && engineCurveScale !== 1)) {
++    engineWhatIf = {};
++    if (engineHpDelta != null && engineHpDelta !== 0) engineWhatIf.hpDelta = engineHpDelta;
++    if (engineCurveScale != null && engineCurveScale !== 1) engineWhatIf.curveScale = engineCurveScale;
++  }
++
++  return {
++    ...(forceQuarterJr != null ? { forceQuarterJr } : {}),
++    ...(engineWhatIf ? { engineWhatIf } : {}),
++    ...(allowInstall != null ? { allowInstall } : {}),
++  };
++}
