++/**
++ * EnginesLibrary — Full-page engine asset library
++ *
++ * Search, sort, paginate, tag, edit, and delete engine assets.
++ * Built on the shared ComponentLibraryList component.
++ */
++
++import { useState, useCallback, useMemo } from 'react';
++import Page from '../shared/components/Page';
++import { ComponentLibraryList, type LibraryColumn, type LibrarySortOption } from '../shared/components/ComponentLibraryList';
++import type { EngineAsset, EngineAssetKind } from '../domain/library/engineAssets';
++import { listEngineAssets, updateEngineAsset, deleteEngineAsset } from '../state/engineAssets';
++
++// ── Kind labels ──────────────────────────────────────────────────────
++
++const KIND_LABELS: Record<EngineAssetKind, string> = {
++  sim: 'Sim',
++  manual_peak: 'Peak',
++  dyno_curve: 'Dyno',
++};
++
++const KIND_COLORS: Record<EngineAssetKind, string> = {
++  sim: '#8b5cf6',
++  manual_peak: '#3b82f6',
++  dyno_curve: '#f59e0b',
++};
++
++// ── Helpers ──────────────────────────────────────────────────────────
++
++function getAssetPeakHP(asset: EngineAsset): number {
++  switch (asset.kind) {
++    case 'sim': return asset.payload.engineSimResultSummary.peakHP;
++    case 'manual_peak': return asset.payload.peakHP;
++    case 'dyno_curve': return Math.max(...asset.payload.points.map(p => p.hp), 0);
++  }
++}
++
++function formatDate(iso: string): string {
++  try {
++    return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
++  } catch {
++    return iso.slice(0, 10);
++  }
++}
++
++// ── Columns ──────────────────────────────────────────────────────────
++
++const COLUMNS: LibraryColumn<EngineAsset>[] = [
++  {
++    label: 'Name',
++    width: '35%',
++    render: (a) => (
++      <div>
++        <div style={{ fontWeight: 600, fontSize: '0.82rem' }}>{a.name}</div>
++        <div style={{ fontSize: '0.7rem', color: 'var(--color-text-muted, #888)', marginTop: '1px' }}>
++          {a.kind === 'sim' && `${Math.round(a.payload.engineSimResultSummary.peakHP)} HP @ ${Math.round(a.payload.engineSimResultSummary.peakHpRpm)} RPM`}
++          {a.kind === 'manual_peak' && `${Math.round(a.payload.peakHP)} HP @ ${Math.round(a.payload.peakHpRpm)} RPM`}
++          {a.kind === 'dyno_curve' && `${a.payload.points.length} points • Peak ${Math.round(getAssetPeakHP(a))} HP`}
++        </div>
++      </div>
++    ),
++  },
++  {
++    label: 'Kind',
++    width: '70px',
++    render: (a) => (
++      <span style={{
++        display: 'inline-block',
++        padding: '1px 7px',
++        fontSize: '0.68rem',
++        fontWeight: 600,
++        borderRadius: '3px',
++        backgroundColor: `${KIND_COLORS[a.kind]}18`,
++        color: KIND_COLORS[a.kind],
++      }}>
++        {KIND_LABELS[a.kind]}
++      </span>
++    ),
++  },
++  {
++    label: 'Updated',
++    width: '100px',
++    render: (a) => <span style={{ fontSize: '0.75rem', color: 'var(--color-text-muted, #888)' }}>{formatDate(a.updatedAt)}</span>,
++  },
++  {
++    label: 'Rev',
++    width: '45px',
++    render: (a) => <span style={{ fontSize: '0.75rem' }}>{a.revision}</span>,
++  },
++];
++
++// ── Sort ─────────────────────────────────────────────────────────────
++
++const SORT_OPTIONS: LibrarySortOption[] = [
++  { value: 'updated', label: 'Recently Updated' },
++  { value: 'name', label: 'Name (A-Z)' },
++  { value: 'hp', label: 'Peak HP (High-Low)' },
++];
++
++function sortEngines(items: EngineAsset[], key: string): EngineAsset[] {
++  const sorted = [...items];
++  switch (key) {
++    case 'updated': return sorted.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
++    case 'name': return sorted.sort((a, b) => a.name.localeCompare(b.name));
++    case 'hp': return sorted.sort((a, b) => getAssetPeakHP(b) - getAssetPeakHP(a));
++    default: return sorted;
++  }
++}
++
++// ── Search ───────────────────────────────────────────────────────────
++
++function searchEngine(item: EngineAsset, query: string): boolean {
++  return (
++    item.name.toLowerCase().includes(query) ||
++    item.kind.toLowerCase().includes(query) ||
++    (item.tags?.some(t => t.toLowerCase().includes(query)) ?? false)
++  );
++}
++
++// ── Page Component ───────────────────────────────────────────────────
++
++export default function EnginesLibrary() {
++  const [refreshKey, setRefreshKey] = useState(0);
++
++  const items = useMemo(() => {
++    void refreshKey; // dependency trigger
++    return listEngineAssets('personal');
++  }, [refreshKey]);
++
++  const handleDelete = useCallback((id: string) => {
++    if (!window.confirm('Delete this engine asset permanently?')) return;
++    deleteEngineAsset(id);
++    setRefreshKey(k => k + 1);
++  }, []);
++
++  const handleTagsChange = useCallback((id: string, tags: string[]) => {
++    updateEngineAsset(id, { tags } as any);
++    setRefreshKey(k => k + 1);
++  }, []);
++
++  return (
++    <Page title="Engine Library">
++      <div style={{ maxWidth: '900px', margin: '0 auto', padding: '16px' }}>
++        <ComponentLibraryList<EngineAsset>
++          title="Engines"
++          items={items}
++          columns={COLUMNS}
++          sortOptions={SORT_OPTIONS}
++          defaultSort="updated"
++          sortFn={sortEngines}
++          searchFn={searchEngine}
++          onDelete={handleDelete}
++          onTagsChange={handleTagsChange}
++          emptyMessage="No engine assets yet. Save one from Engine Sim."
++          teamEnabled={false}
++        />
++      </div>
++    </Page>
++  );
++}
