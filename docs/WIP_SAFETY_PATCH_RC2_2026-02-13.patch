++/**
++ * Format a step trace row as CSV
++ */
++export function stepTraceRowToCsv(row: StepTraceRow): string {
++  return [
++    row.stepIndex,
++    row.t_abs_s.toFixed(6),
++    row.t_et_s.toFixed(6),
++    row.dt_s.toFixed(6),
