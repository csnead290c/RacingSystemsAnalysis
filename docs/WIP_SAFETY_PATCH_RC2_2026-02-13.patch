++/**
++ * Adapter: User-provided VB6 JSON fixtures → TS SimInputs
++ * 
++ * The user-provided JSON fixtures (QuarterJrTest1, QuarterProTest1, BonnevilleProTest1)
++ * use arbitrary field names that don't match the internal TS SimInputs schema.
++ * This adapter maps them explicitly.
++ * 
++ * ASSUMPTIONS (documented for easy adjustment):
++ * - fixture.inputs.vehicle.weightLb → vehicle.weightLb
++ * - fixture.inputs.vehicle.engineDyno[] → vehicle.hpCurve[] (QuarterPro/Bonneville)
++ * - fixture.inputs.vehicle.peakHorsepower → vehicle.powerHP (QuarterJr, no dyno curve)
++ * - fixture.inputs.vehicle.transmissionGearing[] → gearRatios/gearEff/shiftRPMs
++ * - fixture.inputs.vehicle.transmissionType "Clutch"|"Converter" → 'clutch'|'converter'
++ * - fixture.inputs.vehicle.rotationalInertia → pmi fields (QuarterPro only)
++ * - fixture.inputs.environment → env fields
++ * - fixture.inputs.track → raceLength mapping (Bonneville)
++ * - fixture.outputs.pdfCheckpoints[] → VB6 reference checkpoints
++ * - fixture.outputs.timeslipSummary → VB6 reference summary (QuarterJr/Pro only)
++ */
++
++import type { RaceLength } from '../../domain/config/raceLengths';
++
++// ============================================================================
++// Fixture JSON types (what the JSON files actually contain)
++// ============================================================================
++
++export interface FixtureGear {
++  gear: number;
++  ratio: number;
++  efficiency?: number;  // QuarterPro only
++  shiftRpm?: number;    // QuarterPro only (per-gear shift RPM)
++}
++
++export interface FixtureDynoPoint {
++  rpm: number;
++  hp: number;
++  tq?: number;
++}
++
++export interface FixtureVehicle {
++  weightLb: number;
++  wheelbaseIn: number;
++  rolloutIn?: number;
++  overhangIn?: number;
++  rearGear: number;
++  tireDiameterIn?: number;    // QuarterJr
++  tireWidthIn?: number;
++  tireRolloutIn?: number;     // QuarterPro/Bonneville (circumference)
++  fuelSystem?: string;
++  frontalArea_ft2?: number;
++  bodyStyle?: string;
++  dragCoeff?: number;         // QuarterPro/Bonneville
++  liftCoeff?: number;         // QuarterPro/Bonneville
++  drivetrainEfficiency?: number;
++  hpTorqueMultiplier?: number;
++
++  // Transmission
++  transmissionType: string;   // "Clutch" | "Converter"
++  transmissionGearing: FixtureGear[];
++
++  // Converter fields (QuarterJr)
++  stallRpm?: number;
++  converterDiameterIn?: number;
++  lockupOption?: boolean;
++
++  // Clutch fields (QuarterPro/Bonneville)
++  launchRpm?: number;
++  slipRpm?: number;
++  clutchSlippage?: number;
++
++  // QuarterJr simple engine
++  engineDisplacement?: number;
++  peakHorsepower?: number;
++  peakHorsepowerRpm?: number;
++  shiftRpm?: number;          // Single shift RPM for all gears (QuarterJr)
++
++  // QuarterPro/Bonneville dyno curve
++  engineDyno?: FixtureDynoPoint[];
++
++  // PMI (QuarterPro only)
++  rotationalInertia?: {
++    engineFlywheelClutchPMI: number;
++    transmissionDriveshaftPMI: number;
++    tiresWheelsRingGearPMI: number;
++  };
++}
++
++export interface FixtureEnvironment {
++  elevationFt: number;
++  barometerInHg: number;
++  temperatureF: number;
++  relativeHumidityPct: number;
++  tractionIndex?: number;
++  windVelocityMph?: number;
++  windAngleDeg?: number;
++  trackTempF?: number;
++}
++
++export interface FixtureCheckpoint {
++  label?: string;
++  time_s?: number;
++  time_abs_s?: number;
++  time_et_s?: number;
++  distance_ft?: number;
++  distance?: string;      // "Rollout" for rollout row
++  mph: number;
++  accel: number;
++  gear: number;
++  rpm: number;
++  hp?: number;
++  tq?: number;
++  slip?: number;
++}
++
++export interface FixtureSummary {
++  eighthMile?: { et_s: number; mph: number; distance_ft: number };
++  quarterMile?: { et_s: number; mph: number; distance_ft: number };
++}
++
++export interface UserVB6Fixture {
++  schemaVersion: string;
++  caseId: string;
++  model: string;          // "QuarterJr" | "QuarterPro" | "BonnevillePro"
++  source: { file: string; note: string };
++  inputs: {
++    vehicle: FixtureVehicle;
++    environment: FixtureEnvironment;
++    track?: string;       // Bonneville only, e.g. "Bonneville - 5 Miles"
++  };
++  outputs: {
++    pdfCheckpoints: FixtureCheckpoint[];
++    timeslipSummary?: FixtureSummary;
++  };
++}
