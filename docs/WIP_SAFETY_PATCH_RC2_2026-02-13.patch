++/**
++ * Run simulation and get actual rows
++ * Uses same approach as vb6_equivalence.spec.ts
++ */
++async function runSimulation(fixture: JsonFixture): Promise<ActualRow[]> {
++  // Dynamic import to avoid circular dependencies
++  const { runClassicSimCase } = await import('../helpers/classic_sim_runner');
++  const { jsonToClassicRawInputs } = await import('../helpers/json_to_classic_raw');
++  const { normalizeClassicCase } = await import('../helpers/classic_input_normalize');
++  
++  // Determine model from caseId or fixture
++  let model: 'QuarterPro' | 'QuarterJr' | 'BonnevillePro' = 'QuarterPro';
++  if (fixture.caseId.includes('QuarterJr')) {
++    model = 'QuarterJr';
++  } else if (fixture.caseId.includes('Bonneville')) {
++    model = 'BonnevillePro';
++  }
++  
++  // Map JSON to raw inputs (same as vb6_equivalence.spec.ts)
++  const rawInputs = jsonToClassicRawInputs(fixture as any);
++  
++  // Normalize to effective inputs
++  const { effective } = normalizeClassicCase(
++    fixture.caseId,
++    model,
++    rawInputs,
++    []
++  );
++  
++  // Run simulation
++  const checkpoints = await runClassicSimCase(model, effective, [], rawInputs);
++  
++  // Map to ActualRow format
++  return checkpoints.map((cp: any) => ({
++    label: cp.label,
++    time_s: cp.time_et_s ?? cp.time_s ?? null,
++    distance_ft: cp.dist_ft ?? cp.distance_ft ?? null,
