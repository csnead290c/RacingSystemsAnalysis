++describe('Land Speed Timeslip Rendering', () => {
++  // Synthetic Bonneville trace: accelerating from 0 to ~250 mph over 5 miles
++  // Trace overshoots to 26450ft (past 5mi=26400ft) to simulate sim overshoot
++  const bonnevilleTrace: Array<{ s_ft: number; t_s: number; v_mph: number }> = [];
