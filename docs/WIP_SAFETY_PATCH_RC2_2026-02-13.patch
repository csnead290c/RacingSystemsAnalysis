++def extract_text_from_pdf(pdf_path: Path, page_num: int = 0) -> str:
++    """Extract text from a PDF page using PyMuPDF."""
++    doc = fitz.open(pdf_path)
++    if page_num >= len(doc):
++        doc.close()
++        return ""
++    
++    page = doc[page_num]
++    text = page.get_text()
++    doc.close()
++    return text
++
++
++def find_checkpoint_table(text: str) -> tuple[int, int]:
++    """
++    Find the start and end line indices of the checkpoint table.
++    
++    Returns (start_idx, end_idx) where start_idx is the line after the header,
++    and end_idx is the line before the summary.
++    """
++    lines = text.split('\n')
++    
++    # Find header line containing key columns
++    start_idx = -1
++    for i, line in enumerate(lines):
++        if 'Time' in line and 'Distance' in line and 'MPH' in line and 'Gear' in line and 'RPM' in line:
++            start_idx = i + 1
++            break
++    
++    if start_idx == -1:
++        return (-1, -1)
++    
++    # Find end of table (summary line with "Mile:" or empty lines)
++    end_idx = len(lines)
++    for i in range(start_idx, len(lines)):
++        line = lines[i]
++        if 'Mile:' in line or 'SUMMARY' in line.upper():
++            end_idx = i
++            break
++        # Also stop at multiple consecutive empty lines
++        if i < len(lines) - 2:
++            if not line.strip() and not lines[i+1].strip():
++                end_idx = i
++                break
++    
++    return (start_idx, end_idx)
++
++
++def parse_summary_line(text: str) -> Summary:
++    """
++    Parse the summary line containing ET and MPH for 1/8 and 1/4 mile.
++    
++    Expected format:
++    "1/8 Mile: 4.37 sec @ 160.9 MPH   1/4 Mile: 6.80 sec @ 202.3 MPH"
++    or
++    "Mile: 4.37 sec @ 160.9 MPH   1/4 Mile: 6.80 sec @ 202.3 MPH"
++    """
++    summary = Summary()
++    
++    # Pattern for 1/8 mile
++    eighth_match = re.search(r'(?:1/8\s+Mile|Mile):\s*([\d.]+)\s*sec\s*@\s*([\d.]+)\s*MPH', text, re.IGNORECASE)
++    if eighth_match:
++        summary.eighth_et_s = float(eighth_match.group(1))
++        summary.eighth_mph = float(eighth_match.group(2))
++    
++    # Pattern for 1/4 mile
++    quarter_match = re.search(r'1/4\s+Mile:\s*([\d.]+)\s*sec\s*@\s*([\d.]+)\s*MPH', text, re.IGNORECASE)
++    if quarter_match:
++        summary.quarter_et_s = float(quarter_match.group(1))
++        summary.quarter_mph = float(quarter_match.group(2))
++    
++    return summary
++
++
++def extract_checkpoints_from_text(text: str) -> tuple[List[Checkpoint], Summary]:
++    """Extract checkpoints and summary from PDF text."""
++    lines = text.split('\n')
++    start_idx, end_idx = find_checkpoint_table(text)
++    
++    if start_idx == -1:
++        return ([], Summary())
++    
++    checkpoints = []
++    for i in range(start_idx, end_idx):
++        if i >= len(lines):
++            break
++        
