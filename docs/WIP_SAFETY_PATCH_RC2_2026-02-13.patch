++/**
++ * JSON to ClassicRawInputs Mapper
++ * Maps JSON test case format to ClassicRawInputs for normalization pipeline
++ * 
++ * CRITICAL: This mapper must preserve ALL fields from JSON to avoid physics deltas.
++ * Missing fields can cause huge simulation errors (e.g., missing frontalArea_ft2,
++ * drivetrainEfficiency, PMI values, etc.)
++ */
++
++import type { ClassicRawInputs } from './classic_types';
++import type { ClassicJsonCase } from '../json-fixtures/classic_json_case_types';
++
++export function jsonToClassicRawInputs(jsonCase: ClassicJsonCase): ClassicRawInputs {
++  const { inputs, model } = jsonCase;
++  const { vehicle, environment } = inputs;
++  
++  const raw: ClassicRawInputs = {};
++  
++  // ============================================================================
++  // CORE VEHICLE
++  // ============================================================================
++  
++  if (vehicle.weightLb !== undefined) {
++    raw.weightLb = vehicle.weightLb;
++  }
++  
++  if (vehicle.wheelbaseIn !== undefined) {
++    raw.wheelbaseIn = vehicle.wheelbaseIn;
++  }
++  
++  if (vehicle.overhangIn !== undefined) {
++    raw.overhangIn = vehicle.overhangIn;
++  }
++  
++  // ============================================================================
++  // TIRES
++  // ============================================================================
++  
++  if (vehicle.tireDiameterIn !== undefined) {
++    raw.tireDiaIn = vehicle.tireDiameterIn;
++  }
++  
++  if (vehicle.tireRolloutIn !== undefined) {
++    raw.tireRolloutIn = vehicle.tireRolloutIn;
++  }
++  
++  if (vehicle.tireWidthIn !== undefined) {
++    raw.tireWidthIn = vehicle.tireWidthIn;
++  }
++  
++  // ============================================================================
++  // ROLLOUT (STAGING)
++  // ============================================================================
++  
++  if (vehicle.rolloutIn !== undefined) {
++    raw.rolloutIn = vehicle.rolloutIn;
++  }
++  
++  // ============================================================================
++  // DRIVETRAIN
++  // ============================================================================
++  
++  if (vehicle.rearGear !== undefined) {
++    raw.rearGear = vehicle.rearGear;
++  }
++  
++  if (vehicle.drivetrainEfficiency !== undefined) {
++    raw.drivetrainEfficiency = vehicle.drivetrainEfficiency;
++  }
++  
++  // Drivetrain mode from transmissionType
++  if (vehicle.transmissionType === 'Converter') {
++    raw.drivetrainMode = 'torqueConverter';
++  } else if (vehicle.transmissionType === 'Clutch') {
++    raw.drivetrainMode = 'centrifugalClutch';
++  }
++  
++  // ============================================================================
++  // TRANSMISSION GEARING
++  // ============================================================================
++  
++  if (vehicle.transmissionGearing && vehicle.transmissionGearing.length > 0) {
++    // Use vehicle-level shiftRpm as default if individual gears don't specify it
++    const defaultShiftRpm = vehicle.shiftRpm;
++    
++    raw.transmissionGearing = vehicle.transmissionGearing.map(g => ({
++      gear: g.gear,
++      ratio: g.ratio,
++      efficiency: g.efficiency,
++      shiftRpm: g.shiftRpm ?? defaultShiftRpm, // Use gear-specific or vehicle-level default
++    }));
++  }
++  
++  if (vehicle.shiftRpm !== undefined) {
++    raw.shiftRpm = vehicle.shiftRpm;
++  }
++  
++  // ============================================================================
++  // TORQUE CONVERTER
++  // ============================================================================
++  
++  if (vehicle.stallRpm !== undefined) {
++    raw.stallRpm = vehicle.stallRpm;
++    raw.converterStallRpm = vehicle.stallRpm; // Store both for compatibility
++  }
++  
++  if (vehicle.converterDiameterIn !== undefined) {
++    raw.converterDiameterIn = vehicle.converterDiameterIn;
++  }
++  
++  // ============================================================================
++  // CLUTCH
++  // ============================================================================
++  
++  if (vehicle.launchRpm !== undefined) {
++    raw.launchRpm = vehicle.launchRpm;
++  }
++  
++  if (vehicle.slipRpm !== undefined) {
++    raw.slipRpm = vehicle.slipRpm;
++  }
++  
++  if (vehicle.clutchSlippage !== undefined) {
++    raw.clutchSlippage = vehicle.clutchSlippage;
++  }
++  
++  // ============================================================================
++  // LOCKUP
++  // ============================================================================
++  
++  if (vehicle.lockupOption !== undefined) {
++    raw.lockupOption = vehicle.lockupOption;
++  }
++  
++  // ============================================================================
++  // AERODYNAMICS
++  // ============================================================================
++  
++  if (vehicle.frontalArea_ft2 !== undefined) {
++    raw.frontalArea_ft2 = vehicle.frontalArea_ft2;
++  }
++  
++  if (vehicle.dragCoeff !== undefined) {
++    raw.dragCoeff = vehicle.dragCoeff;
++  }
++  
++  if (vehicle.liftCoeff !== undefined) {
++    raw.liftCoeff = vehicle.liftCoeff;
++  }
++  
++  // ============================================================================
++  // ROTATIONAL INERTIA (PMI)
++  // ============================================================================
++  
++  if (vehicle.rotationalInertia) {
++    if (vehicle.rotationalInertia.engineFlywheelClutchPMI !== undefined) {
++      raw.engineFlywheelClutchPMI = vehicle.rotationalInertia.engineFlywheelClutchPMI;
++    }
++    if (vehicle.rotationalInertia.transmissionDriveshaftPMI !== undefined) {
++      raw.transmissionDriveshaftPMI = vehicle.rotationalInertia.transmissionDriveshaftPMI;
++    }
++    if (vehicle.rotationalInertia.tiresWheelsRingGearPMI !== undefined) {
++      raw.tiresWheelsRingGearPMI = vehicle.rotationalInertia.tiresWheelsRingGearPMI;
++    }
++  }
++  
++  // ============================================================================
++  // ENGINE
++  // ============================================================================
++  
++  if (vehicle.engineDisplacement !== undefined) {
++    raw.engineDisplacementCid = vehicle.engineDisplacement;
++  }
++  
++  if (vehicle.fuelSystem !== undefined) {
++    raw.fuelSystem = vehicle.fuelSystem;
++  }
++  
++  // ============================================================================
++  // POWER MODE
++  // ============================================================================
++  
++  if (vehicle.engineDyno && vehicle.engineDyno.length > 0) {
++    // QuarterPro/BonnevillePro: use HP curve
++    raw.hpCurve = vehicle.engineDyno.map(pt => ({
++      rpm: pt.rpm,
++      hp: pt.hp,
++      tq: pt.tq,
++    }));
++  } else if (vehicle.peakHorsepower !== undefined) {
++    // QuarterJr: use simple powerHP mode
++    raw.powerHP = vehicle.peakHorsepower;
++    
++    if (vehicle.peakHorsepowerRpm !== undefined) {
++      raw.peakHPRPM = vehicle.peakHorsepowerRpm;
++    }
++  }
++  
++  // HP/Torque multiplier
++  if (vehicle.hpTorqueMultiplier !== undefined) {
++    raw.hpTorqueMultiplier = vehicle.hpTorqueMultiplier;
++  }
++  
++  // ============================================================================
++  // ENVIRONMENT
++  // ============================================================================
++  
++  if (environment.elevationFt !== undefined) {
++    raw.elevation = environment.elevationFt;
++  }
++  
++  if (environment.barometerInHg !== undefined) {
++    raw.barometerInHg = environment.barometerInHg;
++  }
++  
++  if (environment.temperatureF !== undefined) {
++    raw.temperatureF = environment.temperatureF;
++  }
++  
++  if (environment.relativeHumidityPct !== undefined) {
++    raw.humidityPct = environment.relativeHumidityPct;
++  }
++  
++  if (environment.tractionIndex !== undefined) {
++    raw.tractionIndex = environment.tractionIndex;
++  }
++  
++  if (environment.windVelocityMph !== undefined) {
++    raw.windVelocityMph = environment.windVelocityMph;
++  }
++  
++  if (environment.windAngleDeg !== undefined) {
++    raw.windAngleDeg = environment.windAngleDeg;
++  }
++  
++  if (environment.trackTempF !== undefined) {
++    raw.trackTempF = environment.trackTempF;
++  }
++  
++  // ============================================================================
++  // METADATA
++  // ============================================================================
++  
++  // Track which fields were extracted from JSON
++  raw.extractedFieldKeys = Object.keys(raw).filter(k => k !== 'extractedFieldKeys');
++  
++  return raw;
++}
+diff --git a/src/integration-tests/helpers/physics_divergence_packet.ts b/src/integration-tests/helpers/physics_divergence_packet.ts
