++/**
++ * Strip comments and strings from TypeScript code to avoid false positives
++ */
++function stripCommentsAndStrings(code: string): string {
++  let result = '';
++  let i = 0;
++  
++  while (i < code.length) {
++    // Single-line comment
++    if (code[i] === '/' && code[i + 1] === '/') {
++      while (i < code.length && code[i] !== '\n') i++;
++      continue;
++    }
++    
++    // Multi-line comment
++    if (code[i] === '/' && code[i + 1] === '*') {
++      i += 2;
++      while (i < code.length - 1 && !(code[i] === '*' && code[i + 1] === '/')) i++;
++      i += 2;
++      continue;
++    }
++    
++    // Template literal
++    if (code[i] === '`') {
++      i++;
++      while (i < code.length && code[i] !== '`') {
++        if (code[i] === '\\') i++; // Skip escaped char
++        i++;
++      }
++      i++;
++      continue;
++    }
++    
++    // Double-quoted string
++    if (code[i] === '"') {
++      i++;
++      while (i < code.length && code[i] !== '"') {
++        if (code[i] === '\\') i++; // Skip escaped char
++        i++;
++      }
++      i++;
++      continue;
++    }
++    
++    // Single-quoted string
++    if (code[i] === "'") {
++      i++;
++      while (i < code.length && code[i] !== "'") {
++        if (code[i] === '\\') i++; // Skip escaped char
++        i++;
++      }
++      i++;
++      continue;
++    }
++    
++    result += code[i];
++    i++;
++  }
++  
++  return result;
++}
