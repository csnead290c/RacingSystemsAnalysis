++### File: `src/domain/physics/vb6/vb6DisplayFormat.ts` (NEW)
++
++**Purpose:** VB6 Format$() display pipeline with Float32 cast for rounding parity
++
++**Key Functions:**
++```typescript
++export function formatET_QP(et_s: number): string {
++  // VB6 stores ET as Double, no Float32 cast needed
++  const rounded = bankersRound(et_s, 2);
++  return rounded.toFixed(2);
++}
++
++export function formatMPH_QP(mph: number): string {
++  // CRITICAL: VB6 stores trap MPH as Single (Float32) before formatting
++  // This Float32 cast is CRITICAL for matching VB6's rounding at boundaries
++  const asSingle = toFloat32(mph);
++  const rounded = bankersRound(asSingle, 1);
++  return rounded.toFixed(1);
++}
++```
++
++**Why Float32 Cast Matters:**
++```
++Example rounding cliff:
++- VB6: 160.953692 → toFloat32 → 160.95369... → round → 161.0
++- Without cast: 160.953692 → round → 161.0
++- With cast: matches VB6's Single precision before Format$()
++```
++
++### File: `src/domain/physics/vb6/quarterProOutput.ts` (REWRITTEN)
++
++**Purpose:** Extract QuarterPro summary from SimResult using proven VB6 logic
++
++```typescript
++export function extractQuarterProSummary(
++  result: SimResult,
++  raceLength: 'EIGHTH' | 'QUARTER'
++): QuarterProSummary {
++  const finishFt = raceLength === 'EIGHTH' ? 660 : 1320;
++  
++  // Find timeslip entry at finish distance
++  // VB6Exact creates exact entries at 660 and 1320 ft with trap speed MPH
++  const finishEntry = result.timeslip.find(e => Math.abs(e.d_ft - finishFt) < 0.01);
++  
++  // Extract raw values
++  const et_raw_s = finishEntry.t_s;
++  const mph_raw = finishEntry.v_mph;  // Already trap speed, not instantaneous
++  
++  // Apply VB6 display formatting pipeline
++  const et_disp = formatET_QP(et_raw_s);
++  const mph_disp = formatMPH_QP(mph_raw);  // Float32 cast inside
++  
++  return { et_raw_s, mph_raw, et_disp, mph_disp };
++}
++```
