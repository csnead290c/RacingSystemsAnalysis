++++ b/src/integration-tests/fixture_integrity.spec.ts
+@@ -0,0 +1,83 @@
++/**
++ * Fixture Integrity Guard
++ * 
++ * This test ensures VB6 ground truth fixtures are not accidentally modified.
++ * Fixtures represent authoritative VB6 printout data and must not be changed
++ * without explicit approval and evidence from actual VB6 output.
++ * 
++ * If this test fails, it means a fixture was modified. To fix:
++ * 1. Revert the fixture: git checkout -- path/to/fixture.json
++ * 2. If the fixture truly needs updating (with VB6 evidence), update the manifest hash
++ */
++
++import { describe, it, expect } from 'vitest';
++import * as crypto from 'crypto';
++import * as fs from 'fs';
++import * as path from 'path';
++
++// Load the manifest
++const manifestPath = path.join(__dirname, 'json-fixtures', 'fixture_manifest.json');
++const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
++
++function computeSHA256(filePath: string): string {
++  const content = fs.readFileSync(filePath);
++  return crypto.createHash('sha256').update(content).digest('hex');
++}
++
++describe('Fixture Integrity Guard', () => {
++  it('should verify all fixture hashes match manifest', () => {
++    const fixturesDir = path.join(__dirname, 'json-fixtures');
++    const failures: string[] = [];
++
++    for (const [filename, expectedHash] of Object.entries(manifest.hashes)) {
++      const filePath = path.join(fixturesDir, filename);
++      
++      if (!fs.existsSync(filePath)) {
++        failures.push(`Missing fixture: ${filename}`);
++        continue;
++      }
++
++      const actualHash = computeSHA256(filePath);
++      if (actualHash !== expectedHash) {
++        failures.push(
++          `Fixture modified: ${filename}\n` +
++          `  Expected: ${expectedHash}\n` +
++          `  Actual:   ${actualHash}\n` +
++          `  To revert: git checkout -- ${filePath}`
++        );
++      }
++    }
++
++    if (failures.length > 0) {
++      console.error('\n' + '='.repeat(60));
++      console.error('FIXTURE INTEGRITY VIOLATION');
