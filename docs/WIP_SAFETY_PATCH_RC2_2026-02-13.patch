++ *
++ * Compact inline badge that shows the engine data source for a vehicle
++ * in sim pages. Handles:
++ *   - Installed asset (name + pinned revision)
++ *   - Manual entry
++ *   - Legacy fields (powerHP / hpCurve)
++ *   - Missing asset warning with fallback info
++ *   - No engine data (blocks sim with helpful message)
++ */
++
++import { useMemo } from 'react';
++import { resolveVehicleEngine, type EffectiveEngine } from '../../domain/vehicles/effectiveEngine';
++import { getEngineAsset } from '../../state/engineAssets';
++
++interface EngineSourceBadgeProps {
++  vehicle: Record<string, any>;
++  /** Compact mode — single line, no detail text */
++  compact?: boolean;
++}
++
++const SOURCE_COLORS: Record<string, { bg: string; text: string; border: string }> = {
++  install:  { bg: 'rgba(139, 92, 246, 0.12)', text: '#a78bfa', border: 'rgba(139, 92, 246, 0.25)' },
++  manual:   { bg: 'rgba(59, 130, 246, 0.12)',  text: '#60a5fa', border: 'rgba(59, 130, 246, 0.25)' },
