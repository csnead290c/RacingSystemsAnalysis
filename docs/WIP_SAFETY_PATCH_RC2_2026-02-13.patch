++/**
++ * Physics Divergence Packet Generator
++ * 
++ * Generates detailed diagnostic packets for physics mismatches at checkpoints.
++ * Includes interpolation provenance, physics internals at both endpoints,
++ * and first-difference hints to guide debugging.
++ */
++
++// Node.js fs module - available in test environment
++const fs = typeof require !== 'undefined' ? require('fs') : null;
++import { MismatchInfo } from './earliest_mismatch_finder';
++
++export interface PhysicsState {
++  // Time and distance
++  time_abs_s: number;
++  time_et_s: number;
++  dist_abs_ft: number;
++  dist_track_ft: number;
++  
++  // Velocity and acceleration
++  vel_fps: number;
++  vel_mph: number;
++  accel_g: number;
++  
++  // Engine and drivetrain
++  rpm: number;
++  rpm_raw?: number;
++  dsrpm?: number;
++  lockRpm?: number;
++  gear: number;
++  gearRatio?: number;
++  finalDrive?: number;
++  
++  // Tire dynamics
++  tireSlip?: number;
++  tireCircFt?: number;
++  tireGrowth?: number;
++  wheelSpeed_mph?: number;
++  
++  // Forces (if available)
++  tractiveForce?: number;
++  aeroDrag?: number;
++  rollingResistance?: number;
++  
++  // Clutch/converter (if available)
++  clutchSlip?: number;
++  converterSlip?: number;
++  
++  // Engine output
++  engineTorque?: number;
++  engineHP?: number;
++}
++
++export interface InterpolationProvenance {
++  prevState: PhysicsState;
++  currState: PhysicsState;
++  targetDist: number;
++  factor1: number;  // Linear interpolation factor
++  factor2: number;  // factor1^0.7 for AGS/RPM
++  
++  // Which channels use which factor
++  linearChannels: string[];    // time, dist, vel
++  nonlinearChannels: string[];  // accel, rpm
++}
++
++export interface FirstDifferenceHint {
++  category: 'torque_deficit' | 'distance_mismatch' | 'drivetrain_ratio' | 'slip_excessive' | 'unknown';
++  confidence: 'high' | 'medium' | 'low';
++  indicators: {
++    time_sign: 'slow' | 'fast' | 'match';
++    mph_sign: 'low' | 'high' | 'match';
++    rpm_sign: 'low' | 'high' | 'match';
++    accel_sign: 'low' | 'high' | 'match';
++  };
++  likelyCulprits: string[];
++}
++
++export interface PhysicsDivergencePacket {
++  // Metadata
++  caseId: string;
++  checkpoint: string;
++  distance_ft: number | null;
++  timestamp: string;
++  
++  // Comparison
++  expected: {
++    time_s: number;
++    mph: number;
++    accel_g: number;
++    rpm: number;
++    gear: number;
++  };
++  actual: {
++    time_s: number;
++    mph: number;
++    accel_g: number;
++    rpm: number;
++    gear: number;
++  };
++  deltas: {
++    time_s: number;
++    mph: number;
++    accel_g: number;
++    rpm: number;
++    gear: number;
++  };
++  failedFields: string[];
++  
++  // Interpolation provenance
++  interpolation: InterpolationProvenance;
++  
++  // First-difference hint
++  hint: FirstDifferenceHint;
++}
++
++/**
++ * Classify the mismatch and provide debugging hints
++ */
++function generateFirstDifferenceHint(mismatch: MismatchInfo): FirstDifferenceHint {
++  const { deltas } = mismatch;
++  
++  // Determine sign of each delta with explicit typing
++  const time_sign: 'slow' | 'fast' | 'match' = Math.abs(deltas.time_s) < 0.01 ? 'match' : (deltas.time_s > 0 ? 'slow' : 'fast');
++  const mph_sign: 'low' | 'high' | 'match' = Math.abs(deltas.mph) < 0.5 ? 'match' : (deltas.mph < 0 ? 'low' : 'high');
++  const rpm_sign: 'low' | 'high' | 'match' = Math.abs(deltas.rpm) < 50 ? 'match' : (deltas.rpm < 0 ? 'low' : 'high');
++  const accel_sign: 'low' | 'high' | 'match' = Math.abs(deltas.accel_g) < 0.05 ? 'match' : (deltas.accel_g < 0 ? 'low' : 'high');
++  
++  const indicators: FirstDifferenceHint['indicators'] = { time_sign, mph_sign, rpm_sign, accel_sign };
++  
++  // Pattern matching for likely culprits
++  let category: FirstDifferenceHint['category'] = 'unknown';
++  let confidence: FirstDifferenceHint['confidence'] = 'low';
++  let likelyCulprits: string[] = [];
++  
++  // Pattern 1: Time slow, MPH low, RPM low → Torque/tractive force deficit
++  if (time_sign === 'slow' && mph_sign === 'low' && rpm_sign === 'low') {
++    category = 'torque_deficit';
++    confidence = 'high';
++    likelyCulprits = [
++      'Engine torque curve (HP/torque values)',
++      'Tractive force calculation',
++      'Excessive drag (aero or rolling)',
++      'Clutch/converter slip',
++      'Tire slip excessive',
++    ];
++  }
++  // Pattern 2: MPH high but time high → Distance/velocity interpolation issue
++  else if (mph_sign === 'high' && time_sign === 'slow') {
++    category = 'distance_mismatch';
++    confidence = 'medium';
++    likelyCulprits = [
++      'Distance interpolation (sub310)',
++      'Velocity calculation',
++      'Rollout distance adjustment',
++      'Tire circumference growth',
++    ];
++  }
++  // Pattern 3: RPM differs but MPH close → Drivetrain ratio/slip/tire circ
++  else if (rpm_sign !== 'match' && mph_sign === 'match') {
++    category = 'drivetrain_ratio';
++    confidence = 'high';
++    likelyCulprits = [
++      'Gear ratios',
++      'Final drive ratio',
++      'Tire circumference',
++      'Tire growth calculation',
++      'Driveshaft RPM calculation',
++      'Clutch/converter slip',
++    ];
++  }
++  // Pattern 4: Time slow, MPH low, but RPM high → Excessive slip
++  else if (time_sign === 'slow' && mph_sign === 'low' && rpm_sign === 'high') {
++    category = 'slip_excessive';
++    confidence = 'medium';
++    likelyCulprits = [
++      'Tire slip calculation',
++      'Clutch slip excessive',
++      'Converter slip excessive',
++      'Traction model (AX multiplier)',
++    ];
++  }
++  
++  return {
++    category,
++    confidence,
++    indicators,
++    likelyCulprits,
++  };
++}
++
++/**
++ * Generate and write physics divergence packet to /tmp
++ */
++export function generatePhysicsDivergencePacket(
++  caseId: string,
++  mismatch: MismatchInfo,
++  interpolation: InterpolationProvenance,
++  outputPath?: string
++): string {
++  const hint = generateFirstDifferenceHint(mismatch);
++  
++  // STEP 3: Use checkpoint label from mismatch (already fixed in earliest_mismatch_finder)
++  const checkpointLabel = mismatch.checkpoint || `${mismatch.distance_ft}ft`;
++  
++  const packet: PhysicsDivergencePacket = {
++    caseId,
++    checkpoint: checkpointLabel,  // STEP 3: Use label from mismatch
++    distance_ft: mismatch.distance_ft,
++    timestamp: new Date().toISOString(),
++    
++    expected: {
++      time_s: mismatch.expected.time_s,
++      mph: mismatch.expected.mph,
++      accel_g: mismatch.expected.accel_g,
++      rpm: mismatch.expected.rpm,
++      gear: mismatch.expected.gear,
++    },
++    actual: {
++      time_s: mismatch.actual.time_s,
++      mph: mismatch.actual.mph,
++      accel_g: mismatch.actual.accel_g,
++      rpm: mismatch.actual.rpm,
++      gear: mismatch.actual.gear,
++    },
++    deltas: mismatch.deltas,
++    failedFields: mismatch.failedFields,
++    
++    interpolation,
++    hint,
++  };
++  
++  // HOP 5: Track debug field just before writing packet
++  const DEBUG_PIPELINE = true;
++  const DEBUG_TARGET_DIST = 21;
++  if (DEBUG_PIPELINE && mismatch.distance_ft && Math.abs(mismatch.distance_ft - DEBUG_TARGET_DIST) < 1) {
++    console.log(`[HOP5:physics_divergence_packet] dist=${mismatch.distance_ft} checkpoint="${checkpointLabel}" | factor1=${interpolation.factor1.toFixed(4)} factor2=${interpolation.factor2.toFixed(4)} | prevState.time_et_s=${interpolation.prevState.time_et_s.toFixed(3)} currState.time_et_s=${interpolation.currState.time_et_s.toFixed(3)}`);
++  }
++  
++  // Determine output path
++  const fileCheckpointLabel = mismatch.distance_ft !== null ? `${mismatch.distance_ft}ft` : 'rollout';
++  const defaultPath = `/tmp/vb6_physics_divergence_${caseId}_${fileCheckpointLabel}.json`;
++  const finalPath = outputPath || defaultPath;
++  
++  // Write packet
++  try {
++    fs.writeFileSync(finalPath, JSON.stringify(packet, null, 2));
++    console.log(`[DIVERGENCE PACKET] Written to: ${finalPath}`);
++    return finalPath;
++  } catch (err) {
++    console.warn(`[DIVERGENCE PACKET] Failed to write: ${err}`);
++    return '';
++  }
++}
++
++/**
++ * Extract physics state from simulation state object
++ */
++export function extractPhysicsState(state: any, time_et_s: number): PhysicsState {
++  return {
++    time_abs_s: state.time_s ?? 0,
++    time_et_s: time_et_s,
++    dist_abs_ft: state.Dist_ft ?? 0,
++    dist_track_ft: (state.Dist_ft ?? 0) - (state.Dist0_ft ?? 0),
++    
++    vel_fps: state.Vel_ftps ?? 0,
++    vel_mph: (state.Vel_ftps ?? 0) * 0.681818,
++    accel_g: state.AGS_g ?? 0,
++    
++    rpm: state.EngRPM ?? 0,
++    rpm_raw: state.EngRPM ?? 0,
++    dsrpm: state.DSRPM ?? 0,
++    lockRpm: state.LockRPM ?? 0,
++    gear: state.Gear ?? 0,
++    gearRatio: state.GR ?? 0,
++    finalDrive: state.FD ?? 0,
++    
++    tireSlip: state.TireSlip ?? 0,
++    tireCircFt: state.TireCirc_ft ?? 0,
++    tireGrowth: state.TireGrowth ?? 0,
++    wheelSpeed_mph: state.WheelSpeed_mph ?? 0,
++    
++    tractiveForce: state.TractiveForce ?? 0,
++    aeroDrag: state.AeroDrag ?? 0,
++    rollingResistance: state.RollingResistance ?? 0,
++    
++    clutchSlip: state.ClutchSlip ?? 0,
++    converterSlip: state.ConverterSlip ?? 0,
++    
++    engineTorque: state.EngineTorque ?? 0,
++    engineHP: state.EngineHP ?? 0,
++  };
++}
