++        // VB6 QuarterPro trap MPH calculation using Single (Float32) precision
++        // Formula: mph = 45 / dt, where 45 = 66 * 3600 / 5280 (exact constant)
++        // CRITICAL: VB6 does this math in Single
++        // saveTime_594ft is already f32 from when it was stored
++        const tFin = f32(interpolatedTrackTime);
++        const dt = f32(tFin - saveTime_594ft);
++        speed_mph = f32(45.0 / dt);
