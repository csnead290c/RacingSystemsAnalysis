++/**
++ * BonnevillePro - ET Clock Guardrail Test
++ * 
++ * CRITICAL: Prevents regression to time-basis bug
++ * 
++ * Verifies:
++ * 1. Rollout row has dual-time format (time_abs_s + time_et_s = 0.00)
++ * 2. All checkpoints after rollout use ET clock
++ * 3. Checkpoint ET at finish matches summary ET
++ */
++
++import { describe, it, expect } from 'vitest';
++import { BONNEVILLEPRO_CHECKPOINTS_EXTRACTED } from './fixtures/bonnevillepro_checkpoints_extracted';
++
++describe('BonnevillePro - ET Clock Guardrail (CRITICAL)', () => {
++  it('All cases must start at t=0 (BonnevillePro format)', () => {
++    for (const caseData of BONNEVILLEPRO_CHECKPOINTS_EXTRACTED) {
++      // BonnevillePro doesn't have rollout row - first checkpoint should be at t=0
++      const firstCheckpoint = caseData.checkpoints[0];
++      
++      expect(firstCheckpoint, `${caseData.caseId}: Missing first checkpoint`).toBeDefined();
++      expect(firstCheckpoint.time_et_s, `${caseData.caseId}: First checkpoint should be at t=0`).toBe(0.0);
++      expect(firstCheckpoint.time_abs_s, `${caseData.caseId}: First checkpoint should not have time_abs_s`).toBeNull();
++      
++      console.log(`✅ ${caseData.caseId}: Starts at t=0 (BonnevillePro format)`);
++    }
++  });
++  
++  it('All checkpoints use ET clock (time_et_s)', () => {
++    for (const caseData of BONNEVILLEPRO_CHECKPOINTS_EXTRACTED) {
++      // Check first 3 checkpoints
++      const checkpoints = caseData.checkpoints.slice(0, 3);
++      expect(checkpoints.length, `${caseData.caseId}: Need at least 3 checkpoints`).toBeGreaterThanOrEqual(3);
++      
++      for (const cp of checkpoints) {
++        expect(cp.time_et_s, `${caseData.caseId} @ ${cp.dist_ft}ft: time_et_s must be defined`).toBeDefined();
++        expect(cp.time_abs_s, `${caseData.caseId} @ ${cp.dist_ft}ft: time_abs_s should be null`).toBeNull();
++        expect(cp.label, `${caseData.caseId} @ ${cp.dist_ft}ft: label should be null`).toBeNull();
++      }
++      
++      console.log(`✅ ${caseData.caseId}: All checkpoints use ET clock correctly`);
++    }
++  });
++  
++  it('Finish checkpoint ET matches expected summary', () => {
++    for (const caseData of BONNEVILLEPRO_CHECKPOINTS_EXTRACTED) {
++      if (caseData.expected) {
++        // Find checkpoint at finish distance
++        const finishCp = caseData.checkpoints.find(cp => Math.abs(cp.dist_ft - caseData.expected!.finish_ft) < 1);
++        
++        if (finishCp) {
++          const delta = Math.abs(finishCp.time_et_s - caseData.expected.finish_et_s);
++          expect(delta, `${caseData.caseId}: Finish checkpoint ET must match expected exactly`).toBeLessThan(0.01);
++          console.log(`✅ ${caseData.caseId}: Finish @ ${caseData.expected.finish_ft}ft ET matches expected (delta=${(delta * 1000).toFixed(1)}ms)`);
++        }
++      }
++    }
++  });
++});
