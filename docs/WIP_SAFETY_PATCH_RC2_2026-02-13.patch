++#!/usr/bin/env npx vite-node
++/**
++ * INIT Trace Diff Tool (Strict Parity-Grade)
++ * 
++ * Compares VB6 vs TS INIT traces and reports the FIRST diverging variable only.
++ * STRICT: Fails on any non-JSON line (parity requires clean traces).
++ * 
++ * Usage:
++ *   npx vite-node scripts/diff-init-traces.ts <vb6-trace.jsonl> <ts-trace.jsonl>
++ * 
++ * Exit codes:
++ *   0 = identical (all 37 steps match by hex)
++ *   1 = mismatch or error
++ */
++
++import * as fs from 'fs';
++
++// Expected line count: 17 INPUT_* + 20 INIT steps = 37
++const EXPECTED_LINE_COUNT = 37;
++
++interface InitTraceRow {
++  step: string;
++  value: number;
++  valueHex: string;
++  vb6Line?: string;
++}
++
++/**
++ * Parse JSONL file STRICTLY - fail on any non-JSON line
++ */
++function parseJSONL(filePath: string, label: string): InitTraceRow[] {
++  const content = fs.readFileSync(filePath, 'utf-8');
++  const lines = content.split('\n');
++  const rows: InitTraceRow[] = [];
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i].trim();
++    if (!line) continue; // Skip blank lines only
++    
++    try {
++      const row = JSON.parse(line);
++      if (typeof row.step !== 'string' || typeof row.valueHex !== 'string') {
++        console.error(`ERROR: ${label} line ${i + 1}: missing required fields (step, valueHex)`);
++        process.exit(1);
++      }
++      rows.push(row);
++    } catch (e) {
++      console.error(`ERROR: ${label} line ${i + 1}: invalid JSON`);
++      console.error(`  Content: ${line.substring(0, 80)}${line.length > 80 ? '...' : ''}`);
++      process.exit(1);
++    }
++  }
++  
++  return rows;
++}
++
++function hexMatch(a: string, b: string): boolean {
++  return a.toLowerCase() === b.toLowerCase();
++}
++
++function main() {
++  const args = process.argv.slice(2);
++  
++  if (args.length < 2) {
++    console.log('Usage: npx vite-node scripts/diff-init-traces.ts <vb6.jsonl> <ts.jsonl>');
++    process.exit(1);
++  }
++  
++  const [vb6Path, tsPath] = args;
++  
++  // Check files exist
++  if (!fs.existsSync(vb6Path)) {
++    console.error(`ERROR: VB6 trace file not found: ${vb6Path}`);
++    process.exit(1);
++  }
++  if (!fs.existsSync(tsPath)) {
++    console.error(`ERROR: TS trace file not found: ${tsPath}`);
++    process.exit(1);
++  }
++  
++  // Parse both files (strict - will exit on invalid JSON)
++  const vb6Trace = parseJSONL(vb6Path, 'VB6');
++  const tsTrace = parseJSONL(tsPath, 'TS');
++  
++  // Print line counts
++  console.log(`VB6: ${vb6Trace.length} lines`);
++  console.log(`TS:  ${tsTrace.length} lines`);
++  
++  // Validate expected line count
++  if (vb6Trace.length !== EXPECTED_LINE_COUNT) {
++    console.error(`ERROR: VB6 trace has ${vb6Trace.length} lines, expected ${EXPECTED_LINE_COUNT}`);
++    process.exit(1);
++  }
++  if (tsTrace.length !== EXPECTED_LINE_COUNT) {
++    console.error(`ERROR: TS trace has ${tsTrace.length} lines, expected ${EXPECTED_LINE_COUNT}`);
++    process.exit(1);
++  }
++  
++  // Validate step sequences match (same step names at each index)
++  for (let i = 0; i < EXPECTED_LINE_COUNT; i++) {
++    if (vb6Trace[i].step !== tsTrace[i].step) {
++      console.error(`\nSTEP SEQUENCE MISMATCH at index ${i}:`);
++      console.error(`  VB6: ${vb6Trace[i].step}`);
++      console.error(`  TS:  ${tsTrace[i].step}`);
++      process.exit(1);
++    }
++  }
++  
++  // Compare by valueHex (primary comparison for parity)
++  let firstMismatchIdx = -1;
++  for (let i = 0; i < EXPECTED_LINE_COUNT; i++) {
++    if (!hexMatch(vb6Trace[i].valueHex, tsTrace[i].valueHex)) {
++      firstMismatchIdx = i;
++      break;
++    }
++  }
++  
++  if (firstMismatchIdx === -1) {
++    console.log('\nIDENTICAL');
++    console.log(`All ${EXPECTED_LINE_COUNT} steps match by hex.`);
++    process.exit(0);
++  }
++  
++  // Print first mismatch with +/- 2 context
++  const mismatchStep = vb6Trace[firstMismatchIdx].step;
++  console.log(`\nFIRST MISMATCH @ index ${firstMismatchIdx} step ${mismatchStep}`);
++  console.log('');
++  
++  const contextStart = Math.max(0, firstMismatchIdx - 2);
++  const contextEnd = Math.min(EXPECTED_LINE_COUNT - 1, firstMismatchIdx + 2);
++  
++  for (let i = contextStart; i <= contextEnd; i++) {
++    const vb6 = vb6Trace[i];
++    const ts = tsTrace[i];
++    const isMismatch = i === firstMismatchIdx;
++    const marker = isMismatch ? '>>>' : '   ';
++    
++    if (isMismatch) {
++      console.log(`${marker} [${i}] ${vb6.step}`);
++      console.log(`       VB6: ${vb6.value} ${vb6.valueHex} (line: ${vb6.vb6Line || 'N/A'})`);
++      console.log(`       TS:  ${ts.value} ${ts.valueHex} (line: ${ts.vb6Line || 'N/A'})`);
++    } else {
++      console.log(`${marker} [${i}] ${vb6.step}: ${vb6.valueHex}`);
++    }
++  }
++  
++  process.exit(1);
++}
++
++main();
