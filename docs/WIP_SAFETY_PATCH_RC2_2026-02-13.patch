++    
++  } finally {
++    // Restore stdout.write
++    process.stdout.write = originalStdoutWrite;
++    
++    // Disable tracing and clear sink
++    setInitTraceEnabled(false);
++    setInitTraceSink(null);
++  }
++  
++  // Self-check: verify line count is exactly 37 (17 INPUT_* + 20 INIT steps)
++  if (collected.length !== EXPECTED_LINE_COUNT) {
