++/**
++ * ComponentSourceBadge
++ *
++ * Generic compact inline badge for component install status.
++ * Works for Clutch, Four-Link, and any future installable component.
++ *
++ * Source detection:
++ *  - "Installed" — install ref is set AND asset found in store
++ *  - "Missing"   — install ref is set BUT asset not found
++ *  - "Manual"    — manual entry is set (no install ref)
++ *  - "None"      — neither install nor manual
++ */
++
++interface ComponentSourceBadgeProps {
++  /** Label prefix, e.g. "Clutch" or "4-Link" */
++  label: string;
++  /** Whether an install ref exists on the vehicle */
++  hasInstall: boolean;
++  /** Whether the installed asset was found in the store */
++  assetFound: boolean;
++  /** Whether a manual entry exists */
++  hasManual: boolean;
++  /** Whether overrides are active on the install */
++  overridesActive?: boolean;
++  /** Compact mode (default true) */
++  compact?: boolean;
++}
++
++const SOURCE_COLORS: Record<string, { bg: string; text: string; border: string }> = {
++  installed: { bg: 'rgba(139, 92, 246, 0.12)', text: '#a78bfa', border: 'rgba(139, 92, 246, 0.25)' },
++  manual:    { bg: 'rgba(59, 130, 246, 0.12)',  text: '#60a5fa', border: 'rgba(59, 130, 246, 0.25)' },
++  none:      { bg: 'rgba(156, 163, 175, 0.08)', text: '#6b7280', border: 'rgba(156, 163, 175, 0.15)' },
++  missing:   { bg: 'rgba(245, 158, 11, 0.12)',  text: '#fbbf24', border: 'rgba(245, 158, 11, 0.25)' },
++};
++
++export function ComponentSourceBadge({
++  label,
++  hasInstall,
++  assetFound,
++  hasManual,
++  overridesActive = false,
++  compact = true,
++}: ComponentSourceBadgeProps) {
++  let sourceKey: string;
++  let sourceLabel: string;
++  let title: string;
++
++  if (hasInstall && assetFound) {
++    sourceKey = 'installed';
++    sourceLabel = 'Installed';
++    title = `${label}: Installed from library${overridesActive ? ' (overrides active)' : ''}`;
++  } else if (hasInstall && !assetFound) {
++    sourceKey = 'missing';
++    sourceLabel = 'Missing';
++    title = `${label}: Installed asset not found in store`;
++  } else if (hasManual) {
++    sourceKey = 'manual';
++    sourceLabel = 'Manual';
++    title = `${label}: Manual entry`;
++  } else {
++    sourceKey = 'none';
++    sourceLabel = '—';
++    title = `${label}: Not configured`;
++  }
++
++  const colors = SOURCE_COLORS[sourceKey];
++
++  if (compact) {
++    // Don't render badge at all for "none" state to keep list clean
++    if (sourceKey === 'none') return null;
++
++    return (
++      <span
++        style={{
++          display: 'inline-flex',
++          alignItems: 'center',
++          gap: '3px',
++          padding: '2px 6px',
++          fontSize: '0.6rem',
++          fontWeight: 600,
++          borderRadius: '3px',
++          backgroundColor: colors.bg,
++          color: colors.text,
++          border: `1px solid ${colors.border}`,
++          whiteSpace: 'nowrap',
++        }}
++        title={title}
++      >
++        {label}: {sourceLabel}
++      </span>
++    );
++  }
++
++  return (
++    <div
++      style={{
++        display: 'flex',
++        alignItems: 'center',
++        gap: '6px',
++        padding: '4px 8px',
++        fontSize: '0.7rem',
++        borderRadius: '4px',
++        backgroundColor: colors.bg,
++        border: `1px solid ${colors.border}`,
++      }}
++    >
++      <span style={{ fontWeight: 600, color: colors.text }}>{label}: {sourceLabel}</span>
++    </div>
++  );
++}
