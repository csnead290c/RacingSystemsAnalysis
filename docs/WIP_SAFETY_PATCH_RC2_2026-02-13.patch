++      // Compute in Double
++      const ChassisPMIDouble = TiresPMI + TransPMI * Math.pow(GearRatio, 2) * Math.pow(TGR_gear, 2);
++      // Truncate to Single
++      const ChassisPMISingle = vb6AssignSingle(ChassisPMIDouble);
