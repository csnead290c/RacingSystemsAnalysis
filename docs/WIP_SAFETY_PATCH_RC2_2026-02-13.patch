++### C.5 LoadFromFile — Version Branch Header
++
++```vb
++' ECommon/ENGINE.FRM lines 2070-2162 (abbreviated)
++Public Sub LoadFromFile(fn As String)
++    ' ... file open, defaults for old files ...
++    
++    ff = FreeFile
++    Open fn For Input As ff
++    Input #ff, ver
++    Input #ff, Note
++    txtNote.Text = Note
++    
++    If ver = "3" Or ver = "3.0.1" Or ver = "3.1" Then
++        ' VERSION 3.x — structured field order
++        Input #ff, inline, ncyl, ibore, istroke, rod, CR
++        Input #ff, ctype, indur, ifi, carb, ifuel
++        Input #ff, iman, curved, flowf
++        Input #ff, niv, vd, pif, inh2o, refbor
++        Input #ff, vl, va
++        Input #ff, ccv, dtk, gtk, pdv
++        Input #ff, nbbl, tdia, vdia, ttype
++        
++        If ver = "3.0.1" Or ver = "3.1" Then
++            Input #ff, nbblS, tdiaS, vdiaS      ' secondary throttle bores
++        End If
++        
++        If ver = "3.1" Then
++            Input #ff, vsd, vstmd, vsa, vswd     ' valve seat data (4 fields)
++        Else
++            Input #ff, vsd, vstmd                ' valve seat data (2 fields)
++        End If
++        
++        ' ... correction arrays, flow curve data ...
++        
++        If ver = "3.1" Then
++            gc_Inline.Value = inline
++        Else
++            gc_Inline.Value = inline + 1         ' VERSION 3.0 inline offset!
++        End If
++        
++    Else
++        ' VERSION 2 (old DOS format) — COMPLETELY DIFFERENT field order
++        Input #ff, ncyl, ibore, istroke, rod, CR, carb, iman
++        Input #ff, niv, pif, inh2o, refbor, flowf, ctype, indur
++        Input #ff, vd, vl, va, vv, vvi
++        Input #ff, dtk, gtk, pdv, ccv
++        Input #ff, nbbl, tdia, vdia, ttype, ZCarb
++        Input #ff, vsd, vstmd, ZCarb
++        
++        ' Negative values = mm units (DOS convention)
++        If ibore < 0 Then ibore = -ibore * ZM:   gc_Bore.Inches = False
++        ' ... more negative-value mm detection ...
++        
++        ' Infer inline from cylinder count
++        Select Case ncyl
++            Case 1, 2, 3, 4, 5, 7, 9, 11: gc_Inline.Value = 0
++            Case 6, 8, 10, 12:            gc_Inline.Value = 1
++        End Select
++        
++        gc_Carb.Value = True     ' Old files always carburetor
++        gc_Fuel.Value = 1        ' Old files always gasoline
++    End If
++    
++    ' ... load locals into gc_* globals, call setters, CalcEngPerf, LoadScreen ...
++End Sub
++```
