++/**
++ * Find first divergence between expected and actual rows
++ */
++export function findFirstDivergence(
++  caseId: string,
++  expectedRows: FixtureRow[],
++  actualRows: ActualRow[]
++): DivergenceReport {
++  const report: DivergenceReport = {
++    caseId,
++    firstDivergentIndex: null,
++    totalExpectedRows: expectedRows.length,
++    totalActualRows: actualRows.length,
++    lengthMatch: expectedRows.length === actualRows.length,
++    divergence: null,
++    summary: '',
++  };
++  
++  // Compare row by row (index-based alignment)
++  const minLen = Math.min(expectedRows.length, actualRows.length);
++  
++  for (let i = 0; i < minLen; i++) {
++    const expectedNorm = normalizeFixtureRow(expectedRows[i]);
++    const actual = actualRows[i];
++    
++    const fieldDeltas = compareRows(expectedNorm, actual);
++    const hasExceeding = fieldDeltas.some(d => d.exceeds);
++    
++    // Check for event type mismatch (if available)
++    let eventTypeMismatch = false;
++    if (actual.event_type) {
++      const expectedLabel = expectedNorm.label.toLowerCase();
++      const actualType = actual.event_type;
++      
++      // Simple heuristic: rollout should match rollout, etc.
++      if (expectedLabel === 'rollout' && actualType !== 'rollout') {
++        eventTypeMismatch = true;
++      }
++      // Could add more checks here
++    }
++    
++    if (hasExceeding || eventTypeMismatch) {
++      report.firstDivergentIndex = i;
++      report.divergence = {
++        index: i,
++        expectedRow: expectedRows[i],
++        actualRow: actual,
++        fieldDeltas,
++        eventTypeMismatch,
++      };
++      break;
++    }
++  }
++  
++  // Generate summary
++  if (report.divergence) {
++    const d = report.divergence;
++    const exceedingFields = d.fieldDeltas.filter(f => f.exceeds).map(f => f.field);
++    report.summary = `First divergence at row ${d.index}: ${exceedingFields.join(', ')} exceed tolerance`;
++    if (d.eventTypeMismatch) {
++      report.summary += ' (event type mismatch)';
++    }
++  } else if (!report.lengthMatch) {
++    report.summary = `Row count mismatch: expected ${report.totalExpectedRows}, got ${report.totalActualRows}`;
++  } else {
++    report.summary = 'All rows match within tolerance';
++  }
++  
++  return report;
++}
