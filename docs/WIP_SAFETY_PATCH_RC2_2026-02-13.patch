++#!/usr/bin/env npx ts-node
++/**
++ * VB6 vs TS Trace Comparator
++ * 
++ * Compares two trace files (VB6 reference vs TS simulation) and finds the first divergence.
++ * 
++ * Usage:
++ *   npx ts-node scripts/compare-traces.ts <vb6-trace.jsonl> <ts-trace.jsonl>
++ * 
++ * Output:
++ *   - First differing program point
++ *   - First differing variable name
++ *   - Both values and delta
++ *   - Context: previous row and current row
++ */
++
++import * as fs from 'fs';
++
++interface TraceRow {
++  stepIndex: number;
++  pointName: string;
++  time_s: number;
++  dist_ft: number;
++  vel_ftps: number;
++  rpm: number;
++  AGS_g: number;
++  gear: number;
++  init?: {
++    HP_launch: number;
++    HP_corrected: number;
++    TQ: number;
++    force: number;
++    Ags0_unclamped: number;
++    CAXI: number;
++    AX: number;
++    CRTF: number;
++    AMax: number;
++    StaticRWT: number;
++    DragForce: number;
++    TireSlip: number;
++    lossFactor: number;
++  };
++}
++
++// Tolerance for floating point comparison
++const TOLERANCE = 1e-6;
++
++function parseJSONL(filePath: string): TraceRow[] {
++  const content = fs.readFileSync(filePath, 'utf-8');
++  return content
++    .split('\n')
++    .filter(line => line.trim())
++    .map(line => JSON.parse(line));
++}
++
++function compareValues(name: string, vb6: number | undefined, ts: number | undefined): { match: boolean; delta: number } {
++  if (vb6 === undefined && ts === undefined) return { match: true, delta: 0 };
++  if (vb6 === undefined || ts === undefined) return { match: false, delta: NaN };
++  
++  const delta = ts - vb6;
++  const match = Math.abs(delta) < TOLERANCE;
++  return { match, delta };
++}
++
++function compareRows(vb6Row: TraceRow, tsRow: TraceRow): { match: boolean; firstDiff: string | null; vb6Val: number; tsVal: number; delta: number } {
++  // Compare main fields
++  const fields: (keyof TraceRow)[] = ['time_s', 'dist_ft', 'vel_ftps', 'rpm', 'AGS_g', 'gear'];
++  
++  for (const field of fields) {
++    const vb6Val = vb6Row[field] as number;
++    const tsVal = tsRow[field] as number;
++    const { match, delta } = compareValues(field, vb6Val, tsVal);
++    if (!match) {
++      return { match: false, firstDiff: field, vb6Val, tsVal, delta };
++    }
++  }
++  
++  // Compare init fields if present
++  if (vb6Row.init && tsRow.init) {
++    const initFields: (keyof NonNullable<TraceRow['init']>)[] = [
++      'HP_launch', 'HP_corrected', 'TQ', 'force', 'Ags0_unclamped',
++      'CAXI', 'AX', 'CRTF', 'AMax', 'StaticRWT', 'DragForce', 'TireSlip', 'lossFactor'
++    ];
++    
++    for (const field of initFields) {
++      const vb6Val = vb6Row.init[field];
++      const tsVal = tsRow.init[field];
++      const { match, delta } = compareValues(`init.${field}`, vb6Val, tsVal);
++      if (!match) {
++        return { match: false, firstDiff: `init.${field}`, vb6Val, tsVal, delta };
++      }
++    }
++  }
++  
++  return { match: true, firstDiff: null, vb6Val: 0, tsVal: 0, delta: 0 };
++}
++
++function formatRow(row: TraceRow): string {
++  let s = `  step=${row.stepIndex} point=${row.pointName} t=${row.time_s.toFixed(4)} d=${row.dist_ft.toFixed(2)} v=${row.vel_ftps.toFixed(2)} rpm=${row.rpm.toFixed(0)} AGS=${row.AGS_g.toFixed(4)} gear=${row.gear}`;
++  if (row.init) {
++    s += `\n    init: HP_launch=${row.init.HP_launch.toFixed(2)} TQ=${row.init.TQ.toFixed(2)} force=${row.init.force.toFixed(2)} Ags0_unclamped=${row.init.Ags0_unclamped.toFixed(4)} AMax=${row.init.AMax.toFixed(4)} CRTF=${row.init.CRTF.toFixed(2)}`;
++  }
++  return s;
++}
++
++function main() {
++  const args = process.argv.slice(2);
++  
++  if (args.length < 2) {
++    console.log('Usage: npx ts-node scripts/compare-traces.ts <vb6-trace.jsonl> <ts-trace.jsonl>');
++    console.log('');
++    console.log('If no VB6 trace exists yet, create a reference trace from fixture expected values.');
++    process.exit(1);
++  }
++  
++  const [vb6Path, tsPath] = args;
++  
++  console.log('=== VB6 vs TS Trace Comparison ===');
++  console.log(`VB6 trace: ${vb6Path}`);
++  console.log(`TS trace:  ${tsPath}`);
++  console.log('');
++  
++  const vb6Trace = parseJSONL(vb6Path);
++  const tsTrace = parseJSONL(tsPath);
++  
++  console.log(`VB6 rows: ${vb6Trace.length}`);
++  console.log(`TS rows:  ${tsTrace.length}`);
++  console.log('');
++  
++  // Find first divergence
++  const maxRows = Math.min(vb6Trace.length, tsTrace.length);
++  
++  for (let i = 0; i < maxRows; i++) {
