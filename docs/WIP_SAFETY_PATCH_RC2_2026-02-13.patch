++++ b/src/shared/hooks/useMeasuredWidth.ts
+@@ -0,0 +1,63 @@
++/**
++ * useMeasuredWidth — print-safe container width measurement.
++ *
++ * Returns a ref to attach to a container div, the measured width, and
++ * a `remeasure` callback for imperative use (e.g. before printing).
++ *
++ * Uses getBoundingClientRect (NOT ResizeObserver) so it works reliably
++ * in print / "Save as PDF" contexts where ResizeObserver may not fire.
++ *
++ * Measurement strategy:
++ *  1. requestAnimationFrame on mount (first paint)
++ *  2. Delayed re-measures at configurable intervals (default 100ms, 300ms)
++ *  3. Window resize listener (covers viewport changes + print reflow)
++ */
++
++import { useRef, useState, useEffect, useCallback } from 'react';
++
++const DEFAULT_DELAYS_MS = [100, 300];
++
++interface UseMeasuredWidthOptions {
++  /** Delay(s) in ms for scheduled re-measures after mount. Default: [100, 300]. */
++  delays?: number[];
++}
++
++interface UseMeasuredWidthResult {
++  ref: React.RefObject<HTMLDivElement>;
++  width: number;
++  /** Force a measurement. Useful before triggering window.print(). */
++  remeasure: () => void;
++}
++
++export function useMeasuredWidth(
++  options?: UseMeasuredWidthOptions,
++): UseMeasuredWidthResult {
++  const delays = options?.delays ?? DEFAULT_DELAYS_MS;
++  const ref = useRef<HTMLDivElement>(null!);
++  const [width, setWidth] = useState(0);
++
++  const measure = useCallback(() => {
++    if (ref.current) {
++      const w = ref.current.getBoundingClientRect().width;
++      if (w > 0) setWidth(Math.round(w));
++    }
++  }, []);
++
++  useEffect(() => {
++    // Initial measure after first paint
++    const rafId = requestAnimationFrame(measure);
++
++    // Delayed re-measures to catch late layout shifts (print dialogs, fonts)
++    const timers = delays.map((ms) => setTimeout(measure, ms));
++
++    window.addEventListener('resize', measure);
++
++    return () => {
++      cancelAnimationFrame(rafId);
++      timers.forEach(clearTimeout);
++      window.removeEventListener('resize', measure);
++    };
++  }, [measure, delays]);
++
++  return { ref, width, remeasure: measure };
++}
