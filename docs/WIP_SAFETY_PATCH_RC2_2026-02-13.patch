++/**
++ * Unified Debug Pipeline Configuration
++ * 
++ * Single source of truth for debug instrumentation across all 5 hops:
++ * HOP 1: vb6Exact.ts (emission)
++ * HOP 2: classic_sim_runner.ts (mapping)
++ * HOP 3: vb6_equivalence_debug.ts (normalization)
++ * HOP 4: earliest_mismatch_finder.ts (formatting)
++ * HOP 5: physics_divergence_packet.ts (serialization)
++ */
++
++/**
++ * Master flag - set to false for production
++ */
++export const DEBUG_PIPELINE_ENABLED = false;
++
++/**
++ * Target checkpoint for detailed tracing
++ * Set to specific distance (ft) to trace that checkpoint through all hops
++ */
++export const DEBUG_TARGET_DISTANCE = 21; // QuarterProTest1 earliest mismatch
++
++/**
++ * Tolerance for distance matching (ft)
++ */
++export const DEBUG_DISTANCE_TOLERANCE = 1.0;
++
++/**
++ * Log a checkpoint at a specific hop in the pipeline
++ */
++export function debugLogHop(
++  hopNumber: number,
++  hopName: string,
++  checkpoint: {
++    distance_ft?: number | null;
++    label?: string | null;
++    debug?: any;
++  }
++): void {
++  if (!DEBUG_PIPELINE_ENABLED) return;
++  
++  const dist = checkpoint.distance_ft;
++  if (!dist || Math.abs(dist - DEBUG_TARGET_DISTANCE) > DEBUG_DISTANCE_TOLERANCE) {
++    return;
++  }
++  
++  const label = checkpoint.label || 'unlabeled';
++  const hasDebug = !!checkpoint.debug;
++  
++  if (!hasDebug) {
++    console.log(`[HOP${hopNumber}:${hopName}] dist=${dist} label="${label}" | DEBUG FIELD MISSING`);
++    return;
++  }
++  
++  const debug = checkpoint.debug;
++  const triggerKind = debug.triggerKind || 'unknown';
++  const triggerTarget = debug.triggerTarget ?? 'unknown';
++  
++  // Extract interpolation details
++  const interp = debug.interp || {};
++  const method = interp.method || 'unknown';
++  const factor1 = interp.factor1;
++  const factor2 = interp.factor2;
++  const prevT = interp.prev?.t;
++  const currT = interp.curr?.t;
++  
++  const factor1Str = typeof factor1 === 'number' ? factor1.toFixed(4) : 'MISSING';
++  const factor2Str = typeof factor2 === 'number' ? factor2.toFixed(4) : 'MISSING';
++  const prevTStr = typeof prevT === 'number' ? prevT.toFixed(3) : 'MISSING';
++  const currTStr = typeof currT === 'number' ? currT.toFixed(3) : 'MISSING';
++  
++  console.log(
++    `[HOP${hopNumber}:${hopName}] dist=${dist} label="${label}" | ` +
++    `triggerKind=${triggerKind} target=${triggerTarget} | ` +
++    `method=${method} factor1=${factor1Str} factor2=${factor2Str} | ` +
++    `prev.t=${prevTStr} curr.t=${currTStr}`
++  );
++}
++
++/**
++ * Log interpolation provenance being written to packet
++ */
++export function debugLogPacketProvenance(
++  checkpoint: string,
++  distance_ft: number,
++  interpolation: {
++    factor1?: number | null;
++    factor2?: number | null;
++    prevState?: { time_et_s?: number | null };
++    currState?: { time_et_s?: number | null };
++  }
++): void {
++  if (!DEBUG_PIPELINE_ENABLED) return;
++  if (Math.abs(distance_ft - DEBUG_TARGET_DISTANCE) > DEBUG_DISTANCE_TOLERANCE) {
++    return;
++  }
++  
++  const factor1 = interpolation.factor1;
++  const factor2 = interpolation.factor2;
++  const prevT = interpolation.prevState?.time_et_s;
++  const currT = interpolation.currState?.time_et_s;
++  
++  const factor1Str = typeof factor1 === 'number' ? factor1.toFixed(4) : 'NULL';
++  const factor2Str = typeof factor2 === 'number' ? factor2.toFixed(4) : 'NULL';
++  const prevTStr = typeof prevT === 'number' ? prevT.toFixed(3) : 'NULL';
++  const currTStr = typeof currT === 'number' ? currT.toFixed(3) : 'NULL';
++  
++  console.log(
++    `[HOP5:physics_divergence_packet] dist=${distance_ft} checkpoint="${checkpoint}" | ` +
++    `factor1=${factor1Str} factor2=${factor2Str} | ` +
++    `prevState.time_et_s=${prevTStr} currState.time_et_s=${currTStr}`
++  );
++}
