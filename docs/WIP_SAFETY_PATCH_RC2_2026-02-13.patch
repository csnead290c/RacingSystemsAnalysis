++
++// ============================================================================
++// Float32 helpers for parity-grade hex output
++// ============================================================================
++
++/** Convert JS number to float32 (VB6 Single equivalent) */
++function f32(x: number): number {
++  return Math.fround(x);
++}
++
++/** Convert float32 to hex string (0x???????? uppercase, little-endian bits) */
++function f32Hex(x: number): string {
++  const f32Val = Math.fround(x);
++  const buffer = new ArrayBuffer(4);
++  const view = new DataView(buffer);
++  view.setFloat32(0, f32Val, false); // big-endian for consistent hex representation
++  return '0x' + view.getUint32(0, false).toString(16).toUpperCase().padStart(8, '0');
++}
