++/**
++ * Semantic Guard Test for TABY Interpolation
++ * 
++ * This test validates CODE PARITY with VB6, not output parity.
++ * It verifies that the TS TABY implementation matches VB6 Lagrangian
++ * interpolation semantics from RSALIB.BAS lines 531-573.
++ * 
++ * The reference implementation is a direct transliteration of VB6 TABY.
++ */
++
++import { describe, it, expect } from 'vitest';
++import { taby, bisc } from '../dtaby';
++
++/**
++ * VB6 Reference Implementation - Direct transliteration of RSALIB.BAS:531-573
++ * This serves as the ground truth for semantic parity testing.
++ * 
++ * VB6 Source:
++ * ```vb
++ * Static Sub TABY(XTAB() As Single, YTAB() As Single, N%, L%, XVAL As Single, YVAL As Single)
++ *     KBOTM% = 1: KTOP% = 2
++ *     If N% = 1 Then GoTo T100
++ *     If N% = 2 Then GoTo T400
++ *     Call BISC(XTAB(), XVAL, N%, KBOTM%, KTOP%, JJ%)
++ *     If KBOTM% <> KTOP% Then GoTo T200
++ * T100:
++ *     YVAL = YTAB(KBOTM%): Exit Sub
++ * T200:
++ *     If JJ% = 1 Or L% <= 1 Then GoTo T400
++ *     KTOP% = KTOP% + 1
++ *     If L% >= 3 Then GoTo T300
++ *     If KTOP% <= N% Then GoTo T400
++ * T300:
++ *     If KTOP% > N% Then KTOP% = N%
++ *     KBOTM% = KBOTM% - 1: If KBOTM% < 1 Then KBOTM% = 1
++ * T400:
++ *     YVAL = 0
++ *     For j% = KBOTM% To KTOP%
++ *         P = 1
++ *         xtabj = XTAB(j%)
++ *         For i% = KBOTM% To KTOP%
++ *             If (i% = j%) Then
++ *                 P = P * YTAB(j%)
++ *             Else
++ *                 xtabi = XTAB(i%)
++ *                 P = P * (XVAL - xtabi) / (xtabj - xtabi)
++ *             End If
++ *         Next
++ *         YVAL = YVAL + P
++ *     Next
++ * End Sub
++ * ```
++ */
++function vb6TabyReference(
++  XTAB: number[],  // 0-indexed (VB6 uses 1-indexed)
++  YTAB: number[],
++  N: number,
++  L: number,
++  XVAL: number
++): number {
++  // VB6: KBOTM% = 1: KTOP% = 2 (adjusted to 0-indexed)
++  let KBOTM = 0;
++  let KTOP = 1;
++  
++  // VB6: If N% = 1 Then GoTo T100
++  if (N === 1) {
++    return YTAB[0];  // T100: YVAL = YTAB(KBOTM%)
++  }
++  
++  // VB6: If N% = 2 Then GoTo T400
++  if (N === 2) {
++    // Skip to T400 (Lagrange calculation)
++  } else {
++    // VB6: Call BISC(XTAB(), XVAL, N%, KBOTM%, KTOP%, JJ%)
++    const result = bisc(XTAB, XVAL, N);
++    KBOTM = result.KBOTM;
++    KTOP = result.KTOP;
++    const JJ = result.JJ;
++    
++    // VB6: If KBOTM% <> KTOP% Then GoTo T200
++    if (KBOTM === KTOP) {
++      return YTAB[KBOTM];  // T100: exact match
++    }
++    
++    // T200: Determine proper values of KBOTM% and KTOP%
++    // VB6 RSALIB.BAS:548-556
++    // VB6: If JJ% = 1 Or L% <= 1 Then GoTo T400
++    if (JJ !== 1 && L > 1) {
++      // VB6:549 - KTOP% = KTOP% + 1
++      KTOP = KTOP + 1;
++      
++      // VB6:550 - If L% >= 3 Then GoTo T300
++      if (L >= 3) {
++        // T300: expand both directions
++        if (KTOP > N - 1) KTOP = N - 1;
++        KBOTM = KBOTM - 1;
++        if (KBOTM < 0) KBOTM = 0;
++      } else {
++        // L = 2 (quadratic)
++        // VB6:551 - If KTOP% <= N% Then GoTo T400
++        if (KTOP > N - 1) {
++          // KTOP exceeded limit, must expand lower instead
++          KTOP = N - 1;
++          KBOTM = KBOTM - 1;
++          if (KBOTM < 0) KBOTM = 0;
++        }
++        // else: KTOP is valid, go to T400
++      }
++    }
++  }
++  
++  // T400: Calculate Lagrange coefficients
++  // VB6: YVAL = 0
++  let YVAL = 0;
++  
++  // VB6: For j% = KBOTM% To KTOP%
++  for (let j = KBOTM; j <= KTOP; j++) {
++    // VB6: P = 1
++    let P = 1;
++    const xtabj = XTAB[j];
++    
++    // VB6: For i% = KBOTM% To KTOP%
++    for (let i = KBOTM; i <= KTOP; i++) {
++      if (i === j) {
++        // VB6: P = P * YTAB(j%)
++        P = P * YTAB[j];
++      } else {
++        // VB6: P = P * (XVAL - xtabi) / (xtabj - xtabi)
++        const xtabi = XTAB[i];
++        P = P * (XVAL - xtabi) / (xtabj - xtabi);
++      }
++    }
++    // VB6: YVAL = YVAL + P
++    YVAL = YVAL + P;
++  }
++  
++  return YVAL;
++}
++
