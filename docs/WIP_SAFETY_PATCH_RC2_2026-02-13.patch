++export function buildSimConfigForClassicCase(caseId: string): { record: ClassicCaseRecord; simConfig: any } {
++  const record = loadClassicCase(caseId);
++  
++  if (!record.effectiveInputs) {
++    const errorDetails = record.warnings.length > 0 ? record.warnings.join('; ') : 'unknown error';
++    throw new Error(`Cannot build config for ${caseId}: normalization failed - ${errorDetails}`);
++  }
++  
++  const eff = record.effectiveInputs;
++  
++  const simConfig = {
++    vehicle: {
++      weightLb: eff.weightLb,
++      powerHP: eff.powerHP_effective,
++      tireDiameterIn: eff.tireDiaIn_effective,
++      rearGearRatio: eff.rearGear_effective,
++    },
++    track: {
++      rolloutIn: eff.rolloutIn_effective || 0,
++    },
++  };
++  
++  return { record, simConfig };
++}
