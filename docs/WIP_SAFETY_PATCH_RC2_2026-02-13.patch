+diff --git a/src/shared/components/EngineAssetInstallModal.tsx b/src/shared/components/EngineAssetInstallModal.tsx
+new file mode 100644
+index 00000000..160bf2a4
+--- /dev/null
++++ b/src/shared/components/EngineAssetInstallModal.tsx
+@@ -0,0 +1,403 @@
++/**
++ * EngineAssetInstallModal
++ *
++ * Searchable, sortable, paginated modal that lists engine assets from the library.
++ * Selecting one calls onInstall with the asset ID + revision.
++ *
++ * Scalability notes (future):
++ *  - Tags + collections filtering
++ *  - Server-side search/paging when backed by API
++ *  - Virtualized list (react-window) if client-side list exceeds ~500 items
++ */
++
++import { useState, useMemo, useEffect, useRef } from 'react';
++import type { EngineAsset, EngineAssetKind } from '../../domain/library/engineAssets';
++import { listEngineAssets } from '../../state/engineAssets';
++
++// ── Props ───────────────────────────────────────────────────────────
++
++interface EngineAssetInstallModalProps {
++  onInstall: (assetId: string, pinnedRevision: number) => void;
++  onClose: () => void;
++}
++
++// ── Constants ───────────────────────────────────────────────────────
++
++const PAGE_SIZE = 20;
++const DEBOUNCE_MS = 200;
++
++type SortKey = 'updated' | 'name' | 'hp';
++
++const SORT_OPTIONS: { value: SortKey; label: string }[] = [
++  { value: 'updated', label: 'Recently Updated' },
++  { value: 'name', label: 'Name (A-Z)' },
++  { value: 'hp', label: 'Peak HP (High-Low)' },
++];
++
++// ── Kind Labels ─────────────────────────────────────────────────────
++
++const KIND_LABELS: Record<EngineAssetKind, string> = {
++  sim: 'Sim',
++  manual_peak: 'Peak',
++  dyno_curve: 'Dyno',
++};
++
++const KIND_COLORS: Record<EngineAssetKind, string> = {
++  sim: '#8b5cf6',
++  manual_peak: '#3b82f6',
++  dyno_curve: '#f59e0b',
++};
++
++// ── Helpers ─────────────────────────────────────────────────────────
++
++function getAssetPeakHP(asset: EngineAsset): number {
++  switch (asset.kind) {
++    case 'sim': return asset.payload.engineSimResultSummary.peakHP;
++    case 'manual_peak': return asset.payload.peakHP;
++    case 'dyno_curve': return Math.max(...asset.payload.points.map(p => p.hp), 0);
++  }
++}
++
++function sortAssets(assets: EngineAsset[], key: SortKey): EngineAsset[] {
++  const sorted = [...assets];
++  switch (key) {
++    case 'updated':
++      return sorted.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
++    case 'name':
++      return sorted.sort((a, b) => a.name.localeCompare(b.name));
++    case 'hp':
++      return sorted.sort((a, b) => getAssetPeakHP(b) - getAssetPeakHP(a));
++  }
++}
++
++// ── Component ───────────────────────────────────────────────────────
++
++export function EngineAssetInstallModal({ onInstall, onClose }: EngineAssetInstallModalProps) {
++  const [searchInput, setSearchInput] = useState('');
++  const [debouncedSearch, setDebouncedSearch] = useState('');
++  const [sortKey, setSortKey] = useState<SortKey>('updated');
++  const [page, setPage] = useState(0);
++  const debounceRef = useRef<ReturnType<typeof setTimeout>>();
++
++  const assets = useMemo(() => listEngineAssets('personal'), []);
++
++  // Debounced search
++  useEffect(() => {
++    clearTimeout(debounceRef.current);
++    debounceRef.current = setTimeout(() => {
++      setDebouncedSearch(searchInput);
++      setPage(0); // reset to first page on new search
++    }, DEBOUNCE_MS);
++    return () => clearTimeout(debounceRef.current);
++  }, [searchInput]);
++
++  // Filter
++  const filtered = useMemo(() => {
++    if (!debouncedSearch.trim()) return assets;
++    const q = debouncedSearch.toLowerCase();
++    return assets.filter(a =>
++      a.name.toLowerCase().includes(q) ||
++      a.kind.toLowerCase().includes(q) ||
++      a.tags?.some(t => t.toLowerCase().includes(q)),
++    );
++  }, [assets, debouncedSearch]);
++
++  // Sort
++  const sorted = useMemo(() => sortAssets(filtered, sortKey), [filtered, sortKey]);
++
++  // Paginate
++  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
++  const pageItems = useMemo(
++    () => sorted.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE),
++    [sorted, page],
++  );
++
++  return (
++    <div style={styles.overlay} onClick={onClose}>
++      <div style={styles.modal} onClick={e => e.stopPropagation()}>
++        <div style={styles.header}>
++          <h3 style={styles.title}>Install Engine from Library</h3>
++          <button style={styles.closeBtn} onClick={onClose}>✕</button>
++        </div>
++
++        {/* Search + Sort toolbar */}
++        <div style={styles.toolbar}>
++          <input
++            type="text"
++            placeholder="Search engines..."
++            value={searchInput}
++            onChange={e => setSearchInput(e.target.value)}
++            style={styles.searchInput}
++            autoFocus
++          />
++          <select
++            style={styles.sortSelect}
++            value={sortKey}
++            onChange={e => { setSortKey(e.target.value as SortKey); setPage(0); }}
++          >
++            {SORT_OPTIONS.map(o => (
++              <option key={o.value} value={o.value}>{o.label}</option>
++            ))}
++          </select>
++        </div>
++
++        {/* Results count */}
++        <div style={styles.countBar}>
++          {sorted.length === 0
++            ? (assets.length === 0 ? 'No engine assets yet' : 'No matches')
++            : `${sorted.length} engine${sorted.length !== 1 ? 's' : ''}`}
++        </div>
++
++        {/* List */}
++        <div style={styles.list}>
++          {pageItems.length === 0 ? (
++            <div style={styles.empty}>
++              {assets.length === 0
++                ? 'No engine assets yet. Save one from Engine Sim first.'
++                : 'No engines match your search.'}
++            </div>
++          ) : (
++            pageItems.map(asset => (
++              <AssetRow key={asset.id} asset={asset} onInstall={onInstall} />
++            ))
++          )}
++        </div>
++
++        {/* Pagination */}
++        {totalPages > 1 && (
++          <div style={styles.pagination}>
++            <button
++              style={styles.pageBtn}
++              disabled={page === 0}
++              onClick={() => setPage(p => p - 1)}
++            >← Prev</button>
++            <span style={styles.pageInfo}>
++              Page {page + 1} of {totalPages}
++            </span>
++            <button
++              style={styles.pageBtn}
++              disabled={page >= totalPages - 1}
++              onClick={() => setPage(p => p + 1)}
++            >Next →</button>
++          </div>
++        )}
++      </div>
++    </div>
++  );
++}
++
++// ── Asset Row ───────────────────────────────────────────────────────
++
++function AssetRow({ asset, onInstall }: { asset: EngineAsset; onInstall: (id: string, rev: number) => void }) {
++  const summary = getAssetSummary(asset);
++
++  return (
++    <button
++      style={styles.row}
++      onClick={() => onInstall(asset.id, asset.revision)}
++      onMouseEnter={e => {
++        (e.currentTarget as HTMLButtonElement).style.backgroundColor = 'var(--color-surface-hover, rgba(255,255,255,0.05))';
++      }}
++      onMouseLeave={e => {
++        (e.currentTarget as HTMLButtonElement).style.backgroundColor = 'transparent';
++      }}
++    >
++      <div style={styles.rowLeft}>
++        <div style={styles.rowName}>{asset.name}</div>
++        <div style={styles.rowMeta}>{summary}</div>
++      </div>
++      <div style={styles.rowRight}>
++        <span style={{
++          ...styles.kindBadge,
++          backgroundColor: `${KIND_COLORS[asset.kind]}20`,
++          color: KIND_COLORS[asset.kind],
++        }}>
++          {KIND_LABELS[asset.kind]}
++        </span>
++        <span style={styles.scopeBadge}>
++          {asset.scope === 'team' ? 'Team' : 'Personal'}
++        </span>
++      </div>
++    </button>
++  );
++}
++
++function getAssetSummary(asset: EngineAsset): string {
++  switch (asset.kind) {
++    case 'sim': {
++      const s = asset.payload.engineSimResultSummary;
++      return `${Math.round(s.peakHP)} HP @ ${Math.round(s.peakHpRpm)} RPM • ${Math.round(s.peakTQ)} lb-ft • ${s.displacement_ci.toFixed(0)} ci`;
++    }
++    case 'manual_peak': {
++      const p = asset.payload;
++      return `${Math.round(p.peakHP)} HP @ ${Math.round(p.peakHpRpm)} RPM`;
++    }
++    case 'dyno_curve': {
++      const pts = asset.payload.points;
++      const maxHp = Math.max(...pts.map(p => p.hp));
++      return `${pts.length} points • Peak ${Math.round(maxHp)} HP`;
++    }
++  }
++}
