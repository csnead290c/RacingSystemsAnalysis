++/**
++ * VB6 Time Semantics Debug Utilities
++ * 
++ * Proves what time fields in sim trace represent (absolute vs ET)
++ */
++
++export interface TimeSemanticsDiagnostic {
++  caseId: string;
++  rolloutIn: number;
++  rolloutFt: number;
++  
++  // Trace samples
++  traceAtZero: {
++    dist_ft: number;
++    time_s: number;
++    mph: number;
++    rpm: number;
++  } | null;
++  
++  traceAtRollout: {
++    dist_ft: number;
++    time_s: number;
++    mph: number;
++    rpm: number;
++  } | null;
++  
++  traceAt60ft: {
++    dist_ft: number;
++    time_s: number;
++    mph: number;
++    rpm: number;
++  } | null;
++  
++  // Analysis
++  interpretation: 'ABSOLUTE_TIME' | 'ET_POST_ROLLOUT';
++  evidence: string;
++}
++
++/**
++ * Analyze trace to determine if t_s represents absolute time or ET (post-rollout)
++ */
++export function analyzeTimeSemantics(
++  caseId: string,
++  rolloutIn: number,
++  simTrace: Array<{ dist_ft: number; time_s?: number; time_et_s?: number; time_abs_s?: number; mph: number; rpm: number }>
++): TimeSemanticsDiagnostic {
++  
++  const rolloutFt = rolloutIn / 12;
++  
++  // Prefer time_et_s if available, fallback to time_s
++  const getTime = (row: any) => row.time_et_s ?? row.time_s ?? 0;
++  
++  // DEBUG: Log first few rows to see actual field values
++  console.log('\n[TIME DEBUG] First 3 trace rows:');
++  for (let i = 0; i < Math.min(3, simTrace.length); i++) {
++    const row = simTrace[i];
++    console.log(`  Row ${i}: dist=${row.dist_ft?.toFixed(2)}, time_et_s=${row.time_et_s?.toFixed(3)}, time_s=${(row as any).time_s?.toFixed(3)}, time_abs_s=${row.time_abs_s}`);
++  }
++  
++  // Find trace at dist=0 (or closest)
++  let traceAtZero = null;
++  let minDiff = Infinity;
++  for (const row of simTrace) {
++    const diff = Math.abs(row.dist_ft - 0);
++    if (diff < minDiff) {
++      minDiff = diff;
++      traceAtZero = {
++        dist_ft: row.dist_ft,
++        time_s: getTime(row),
++        mph: row.mph,
++        rpm: row.rpm,
++      };
++    }
++  }
++  
++  // Find trace at rollout distance
++  // CRITICAL: vb6Exact trace s_ft is TRACK distance (post-rollout), not absolute!
++  // At rollout, s_ft = 0 (not rolloutFt)
++  let traceAtRollout = null;
++  minDiff = Infinity;
++  for (const row of simTrace) {
++    const diff = Math.abs(row.dist_ft - 0);  // Look for dist ≈ 0 (rollout point)
++    if (diff < minDiff && diff < 1.0) {  // Within 1ft of rollout
++      minDiff = diff;
++      traceAtRollout = {
++        dist_ft: row.dist_ft,
++        time_s: getTime(row),
++        mph: row.mph,
++        rpm: row.rpm,
++      };
++    }
++  }
++  
++  // DEBUG: Log rollout row details
++  if (traceAtRollout) {
++    console.log(`[TIME DEBUG] Rollout row (dist≈0): dist=${traceAtRollout.dist_ft.toFixed(2)}, time=${traceAtRollout.time_s.toFixed(3)}`);
++  }
++  
++  // Find trace at 60ft
++  let traceAt60ft = null;
++  minDiff = Infinity;
++  for (const row of simTrace) {
++    const diff = Math.abs(row.dist_ft - 60);
++    if (diff < minDiff) {
++      minDiff = diff;
++      traceAt60ft = {
++        dist_ft: row.dist_ft,
++        time_s: getTime(row),
++        mph: row.mph,
++        rpm: row.rpm,
++      };
++    }
++  }
++  
++  // Determine interpretation
++  let interpretation: 'ABSOLUTE_TIME' | 'ET_POST_ROLLOUT' = 'ET_POST_ROLLOUT';
++  let evidence = '';
++  
++  if (traceAtZero && traceAtRollout && traceAt60ft) {
++    // vb6Exact trace uses track coordinates: s_ft=0 and t_s=0 at rollout
++    // Check if time at dist≈0 is also ≈0 (confirming ET)
++    
++    if (Math.abs(traceAtRollout.time_s) < 0.01 && Math.abs(traceAtRollout.dist_ft) < 0.5) {
++      interpretation = 'ET_POST_ROLLOUT';
++      evidence = `Trace at dist≈0 (rollout): dist=${traceAtRollout.dist_ft.toFixed(2)}ft, time=${traceAtRollout.time_s.toFixed(3)}s. ` +
++                 `Both ≈0 confirms trace uses ET (post-rollout) coordinates. ` +
++                 `At 60ft track distance: time=${traceAt60ft.time_s.toFixed(3)}s.`;
++    } else {
++      interpretation = 'ABSOLUTE_TIME';
++      evidence = `Trace at dist≈0: dist=${traceAtRollout.dist_ft.toFixed(2)}ft, time=${traceAtRollout.time_s.toFixed(3)}s. ` +
++                 `Values not both ≈0, suggests absolute coordinates.`;
++    }
++  } else {
++    evidence = 'Insufficient trace data to determine time semantics.';
++  }
++  
++  return {
++    caseId,
++    rolloutIn,
++    rolloutFt,
++    traceAtZero,
++    traceAtRollout,
++    traceAt60ft,
++    interpretation,
++    evidence,
++  };
++}
++
++/**
++ * Print time semantics diagnostic to console
++ */
++export function printTimeSemanticsDiagnostic(diag: TimeSemanticsDiagnostic): void {
++  console.log('\n========================================');
++  console.log('TIME SEMANTICS DIAGNOSTIC');
++  console.log('========================================');
++  console.log(`Case: ${diag.caseId}`);
++  console.log(`Rollout: ${diag.rolloutIn}" = ${diag.rolloutFt.toFixed(3)}ft`);
++  console.log('');
++  
++  if (diag.traceAtZero) {
++    console.log(`Trace at 0ft: t=${diag.traceAtZero.time_s.toFixed(3)}s, v=${diag.traceAtZero.mph.toFixed(1)}mph, rpm=${diag.traceAtZero.rpm.toFixed(0)}`);
++  }
++  
++  if (diag.traceAtRollout) {
++    console.log(`Trace at ${diag.rolloutFt.toFixed(2)}ft (rollout): t=${diag.traceAtRollout.time_s.toFixed(3)}s, v=${diag.traceAtRollout.mph.toFixed(1)}mph, rpm=${diag.traceAtRollout.rpm.toFixed(0)}`);
++  }
++  
++  if (diag.traceAt60ft) {
++    console.log(`Trace at 60ft: t=${diag.traceAt60ft.time_s.toFixed(3)}s, v=${diag.traceAt60ft.mph.toFixed(1)}mph, rpm=${diag.traceAt60ft.rpm.toFixed(0)}`);
++  }
++  
++  console.log('');
++  console.log(`INTERPRETATION: ${diag.interpretation}`);
++  console.log(`EVIDENCE: ${diag.evidence}`);
++  console.log('========================================\n');
++}
