++/**
++ * Trace Sampling Helper
++ * Interpolates checkpoint values from simulation trace
++ */
++
++import type { JsonSimTrace } from './classic_json_sim_runner';
++
++export interface SampledCheckpoint {
++  distance_ft: number;
++  time_et_s: number;
++  mph: number;
++  rpm: number;
++  gear: number;
++  accel: number;
++}
++
++/**
++ * Sample trace at a specific distance using linear interpolation
++ */
++export function sampleAtDistance(trace: JsonSimTrace[], distance_ft: number): SampledCheckpoint | null {
++  if (trace.length === 0) {
++    return null;
++  }
++  
++  // Find bracketing points
++  let before: JsonSimTrace | null = null;
++  let after: JsonSimTrace | null = null;
++  
++  for (let i = 0; i < trace.length; i++) {
++    if (trace[i].s_ft <= distance_ft) {
++      before = trace[i];
++    }
++    if (trace[i].s_ft >= distance_ft && after === null) {
++      after = trace[i];
++      break;
++    }
++  }
++  
++  // Handle edge cases
++  if (before === null && after !== null) {
++    // Before start of trace - use first point
++    return {
++      distance_ft: distance_ft,
++      time_et_s: after.t_s,
++      mph: after.v_mph,
++      rpm: after.rpm,
++      gear: after.gear,
++      accel: after.a_g,
++    };
++  }
++  
++  if (before !== null && after === null) {
++    // After end of trace - use last point
++    return {
++      distance_ft: distance_ft,
++      time_et_s: before.t_s,
++      mph: before.v_mph,
++      rpm: before.rpm,
++      gear: before.gear,
++      accel: before.a_g,
++    };
++  }
++  
++  if (before === null && after === null) {
++    return null;
++  }
++  
++  // Exact match
++  if (before!.s_ft === distance_ft) {
++    return {
++      distance_ft: distance_ft,
++      time_et_s: before!.t_s,
++      mph: before!.v_mph,
++      rpm: before!.rpm,
++      gear: before!.gear,
++      accel: before!.a_g,
++    };
++  }
++  
++  if (after!.s_ft === distance_ft) {
++    return {
++      distance_ft: distance_ft,
++      time_et_s: after!.t_s,
++      mph: after!.v_mph,
++      rpm: after!.rpm,
++      gear: after!.gear,
++      accel: after!.a_g,
++    };
++  }
++  
++  // Linear interpolation
++  const fraction = (distance_ft - before!.s_ft) / (after!.s_ft - before!.s_ft);
++  
++  const time_et_s = before!.t_s + fraction * (after!.t_s - before!.t_s);
++  const mph = before!.v_mph + fraction * (after!.v_mph - before!.v_mph);
++  const rpm = before!.rpm + fraction * (after!.rpm - before!.rpm);
++  const accel = before!.a_g + fraction * (after!.a_g - before!.a_g);
++  
++  // Gear: use nearest point (no interpolation)
++  const gear = fraction < 0.5 ? before!.gear : after!.gear;
++  
++  return {
++    distance_ft,
++    time_et_s,
++    mph,
++    rpm,
++    gear,
++    accel,
++  };
++}
