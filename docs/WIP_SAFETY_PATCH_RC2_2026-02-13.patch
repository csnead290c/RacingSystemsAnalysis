++/**
++ * Compute summary statistics
++ */
++export function computeSummary(comparisons: CheckpointComparison[]): VB6EquivalenceReport['summary'] {
++  const passed = comparisons.filter(c => c.passed).length;
++  const failed = comparisons.length - passed;
++  
++  let maxTimeS = 0, maxMph = 0, maxRpm = 0, maxAccelG = 0;
++  let sumTimeS = 0, sumMph = 0, sumRpm = 0, sumAccelG = 0;
++  let countTimeS = 0, countMph = 0, countRpm = 0, countAccelG = 0;
++  
++  for (const cp of comparisons) {
++    if (cp.deltas.time_s !== undefined) {
++      const abs = Math.abs(cp.deltas.time_s);
++      if (abs > maxTimeS) maxTimeS = abs;
++      sumTimeS += abs;
++      countTimeS++;
++    }
++    if (cp.deltas.mph !== undefined) {
++      const abs = Math.abs(cp.deltas.mph);
++      if (abs > maxMph) maxMph = abs;
++      sumMph += abs;
++      countMph++;
++    }
++    if (cp.deltas.rpm !== undefined) {
++      const abs = Math.abs(cp.deltas.rpm);
++      if (abs > maxRpm) maxRpm = abs;
++      sumRpm += abs;
++      countRpm++;
++    }
++    if (cp.deltas.accel_g !== undefined) {
++      const abs = Math.abs(cp.deltas.accel_g);
++      if (abs > maxAccelG) maxAccelG = abs;
++      sumAccelG += abs;
++      countAccelG++;
++    }
++  }
++  
++  return {
++    totalCheckpoints: comparisons.length,
++    passedCheckpoints: passed,
++    failedCheckpoints: failed,
++    totalShifts: 0, // Will be filled in by caller
++    maxDeltas: {
++      time_s: maxTimeS,
++      mph: maxMph,
++      rpm: maxRpm,
++      accel_g: maxAccelG,
++    },
++    avgDeltas: {
++      time_s: countTimeS > 0 ? sumTimeS / countTimeS : 0,
++      mph: countMph > 0 ? sumMph / countMph : 0,
++      rpm: countRpm > 0 ? sumRpm / countRpm : 0,
++      accel_g: countAccelG > 0 ? sumAccelG / countAccelG : 0,
++    },
++  };
++}
