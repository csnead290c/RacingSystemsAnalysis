++/**
++ * ComponentLibraryList — Shared, reusable library list component
++ *
++ * Provides search (debounced), sort, pagination (20/page), scope filtering,
++ * and tag display for any component asset type (Engine, Clutch, Four-Link).
++ *
++ * The caller supplies:
++ *  - items: the full asset array
++ *  - columns: how to render each row
++ *  - sortOptions: available sort keys
++ *  - onSort: comparator per sort key
++ *  - onEdit / onDelete: action callbacks
++ *  - onTagsChange: optional tag editing callback
++ */
++
++import { useState, useMemo, useEffect, useRef } from 'react';
++
++// ── Generic Types ────────────────────────────────────────────────────
++
++export interface LibraryColumn<T> {
++  label: string;
++  width?: string;
++  render: (item: T) => React.ReactNode;
++}
++
++export interface LibrarySortOption<K extends string = string> {
++  value: K;
++  label: string;
++}
++
++export type ScopeFilter = 'all' | 'personal' | 'team';
++
++export interface ComponentLibraryListProps<T extends { id: string; name: string; tags?: string[]; scope: string; updatedAt: string }> {
++  title: string;
++  items: T[];
++  columns: LibraryColumn<T>[];
++  sortOptions: LibrarySortOption[];
++  defaultSort: string;
++  sortFn: (items: T[], key: string) => T[];
++  searchFn?: (item: T, query: string) => boolean;
++  onEdit?: (item: T) => void;
++  onDelete?: (id: string) => void;
++  onTagsChange?: (id: string, tags: string[]) => void;
++  emptyMessage?: string;
++  teamEnabled?: boolean;
++}
++
++// ── Constants ────────────────────────────────────────────────────────
++
++const PAGE_SIZE = 20;
++const DEBOUNCE_MS = 200;
++
++// ── Component ────────────────────────────────────────────────────────
++
++export function ComponentLibraryList<T extends { id: string; name: string; tags?: string[]; scope: string; updatedAt: string }>({
++  title,
++  items,
++  columns,
++  sortOptions,
++  defaultSort,
++  sortFn,
++  searchFn,
++  onEdit,
++  onDelete,
++  onTagsChange,
++  emptyMessage = 'No items yet.',
++  teamEnabled = false,
++}: ComponentLibraryListProps<T>) {
++  const [searchInput, setSearchInput] = useState('');
++  const [debouncedSearch, setDebouncedSearch] = useState('');
++  const [sortKey, setSortKey] = useState(defaultSort);
++  const [scopeFilter, setScopeFilter] = useState<ScopeFilter>('all');
++  const [page, setPage] = useState(0);
++  const [editingTagsId, setEditingTagsId] = useState<string | null>(null);
++  const [tagInput, setTagInput] = useState('');
++  const debounceRef = useRef<ReturnType<typeof setTimeout>>();
++
++  // Debounced search
++  useEffect(() => {
++    clearTimeout(debounceRef.current);
++    debounceRef.current = setTimeout(() => {
++      setDebouncedSearch(searchInput);
++      setPage(0);
++    }, DEBOUNCE_MS);
++    return () => clearTimeout(debounceRef.current);
++  }, [searchInput]);
++
++  // Filter by scope
++  const scopeFiltered = useMemo(() => {
++    if (scopeFilter === 'all') return items;
++    return items.filter(i => i.scope === scopeFilter);
++  }, [items, scopeFilter]);
++
++  // Filter by search
++  const searched = useMemo(() => {
++    if (!debouncedSearch.trim()) return scopeFiltered;
++    const q = debouncedSearch.toLowerCase();
++    if (searchFn) return scopeFiltered.filter(i => searchFn(i, q));
++    return scopeFiltered.filter(i =>
++      i.name.toLowerCase().includes(q) ||
++      i.tags?.some(t => t.toLowerCase().includes(q)),
++    );
++  }, [scopeFiltered, debouncedSearch, searchFn]);
++
++  // Sort
++  const sorted = useMemo(() => sortFn(searched, sortKey), [searched, sortKey, sortFn]);
++
++  // Paginate
++  const totalPages = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));
++  const pageItems = useMemo(
++    () => sorted.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE),
++    [sorted, page],
++  );
++
++  const handleTagsSave = (id: string) => {
++    if (!onTagsChange) return;
++    const tags = tagInput.split(',').map(t => t.trim()).filter(Boolean);
++    onTagsChange(id, tags);
++    setEditingTagsId(null);
++    setTagInput('');
++  };
++
++  return (
++    <div style={styles.container}>
++      {/* Header */}
++      <div style={styles.header}>
++        <h2 style={styles.title}>{title}</h2>
++        <span style={styles.count}>{sorted.length} item{sorted.length !== 1 ? 's' : ''}</span>
++      </div>
++
++      {/* Toolbar: Search + Sort + Scope */}
++      <div style={styles.toolbar}>
++        <input
++          type="text"
++          placeholder="Search..."
++          value={searchInput}
++          onChange={e => setSearchInput(e.target.value)}
++          style={styles.searchInput}
++        />
++        <select
++          style={styles.select}
++          value={sortKey}
++          onChange={e => { setSortKey(e.target.value); setPage(0); }}
++        >
++          {sortOptions.map(o => (
++            <option key={o.value} value={o.value}>{o.label}</option>
++          ))}
++        </select>
++        <select
++          style={styles.select}
++          value={scopeFilter}
++          onChange={e => { setScopeFilter(e.target.value as ScopeFilter); setPage(0); }}
++        >
++          <option value="all">All</option>
++          <option value="personal">Personal</option>
++          <option value="team" disabled={!teamEnabled}>
++            {teamEnabled ? 'Team' : 'Team (coming soon)'}
++          </option>
++        </select>
++      </div>
++
++      {/* Table */}
++      <div style={styles.tableWrap}>
++        <table style={styles.table}>
++          <thead>
++            <tr>
++              {columns.map((col, i) => (
++                <th key={i} style={{ ...styles.th, width: col.width }}>{col.label}</th>
++              ))}
++              <th style={{ ...styles.th, width: '80px' }}>Tags</th>
++              {(onEdit || onDelete) && <th style={{ ...styles.th, width: '90px' }}>Actions</th>}
++            </tr>
++          </thead>
++          <tbody>
++            {pageItems.length === 0 ? (
++              <tr>
++                <td colSpan={columns.length + (onEdit || onDelete ? 2 : 1)} style={styles.empty}>
++                  {items.length === 0 ? emptyMessage : 'No matches.'}
++                </td>
++              </tr>
++            ) : (
++              pageItems.map((item, idx) => (
++                <tr key={item.id} style={idx % 2 === 0 ? styles.rowEven : undefined}>
++                  {columns.map((col, ci) => (
++                    <td key={ci} style={styles.td}>{col.render(item)}</td>
++                  ))}
++                  <td style={styles.td}>
++                    {editingTagsId === item.id ? (
++                      <div style={{ display: 'flex', gap: '3px', alignItems: 'center' }}>
++                        <input
++                          type="text"
++                          value={tagInput}
++                          onChange={e => setTagInput(e.target.value)}
++                          onKeyDown={e => { if (e.key === 'Enter') handleTagsSave(item.id); if (e.key === 'Escape') setEditingTagsId(null); }}
++                          placeholder="tag1, tag2"
++                          style={{ ...styles.tagInput }}
++                          autoFocus
++                        />
++                        <button style={styles.tagSaveBtn} onClick={() => handleTagsSave(item.id)}>✓</button>
++                      </div>
++                    ) : (
++                      <div
++                        style={styles.tagsCell}
++                        onClick={() => {
++                          if (!onTagsChange) return;
++                          setEditingTagsId(item.id);
++                          setTagInput((item.tags ?? []).join(', '));
++                        }}
