++      // Target is even - boundary is exactly at midpoint
++      flipBoundary = (targetScaled - 0.5) / scale;
++    } else {
++      // Target is odd - need to exceed midpoint to previous even
++      flipBoundary = (targetScaled - 1 + 0.5) / scale + 1e-10;
++    }
++  } else if (flip_direction === 'down') {
++    // We need to find the largest value that rounds DOWN to targetValue
++    const targetScaled = Math.round(targetValue * scale);
++    if (targetScaled % 2 === 0) {
++      // Target is even - boundary is exactly at midpoint
++      flipBoundary = (targetScaled + 0.5) / scale;
++    } else {
++      // Target is odd - need to not exceed midpoint to next even
