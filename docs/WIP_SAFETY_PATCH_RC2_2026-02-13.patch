++        gearRatios: rawInputs.transmissionGearing?.map((g: any) => g.ratio) || [],
++        gearEfficiencies: rawInputs.transmissionGearing?.map((g: any) => g.efficiency) || [],
++        frontalArea_ft2: rawInputs.frontalArea_ft2,
++        dragCoeff: rawInputs.dragCoeff,
++        liftCoeff: rawInputs.liftCoeff,
++        environment: {
