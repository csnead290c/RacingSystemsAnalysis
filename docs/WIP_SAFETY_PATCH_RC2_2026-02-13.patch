++/**
++ * Rounding Cliff Analyzer - CORRECTED
++ * 
++ * Computes TRUE distance to flip boundary with correct ULP math.
++ * 
++ * CRITICAL: ULP calculation must use the correct domain (Float32 or Float64)
++ * and must compare bit representations, not floating-point arithmetic.
++ */
++
++/**
++ * Float32 cast helper
++ */
++function f32(x: number): number {
++  const arr = new Float32Array(1);
++  arr[0] = x;
++  return arr[0];
++}
++
++/**
++ * Banker's rounding (round-half-to-even)
++ */
++function bankersRound(value: number, decimals: number): number {
++  const factor = Math.pow(10, decimals);
++  const scaled = value * factor;
++  const floor = Math.floor(scaled);
++  const frac = scaled - floor;
++  
++  const isHalf = Math.abs(frac - 0.5) < 1e-10;
++  
++  if (isHalf) {
++    return (floor % 2 === 0 ? floor : floor + 1) / factor;
++  }
++  
++  return Math.round(scaled) / factor;
++}
++
++/**
++ * Get Float32 ULP distance between two values
++ * Returns the number of representable Float32 values between a and b
++ */
++function float32ULPDistance(a: number, b: number): number {
++  const arr = new Float32Array(2);
++  const view = new Uint32Array(arr.buffer);
++  
++  arr[0] = a;
++  arr[1] = b;
++  
++  const bits_a = view[0];
++  const bits_b = view[1];
++  
++  // Handle sign differences
++  if ((bits_a ^ bits_b) & 0x80000000) {
++    // Different signs - distance crosses zero
++    // This is complex, just return a large number
++    return Math.abs(a - b) / (Math.abs(a) * Math.pow(2, -23));
++  }
++  
++  return Math.abs(bits_b - bits_a);
++}
++
++/**
++ * Get Float64 ULP distance between two values
++ */
++function float64ULPDistance(a: number, b: number): number {
++  // For Float64, we need to use DataView to get the bits
++  const buffer = new ArrayBuffer(16);
++  const view = new DataView(buffer);
++  
++  view.setFloat64(0, a, true);
++  view.setFloat64(8, b, true);
++  
++  const bits_a = view.getBigUint64(0, true);
++  const bits_b = view.getBigUint64(8, true);
++  
++  // Handle sign differences
++  const sign_a = (bits_a >> 63n) & 1n;
++  const sign_b = (bits_b >> 63n) & 1n;
++  
++  if (sign_a !== sign_b) {
++    // Different signs
++    return Math.abs(a - b) / (Math.abs(a) * Math.pow(2, -52));
++  }
++  
++  return Number(bits_a > bits_b ? bits_a - bits_b : bits_b - bits_a);
++}
++
++/**
++ * Find the flip boundary for a given target display value
++ * Returns the raw value that would just barely flip to the next display value
++ * 
++ * For banker's rounding (round-half-to-even):
++ * - If target is even: boundary is exactly at x.xx5 (midpoint)
++ * - If target is odd: boundary is just past the midpoint from previous even
++ */
++function findFlipBoundary(
++  targetDisplay: number,
++  decimals: number,
++  direction: 'up' | 'down',
++  domain: 'float32' | 'float64'
++): number {
++  const scale = Math.pow(10, decimals);
++  const targetScaled = Math.round(targetDisplay * scale);
++  
++  // For banker's rounding, the boundary depends on whether target is even/odd
++  const isEven = targetScaled % 2 === 0;
++  
++  let boundary: number;
++  const epsilon = domain === 'float32' ? 1e-9 : 1e-15;
++  
++  if (direction === 'up') {
++    // Find smallest value that rounds UP to target
++    // We need to find where rounding changes from (target-1) to target
++    const prevValue = targetScaled - 1;
++    const midpoint = (prevValue + targetScaled) / 2 / scale;
++    
++    if (isEven) {
++      // Target is even - at exact midpoint, rounds to even (target)
++      boundary = midpoint;
++    } else {
++      // Target is odd - must exceed midpoint to round up from previous even
++      boundary = midpoint + epsilon;
++    }
++  } else {
++    // Find largest value that rounds DOWN to target  
++    // We need to find where rounding changes from target to (target+1)
++    const nextValue = targetScaled + 1;
++    const midpoint = (targetScaled + nextValue) / 2 / scale;
++    
++    if (isEven) {
++      // Target is even - at exact midpoint, rounds to even (target)
++      boundary = midpoint;
++    } else {
++      // Target is odd - must not exceed midpoint to stay at target
++      boundary = midpoint - epsilon;
++    }
++  }
++  
++  // Quantize to domain
++  if (domain === 'float32') {
++    boundary = f32(boundary);
++  }
++  
++  return boundary;
++}
++
++/**
++ * Analyze rounding cliff for MPH (Float32 domain)
++ */
++export function analyzeMPHRoundingCliff(
++  mph_raw_f32: number,
++  expectedDisplay: string
++): {
++  category: 'ROUNDING_CLIFF' | 'REAL_MISMATCH';
++  delta_to_flip_mph: number;
++  delta_ulps_f32: number;
++  actual_display: string;
++  flip_direction: 'up' | 'down' | 'none';
++  notes: string;
++} {
++  // Format the raw value
++  const actualRounded = bankersRound(mph_raw_f32, 1);
++  const actualDisplay = actualRounded.toFixed(1);
++  const expectedValue = parseFloat(expectedDisplay);
++  
++  // Determine flip direction
++  let flip_direction: 'up' | 'down' | 'none' = 'none';
++  if (actualRounded < expectedValue) {
++    flip_direction = 'up';
++  } else if (actualRounded > expectedValue) {
++    flip_direction = 'down';
++  }
++  
++  if (flip_direction === 'none') {
++    return {
++      category: 'ROUNDING_CLIFF',
++      delta_to_flip_mph: 0,
++      delta_ulps_f32: 0,
++      actual_display: actualDisplay,
++      flip_direction: 'none',
++      notes: 'Already matches - no flip needed',
++    };
++  }
++  
++  // Find flip boundary
++  const flipBoundary = findFlipBoundary(expectedValue, 1, flip_direction, 'float32');
++  
++  // Compute distance to flip
++  const delta_to_flip_mph = Math.abs(mph_raw_f32 - flipBoundary);
++  const delta_ulps_f32 = float32ULPDistance(mph_raw_f32, flipBoundary);
++  
++  // Classification
++  const threshold_mph = 1e-6;
++  const threshold_ulps = 2;
++  
++  const category = (delta_ulps_f32 <= threshold_ulps || delta_to_flip_mph <= threshold_mph)
++    ? 'ROUNDING_CLIFF'
++    : 'REAL_MISMATCH';
++  
++  const notes = category === 'ROUNDING_CLIFF'
++    ? `Within ${delta_ulps_f32} ULPs (${(delta_to_flip_mph * 1000).toFixed(6)}e-3 mph) - likely non-actionable`
++    : `${delta_to_flip_mph.toFixed(6)} mph (${delta_ulps_f32} ULPs) from flip - investigate`;
++  
++  return {
++    category,
++    delta_to_flip_mph,
++    delta_ulps_f32,
++    actual_display: actualDisplay,
++    flip_direction,
++    notes,
++  };
++}
++
++/**
++ * Analyze rounding cliff for ET (Float64 domain)
++ */
++export function analyzeETRoundingCliff(
++  et_raw_f64: number,
++  expectedDisplay: string
++): {
++  category: 'ROUNDING_CLIFF' | 'REAL_MISMATCH';
++  delta_to_flip_s: number;
++  delta_ulps_f64: number;
++  actual_display: string;
++  flip_direction: 'up' | 'down' | 'none';
++  notes: string;
++} {
++  // Format the raw value
++  const actualRounded = bankersRound(et_raw_f64, 2);
++  const actualDisplay = actualRounded.toFixed(2);
++  const expectedValue = parseFloat(expectedDisplay);
++  
++  // Determine flip direction
++  let flip_direction: 'up' | 'down' | 'none' = 'none';
++  if (actualRounded < expectedValue) {
++    flip_direction = 'up';
++  } else if (actualRounded > expectedValue) {
++    flip_direction = 'down';
++  }
++  
++  if (flip_direction === 'none') {
++    return {
++      category: 'ROUNDING_CLIFF',
++      delta_to_flip_s: 0,
++      delta_ulps_f64: 0,
++      actual_display: actualDisplay,
++      flip_direction: 'none',
++      notes: 'Already matches - no flip needed',
++    };
++  }
++  
++  // Find flip boundary
++  const flipBoundary = findFlipBoundary(expectedValue, 2, flip_direction, 'float64');
++  
++  // Compute distance to flip
++  const delta_to_flip_s = Math.abs(et_raw_f64 - flipBoundary);
++  const delta_ulps_f64 = float64ULPDistance(et_raw_f64, flipBoundary);
++  
++  // Classification
++  const threshold_s = 1e-7;
++  const threshold_ulps = 2;
++  
++  const category = (delta_ulps_f64 <= threshold_ulps || delta_to_flip_s <= threshold_s)
++    ? 'ROUNDING_CLIFF'
++    : 'REAL_MISMATCH';
++  
++  const notes = category === 'ROUNDING_CLIFF'
++    ? `Within ${delta_ulps_f64} ULPs (${(delta_to_flip_s * 1e6).toFixed(3)}μs) - likely non-actionable`
++    : `${(delta_to_flip_s * 1000).toFixed(6)}ms (${delta_ulps_f64} ULPs) from flip - investigate`;
++  
++  return {
++    category,
++    delta_to_flip_s,
++    delta_ulps_f64,
++    actual_display: actualDisplay,
++    flip_direction,
++    notes,
++  };
++}
