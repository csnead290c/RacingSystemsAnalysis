++/**
++ * Compute dt_error: how much dt would need to change to match expected MPH display
++ */
++function computeDtError(
++  dt_current: number,
++  expected_mph_display: string
++): {
++  dt_error_us: number;
++  mph_target_raw_mid: number;
++  dt_target: number;
++} {
++  const expectedValue = parseFloat(expected_mph_display);
++  
++  // Find the range of raw mph that would display to expected value
++  // For banker's rounding to 1 decimal:
++  // - If expected is even (e.g., 160.8): range is [160.75, 160.85)
++  // - If expected is odd (e.g., 160.9): range is (160.85, 160.95)
++  
++  const scale = 10;
++  const targetScaled = Math.round(expectedValue * scale);
++  const isEven = targetScaled % 2 === 0;
++  
++  let mph_min: number, mph_max: number;
++  
++  if (isEven) {
++    // Even: rounds to even at exact midpoint
++    mph_min = (targetScaled - 0.5) / scale;
++    mph_max = (targetScaled + 0.5) / scale;
++  } else {
++    // Odd: must exceed midpoints
++    mph_min = (targetScaled - 0.5) / scale + 1e-9;
++    mph_max = (targetScaled + 0.5) / scale - 1e-9;
++  }
++  
++  const mph_target_raw_mid = (mph_min + mph_max) / 2;
++  
++  // mph = 45 / dt, so dt = 45 / mph
++  const dt_target = 45.0 / mph_target_raw_mid;
++  const dt_error_s = dt_current - dt_target;
++  const dt_error_us = dt_error_s * 1e6;
++  
++  return { dt_error_us, mph_target_raw_mid, dt_target };
++}
