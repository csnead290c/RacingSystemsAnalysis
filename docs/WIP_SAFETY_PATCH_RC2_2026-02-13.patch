++/**
++ * Clutch Assets Storage Layer
++ *
++ * localStorage-backed CRUD for Clutch Assets. Follows the same pattern
++ * as engineAssets.ts. Namespaced by scope (personal/team).
++ *
++ * Team scope is stubbed — reads return an empty list, writes are no-ops.
++ */
++
++import type { ClutchAsset, ClutchAssetScope } from '../domain/library/clutchAssets';
++
++// ── Storage Keys ────────────────────────────────────────────────────
++
++const STORAGE_KEY_PERSONAL = 'rsa.clutchAssets.personal.v1';
++
++// ── Internal Helpers ────────────────────────────────────────────────
++
++function loadFromStorage(key: string): ClutchAsset[] {
++  try {
++    const data = localStorage.getItem(key);
++    if (!data) return [];
++    const items = JSON.parse(data);
++    return Array.isArray(items) ? items : [];
++  } catch {
++    return [];
++  }
++}
++
++function saveToLocalStorage(key: string, items: ClutchAsset[]): void {
++  try {
++    localStorage.setItem(key, JSON.stringify(items));
++  } catch (error) {
++    console.error(`Failed to save clutch assets to ${key}:`, error);
++  }
++}
++
++function keyForScope(scope: ClutchAssetScope): string {
++  switch (scope) {
++    case 'personal': return STORAGE_KEY_PERSONAL;
++    case 'team': return STORAGE_KEY_PERSONAL; // stub: team falls back to personal key for now
++  }
++}
++
++function generateId(): string {
++  if (typeof crypto !== 'undefined' && crypto.randomUUID) {
++    return crypto.randomUUID();
++  }
++  return `ca_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
++}
++
++// ── Public CRUD ─────────────────────────────────────────────────────
++
++/**
++ * List all clutch assets for a given scope.
++ */
++export function listClutchAssets(scope: ClutchAssetScope = 'personal'): ClutchAsset[] {
++  if (scope === 'team') return []; // stub
++  return loadFromStorage(keyForScope(scope));
++}
++
++/**
++ * Get a single clutch asset by ID. Searches personal scope.
++ */
++export function getClutchAsset(id: string): ClutchAsset | undefined {
++  const personal = loadFromStorage(STORAGE_KEY_PERSONAL);
++  return personal.find(a => a.id === id);
++}
++
++/**
++ * Create a new clutch asset. Returns the created asset with a generated ID.
++ */
++export function createClutchAsset(
++  asset: Omit<ClutchAsset, 'id' | 'createdAt' | 'updatedAt' | 'revision'> & { name: string },
++): ClutchAsset {
++  const now = new Date().toISOString();
++  const newAsset: ClutchAsset = {
++    ...asset,
++    id: generateId(),
++    createdAt: now,
++    updatedAt: now,
++    revision: 1,
++  } as ClutchAsset;
++
++  const key = keyForScope(newAsset.scope);
++  const items = loadFromStorage(key);
++  items.push(newAsset);
++  saveToLocalStorage(key, items);
++  return newAsset;
++}
++
++/**
++ * Update an existing clutch asset. Increments revision automatically.
++ */
++export function updateClutchAsset(
++  id: string,
++  updates: Partial<Omit<ClutchAsset, 'id' | 'createdAt' | 'revision'>>,
++): ClutchAsset | undefined {
++  const key = STORAGE_KEY_PERSONAL;
++  const items = loadFromStorage(key);
++  const idx = items.findIndex(a => a.id === id);
++  if (idx < 0) return undefined;
++
++  const existing = items[idx];
++  const updated: ClutchAsset = {
++    ...existing,
++    ...updates,
++    id: existing.id,
++    createdAt: existing.createdAt,
++    updatedAt: new Date().toISOString(),
++    revision: existing.revision + 1,
++  } as ClutchAsset;
++
++  items[idx] = updated;
++  saveToLocalStorage(key, items);
++  return updated;
++}
++
++/**
++ * Delete a clutch asset by ID.
++ */
++export function deleteClutchAsset(id: string): boolean {
++  const key = STORAGE_KEY_PERSONAL;
++  const items = loadFromStorage(key);
++  const filtered = items.filter(a => a.id !== id);
++  if (filtered.length === items.length) return false;
++  saveToLocalStorage(key, filtered);
++  return true;
++}
