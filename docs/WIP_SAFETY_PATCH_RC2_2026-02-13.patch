++      setEditCaps(new Set(d.plans[selectedPlan] || []));
++      setDirty(false);
++    } catch (e: any) {
++      setError(e.message);
++    } finally {
++      setLoading(false);
++    }
++  }, [selectedPlan]);
++
++  useEffect(() => { fetchData(); }, [fetchData]);
++
