++def parse_number(text: str) -> Optional[float]:
++    """Parse number from text, handling (s) suffix and other decorations"""
++    if not text:
++        return None
++    # Remove (s), commas, extra spaces
++    cleaned = text.replace('(s)', '').replace(',', '').strip()
++    # Extract first number
++    match = re.search(r'-?\d+\.?\d*', cleaned)
++    if match:
++        try:
++            return float(match.group())
++        except:
++            return None
++    return None
++
++def extract_first_float(text: str, patterns: List[str]) -> Optional[float]:
++    """
++    Extract first float matching any of the given regex patterns.
++    Handles inline format like "Tire Diameter - inches  28.0" or "Tire Diameter - inches | 28.0"
++    """
++    for pattern in patterns:
++        match = re.search(pattern, text, re.IGNORECASE | re.DOTALL)
++        if match:
++            # Try to extract number from the match
++            num_match = re.search(r'\d+\.?\d*', match.group())
++            if num_match:
++                try:
++                    return float(num_match.group())
++                except:
++                    pass
++    return None
++
++def extract_gear_ratio_from_final_drive(text: str) -> Optional[float]:
++    """
++    Extract rear gear ratio from Final Drive section.
++    Looks for "Final Drive" or "Final Drive Data" followed by "Gear Ratio" and a number.
++    Handles inline format with pipes: "Final Drive Data | Gear Ratio | 4.86"
++    """
++    # Find Final Drive section
++    final_drive_match = re.search(r'Final Drive(?:\s+Data)?', text, re.IGNORECASE)
++    if not final_drive_match:
++        return None
++    
++    # Search forward ~400 chars for Gear Ratio
++    start_pos = final_drive_match.start()
++    search_window = text[start_pos:start_pos + 400]
++    
++    # Try multiple patterns for Gear Ratio
++    patterns = [
++        r'Gear\s+Ratio[:\s|]+(\d+\.?\d*)',  # "Gear Ratio: 4.11" or "Gear Ratio | 4.86"
++        r'Ratio[:\s|]+(\d+\.?\d*)',          # "Ratio: 4.11"
++    ]
++    
++    for pattern in patterns:
++        match = re.search(pattern, search_window, re.IGNORECASE)
++        if match:
++            try:
++                value = float(match.group(1))
++                # Sanity check: gear ratios typically 2.0 - 6.0
++                if 1.5 <= value <= 8.0:
++                    return value
++            except:
++                pass
++    
++    return None
