++/**
++ * Parse a VB6 step trace CSV file
++ */
++export function parseStepTraceCsv(csvContent: string): StepTraceRow[] {
++  const lines = csvContent.trim().split('\n');
++  if (lines.length < 2) return [];
++  
++  const header = lines[0].split(',');
++  const rows: StepTraceRow[] = [];
++  
++  for (let i = 1; i < lines.length; i++) {
++    const values = lines[i].split(',');
++    if (values.length < header.length) continue;
++    
++    const row: StepTraceRow = {
++      stepIndex: parseInt(values[0], 10),
++      t_abs_s: parseFloat(values[1]),
++      t_et_s: parseFloat(values[2]),
++      dt_s: parseFloat(values[3]),
++      dist_abs_ft: parseFloat(values[4]),
++      dist_track_ft: parseFloat(values[5]),
++      vel_fps: parseFloat(values[6]),
++      vel_mph: parseFloat(values[7]),
++      accel_g: parseFloat(values[8]),
++      jerk_gps: parseFloat(values[9]),
++      gear: parseInt(values[10], 10),
++      engine_rpm: parseFloat(values[11]),
++      driveshaft_rpm: parseFloat(values[12]),
++      HP_raw: parseFloat(values[13]),
++      HP_after_clutch: parseFloat(values[14]),
++      HP_after_losses: parseFloat(values[15]),
++      TQ_lbft: parseFloat(values[16]),
++      clutchSlip: parseFloat(values[17]),
++      torqueMult: parseFloat(values[18]),
++      slipRatio: parseFloat(values[19]),
++      tireForce_lbf: parseFloat(values[20]),
++      dragForce_lbf: parseFloat(values[21]),
++      rollRes_lbf: parseFloat(values[22]),
++      gradeForce_lbf: parseFloat(values[23]),
++      netForce_lbf: parseFloat(values[24]),
++      rearWeight_lbf: parseFloat(values[25]),
++      frontWeight_lbf: parseFloat(values[26]),
++      wheelBarWeight_lbf: parseFloat(values[27]),
++      tractionLimit_g: parseFloat(values[28]),
++      CRTF: parseFloat(values[29]),
++      tireSlip: parseFloat(values[30]),
++      slip_flag: values[31] === '1',
++      shift_flag: parseInt(values[32], 10),
++      triggerFired: values[33]?.replace(/"/g, '') || '',
++      PQWT: parseFloat(values[34]),
++      k_iterations: parseInt(values[35], 10),
++    };
++    rows.push(row);
++  }
++  
++  return rows;
++}
