++/**
++ * Print trace semantics proof to console
++ */
++export function printTraceSemantics(proof: TraceSemanticsProof): void {
++  console.log('\n========================================');
++  console.log('TRACE SEMANTICS PROOF');
++  console.log('========================================');
++  console.log(`Case: ${proof.caseId}`);
++  console.log(`Rollout: ${proof.rolloutIn}" = ${proof.rolloutFt.toFixed(3)}ft`);
++  console.log('');
++  
++  console.log('SAMPLE TRACE ROWS:');
++  console.log('Index  Dist(ft)  Time(s)  MPH    RPM   Gear');
++  console.log('-----  --------  -------  -----  ----  ----');
++  
++  if (proof.firstRow) {
++    const r = proof.firstRow;
++    console.log(`${r.index.toString().padStart(5)}  ${r.dist_ft.toFixed(2).padStart(8)}  ${r.time_s.toFixed(3).padStart(7)}  ${r.mph.toFixed(1).padStart(5)}  ${r.rpm.toFixed(0).padStart(4)}  ${r.gear}`);
++  }
++  
++  if (proof.firstNonZeroMph) {
++    const r = proof.firstNonZeroMph;
++    console.log(`${r.index.toString().padStart(5)}  ${r.dist_ft.toFixed(2).padStart(8)}  ${r.time_s.toFixed(3).padStart(7)}  ${r.mph.toFixed(1).padStart(5)}  ${r.rpm.toFixed(0).padStart(4)}  ${r.gear}  <- first mph>0`);
++  }
++  
++  if (proof.rolloutRow) {
++    const r = proof.rolloutRow;
++    console.log(`${r.index.toString().padStart(5)}  ${r.dist_ft.toFixed(2).padStart(8)}  ${r.time_s.toFixed(3).padStart(7)}  ${r.mph.toFixed(1).padStart(5)}  ${r.rpm.toFixed(0).padStart(4)}  ${r.gear}  <- ROLLOUT`);
++  }
++  
++  if (proof.row10) {
++    const r = proof.row10;
++    console.log(`${r.index.toString().padStart(5)}  ${r.dist_ft.toFixed(2).padStart(8)}  ${r.time_s.toFixed(3).padStart(7)}  ${r.mph.toFixed(1).padStart(5)}  ${r.rpm.toFixed(0).padStart(4)}  ${r.gear}`);
++  }
++  
++  console.log('');
++  console.log('CONCLUSIONS:');
++  console.log(`Time Semantics: ${proof.timeSemantics}`);
++  console.log(`  Evidence: ${proof.timeEvidence}`);
++  console.log('');
++  console.log(`Distance Semantics: ${proof.distanceSemantics}`);
++  console.log(`  Evidence: ${proof.distanceEvidence}`);
++  console.log('========================================\n');
++}
