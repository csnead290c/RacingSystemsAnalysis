++/**
++ * Trace Semantics Proof Utility
++ * 
++ * CRITICAL: Proves what vb6Exact trace fields represent (absolute vs ET/track coordinates)
++ * DO NOT ASSUME based on field names - prove with actual data
++ */
++
++export interface TraceSemanticsProof {
++  caseId: string;
++  rolloutIn: number;
++  rolloutFt: number;
++  
++  // Sample rows
++  firstRow: TraceRow | null;
++  firstNonZeroMph: TraceRow | null;
++  rolloutRow: TraceRow | null;
++  row10: TraceRow | null;
++  
++  // Conclusions
++  timeSemantics: 'ABSOLUTE' | 'ET_POST_ROLLOUT';
++  distanceSemantics: 'ABSOLUTE' | 'TRACK_POST_ROLLOUT';
++  
++  // Evidence
++  timeEvidence: string;
++  distanceEvidence: string;
++}
++
++interface TraceRow {
++  index: number;
++  dist_ft: number;
++  time_s: number;
++  mph: number;
++  rpm: number;
++  gear: number;
++}
++
++/**
++ * Analyze trace to prove time and distance semantics
++ */
++export function proveTraceSemantics(
++  caseId: string,
++  rolloutIn: number,
++  trace: Array<{ dist_ft: number; time_s?: number; time_et_s?: number; mph: number; rpm: number; gear: number }>
++): TraceSemanticsProof {
++  
++  const rolloutFt = rolloutIn / 12;
++  
++  // Get time value (prefer time_et_s if available)
++  const getTime = (row: any) => row.time_et_s ?? row.time_s ?? 0;
++  
++  // Sample key rows
++  const firstRow = trace.length > 0 ? {
++    index: 0,
++    dist_ft: trace[0].dist_ft,
++    time_s: getTime(trace[0]),
++    mph: trace[0].mph,
++    rpm: trace[0].rpm,
++    gear: trace[0].gear,
++  } : null;
++  
++  // Find first row with mph > 0
++  let firstNonZeroMph: TraceRow | null = null;
++  for (let i = 0; i < trace.length; i++) {
++    if (trace[i].mph > 0.1) {
++      firstNonZeroMph = {
++        index: i,
++        dist_ft: trace[i].dist_ft,
++        time_s: getTime(trace[i]),
++        mph: trace[i].mph,
++        rpm: trace[i].rpm,
++        gear: trace[i].gear,
++      };
++      break;
++    }
++  }
++  
++  // Find row closest to rollout
++  // Strategy: Check both interpretations
++  // 1) If distance is ABSOLUTE: rollout is at dist ≈ rolloutFt
++  // 2) If distance is TRACK: rollout is at dist ≈ 0
++  
++  let rolloutRowAbsInterpretation: TraceRow | null = null;
++  let rolloutRowTrackInterpretation: TraceRow | null = null;
++  
++  let minDiffAbs = Infinity;
++  let minDiffTrack = Infinity;
++  
++  for (let i = 0; i < trace.length; i++) {
++    const diffAbs = Math.abs(trace[i].dist_ft - rolloutFt);
++    const diffTrack = Math.abs(trace[i].dist_ft - 0);
++    
++    if (diffAbs < minDiffAbs) {
++      minDiffAbs = diffAbs;
++      rolloutRowAbsInterpretation = {
++        index: i,
++        dist_ft: trace[i].dist_ft,
++        time_s: getTime(trace[i]),
++        mph: trace[i].mph,
++        rpm: trace[i].rpm,
++        gear: trace[i].gear,
++      };
++    }
++    
++    if (diffTrack < minDiffTrack && diffTrack < 1.0) {
++      minDiffTrack = diffTrack;
++      rolloutRowTrackInterpretation = {
++        index: i,
++        dist_ft: trace[i].dist_ft,
++        time_s: getTime(trace[i]),
++        mph: trace[i].mph,
++        rpm: trace[i].rpm,
++        gear: trace[i].gear,
++      };
++    }
++  }
++  
++  // Row 10 for reference
++  const row10 = trace.length > 10 ? {
++    index: 10,
++    dist_ft: trace[10].dist_ft,
++    time_s: getTime(trace[10]),
++    mph: trace[10].mph,
++    rpm: trace[10].rpm,
++    gear: trace[10].gear,
++  } : null;
++  
++  // Determine semantics
++  let timeSemantics: 'ABSOLUTE' | 'ET_POST_ROLLOUT' = 'ABSOLUTE';
++  let distanceSemantics: 'ABSOLUTE' | 'TRACK_POST_ROLLOUT' = 'ABSOLUTE';
++  let timeEvidence = '';
++  let distanceEvidence = '';
++  let rolloutRow: TraceRow | null = null;
++  
++  // Distance semantics: Check if smallest distance is ~0 or >0
++  const minDist = Math.min(...trace.slice(0, 20).map(r => r.dist_ft));
++  
++  if (minDist < 0.5) {
++    // Smallest distance is ~0, suggests TRACK coordinates
++    distanceSemantics = 'TRACK_POST_ROLLOUT';
++    rolloutRow = rolloutRowTrackInterpretation;
++    distanceEvidence = `Minimum distance in trace is ${minDist.toFixed(3)}ft ≈ 0. ` +
++                      `This indicates TRACK distance (post-rollout, 0 at rollout).`;
++  } else {
++    // Smallest distance is >0, suggests ABSOLUTE coordinates
++    distanceSemantics = 'ABSOLUTE';
++    rolloutRow = rolloutRowAbsInterpretation;
++    distanceEvidence = `Minimum distance in trace is ${minDist.toFixed(3)}ft > 0. ` +
++                      `This indicates ABSOLUTE distance (from launch).`;
++  }
++  
++  // Time semantics: Check time at rollout
++  if (rolloutRow) {
++    if (Math.abs(rolloutRow.time_s) < 0.01) {
++      timeSemantics = 'ET_POST_ROLLOUT';
++      timeEvidence = `Time at rollout (dist=${rolloutRow.dist_ft.toFixed(2)}ft) is ${rolloutRow.time_s.toFixed(3)}s ≈ 0. ` +
++                    `This indicates ET (post-rollout, timer starts at rollout).`;
++    } else if (rolloutRow.time_s > 0.05) {
++      timeSemantics = 'ABSOLUTE';
++      timeEvidence = `Time at rollout (dist=${rolloutRow.dist_ft.toFixed(2)}ft) is ${rolloutRow.time_s.toFixed(3)}s > 0. ` +
++                    `This indicates ABSOLUTE time (from launch).`;
++    } else {
++      timeEvidence = `Time at rollout is ${rolloutRow.time_s.toFixed(3)}s. Ambiguous - need more analysis.`;
++    }
++  } else {
++    timeEvidence = 'Could not locate rollout row in trace.';
++  }
++  
++  return {
++    caseId,
++    rolloutIn,
++    rolloutFt,
++    firstRow,
++    firstNonZeroMph,
++    rolloutRow,
++    row10,
++    timeSemantics,
++    distanceSemantics,
++    timeEvidence,
++    distanceEvidence,
++  };
++}
