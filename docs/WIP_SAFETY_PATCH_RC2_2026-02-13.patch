++
++      // Show context: 1 checkpoint before and after
++      const contextBefore = result.comparisons.find(c => c.index === fail.index - 1);
++      const contextAfter = result.comparisons.find(c => c.index === fail.index + 1);
++
++      if (contextBefore) {
++        lines.push(`  [${contextBefore.index}] ${contextBefore.pass ? '✅' : '❌'} dist=${contextBefore.vb6.dist_ft} ft (context before)`);
++      }
++
++      // Field-by-field diff table
++      lines.push(`  ${'Field'.padEnd(10)} ${'VB6'.padStart(10)} ${'TS'.padStart(10)} ${'Δ'.padStart(10)} ${'Tol'.padStart(8)} ${''.padStart(4)}`);
++      lines.push(`  ${'─'.repeat(10)} ${'─'.repeat(10)} ${'─'.repeat(10)} ${'─'.repeat(10)} ${'─'.repeat(8)} ${'─'.repeat(4)}`);
++
++      for (const f of fail.fields) {
++        const mark = f.pass ? '  ' : '❌';
++        lines.push(
++          `  ${f.field.padEnd(10)} ` +
++          `${f.vb6.toFixed(2).padStart(10)} ` +
++          `${f.ts.toFixed(2).padStart(10)} ` +
++          `${(f.delta >= 0 ? '+' : '') + f.delta.toFixed(2)}`.padStart(11) + ' ' +
++          `±${f.tolerance.toFixed(2)}`.padStart(8) + ' ' +
++          mark
++        );
++      }
++
++      if (contextAfter) {
++        lines.push(`  [${contextAfter.index}] ${contextAfter.pass ? '✅' : '❌'} dist=${contextAfter.vb6.dist_ft} ft (context after)`);
++      }
++    }
++  }
++
++  lines.push('');
++  lines.push(hr);
++  return lines.join('\n');
++}
++
++/**
++ * Format summary comparison as a readable string.
++ */
++export function formatSummaryReport(caseId: string, summaryDiffs: SummaryComparison[]): string {
++  const lines: string[] = [];
++  const allPass = summaryDiffs.every(s => s.pass);
++
