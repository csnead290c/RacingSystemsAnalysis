++/**
++ * Tests for fromVehicleToVB6Fixture engine resolution.
++ *
++ * Proves that:
++ *  - Installed manual_peak asset overrides legacy powerHP/rpmAtPeakHP
++ *  - Installed dyno_curve asset overrides legacy hpCurve
++ *  - Missing asset falls back gracefully to legacy fields
++ *  - engineWhatIf.hpDelta applies after resolution
++ *  - Original vehicle object is NOT mutated
++ */
++
++import { describe, it, expect, vi, beforeEach } from 'vitest';
++import { fromVehicleToVB6Fixture } from '../fromVehicle';
++import type { EngineAsset } from '../../../domain/library/engineAssets';
++
++// ── Mock the engine asset store ─────────────────────────────────────
++
++const MOCK_ASSETS: Record<string, EngineAsset> = {};
++
++vi.mock('../../../state/engineAssets', () => ({
++  getEngineAsset: (id: string) => MOCK_ASSETS[id],
++  listEngineAssets: () => Object.values(MOCK_ASSETS),
++  createEngineAsset: vi.fn(),
++  updateEngineAsset: vi.fn(),
++  deleteEngineAsset: vi.fn(),
++}));
++
++// ── Helpers ─────────────────────────────────────────────────────────
++
++const NOW = '2025-01-01T00:00:00.000Z';
++
++/** Minimal vehicle with legacy fields that produces a valid fixture */
++function baseVehicle(overrides: Record<string, any> = {}) {
++  return {
++    id: 'v1',
++    name: 'Test Car',
++    weightLb: 3000,
++    tireDiaIn: 28,
++    tireWidthIn: 14,
++    rolloutIn: 12,
++    wheelbaseIn: 108,
++    rearGear: 3.73,
++    gearRatios: [2.6, 1.9, 1.5, 1.2, 1.0],
++    powerHP: 400,
++    rpmAtPeakHP: 6500,
++    displacementCID: 350,
++    transmissionType: 'clutch',
++    clutchSlipRPM: 6500,
++    ...overrides,
++  } as any;
++}
++
++// ── Tests ───────────────────────────────────────────────────────────
++
++beforeEach(() => {
++  // Clear mock assets
++  for (const key of Object.keys(MOCK_ASSETS)) delete MOCK_ASSETS[key];
++});
++
++describe('fromVehicleToVB6Fixture — engine resolution', () => {
++  it('uses legacy powerHP when no engineInstall/engineManual', () => {
++    const v = baseVehicle({ powerHP: 400, rpmAtPeakHP: 6500 });
++    const fixture = fromVehicleToVB6Fixture(v, { forceQuarterJr: true });
++
++    // The fixture's engineHP curve should be built from peak 400 HP
++    const maxHP = Math.max(...fixture.engineHP.map(pt => pt[1]));
++    expect(maxHP).toBeGreaterThanOrEqual(390); // synthetic curve peaks near 400
++    expect(maxHP).toBeLessThanOrEqual(410);
++  });
++
++  it('installed manual_peak asset overrides legacy powerHP', () => {
++    MOCK_ASSETS['mp-1'] = {
++      id: 'mp-1',
++      name: 'Manual 600HP',
++      scope: 'personal',
++      kind: 'manual_peak',
++      createdAt: NOW,
++      updatedAt: NOW,
++      revision: 1,
++      payload: { peakHP: 600, peakHpRpm: 7000 },
++    } as EngineAsset;
++
++    const v = baseVehicle({
++      powerHP: 400, // legacy — should be overridden
++      rpmAtPeakHP: 6500,
++      engineInstall: { engineAssetId: 'mp-1', pinnedRevision: 1 },
++    });
++
++    const fixture = fromVehicleToVB6Fixture(v, { forceQuarterJr: true });
++
++    // Synthetic curve should be built from 600 HP, not 400
++    const maxHP = Math.max(...fixture.engineHP.map(pt => pt[1]));
++    expect(maxHP).toBeGreaterThanOrEqual(590);
++    expect(maxHP).toBeLessThanOrEqual(610);
++  });
++
++  it('installed dyno_curve asset overrides legacy hpCurve', () => {
++    MOCK_ASSETS['dc-1'] = {
++      id: 'dc-1',
++      name: 'Dyno 500HP',
++      scope: 'personal',
++      kind: 'dyno_curve',
++      createdAt: NOW,
++      updatedAt: NOW,
++      revision: 2,
++      payload: {
++        points: [
++          { rpm: 3000, hp: 200, tq: 350 },
++          { rpm: 4500, hp: 350, tq: 408 },
++          { rpm: 6000, hp: 500, tq: 438 },
++          { rpm: 7000, hp: 480, tq: 360 },
++        ],
++        source: 'user',
++      },
++    } as EngineAsset;
++
++    const v = baseVehicle({
++      powerHP: 400, // legacy — should be overridden
++      engineInstall: { engineAssetId: 'dc-1', pinnedRevision: 2 },
++    });
++
++    // Don't force QuarterJr — let it detect the dyno curve
++    const fixture = fromVehicleToVB6Fixture(v);
++
++    // Should use the dyno curve points, not legacy
++    const maxHP = Math.max(...fixture.engineHP.map(pt => pt[1]));
++    expect(maxHP).toBeCloseTo(500, 0);
++    expect(fixture.engineHP.length).toBeGreaterThanOrEqual(4);
++  });
++
++  it('missing asset falls back to legacy fields', () => {
++    // No asset in MOCK_ASSETS for 'missing-id'
