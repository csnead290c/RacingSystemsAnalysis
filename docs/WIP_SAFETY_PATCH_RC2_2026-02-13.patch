++/**
++ * EarliestMismatchFinder - Identifies the first checkpoint that fails tolerance
++ * 
++ * Uses VB6 print formatting rules for comparison:
++ * - time: 2 decimals (except rollout which has special formatting)
++ * - mph: 1 decimal
++ * - accel: 2 decimals
++ * - rpm: nearest 10
++ * 
++ * Returns deterministic result (same earliest failure every run).
++ */
++
++export interface FormattedCheckpoint {
++  label: string;
++  distance_ft: number | null;
++  time_s: number;
++  mph: number;
++  accel_g: number;
++  rpm: number;
++  gear: number;
++  debug?: any;  // CRITICAL: Preserve debug provenance through formatting
++}
++
++export interface MismatchInfo {
++  checkpoint: string;
++  distance_ft: number | null;
++  expected: FormattedCheckpoint;
++  actual: FormattedCheckpoint;
++  deltas: {
++    time_s: number;
++    mph: number;
++    accel_g: number;
++    rpm: number;
++    gear: number;
++  };
++  failedFields: string[];
++}
++
++export interface ToleranceConfig {
++  time_s: number;
++  mph: number;
++  accel_g: number;
++  rpm: number;
++}
++
++/**
++ * Apply VB6 print formatting rules to checkpoint values
++ * VB6 TIMESLIP.FRM lines 1490-1518
++ */
++function applyVB6Formatting(row: any): FormattedCheckpoint {
++  // For rollout, time_s should be 0 (ET starts at rollout)
++  const isRollout = row.label === 'Rollout' || 
++                    row.distance === 'Rollout' ||
++                    row.distance_ft === null;
++  
++  // Apply VB6 formatting rules
++  const formattedTime = isRollout ? 0 : Math.round((row.time_s ?? row.time_et_s ?? 0) * 100) / 100;  // 2 decimals
++  const formattedMph = Math.round((row.mph ?? 0) * 10) / 10;  // 1 decimal
++  const formattedAccel = Math.round((row.accel_g ?? row.accel ?? 0) * 100) / 100;  // 2 decimals
++  const formattedRpm = Math.round((row.rpm ?? 0) / 10) * 10;  // Nearest 10
++  
++  const formatted = {
++    label: row.label || row.name || 'Unknown',
++    distance_ft: row.distance_ft ?? row.dist_ft ?? null,
++    time_s: formattedTime,
++    mph: formattedMph,
++    accel_g: formattedAccel,
++    rpm: formattedRpm,
++    gear: row.gear ?? 0,
++    debug: row.debug,  // CRITICAL: Preserve debug provenance
++  };
++  
++  return formatted;
++}
++
++/**
++ * Check if a checkpoint passes tolerance
++ */
++function checkTolerance(
++  expected: FormattedCheckpoint,
++  actual: FormattedCheckpoint,
++  tolerance: ToleranceConfig
++): { passes: boolean; failedFields: string[] } {
++  const failedFields: string[] = [];
++  
++  // Skip staged row (always 0,0,0)
++  if (expected.label === 'Staged' || expected.distance_ft === 0 && expected.time_s === 0 && expected.mph === 0) {
++    return { passes: true, failedFields: [] };
++  }
++  
++  // Check each field
++  if (Math.abs(expected.time_s - actual.time_s) > tolerance.time_s) {
++    failedFields.push('time_s');
++  }
++  if (Math.abs(expected.mph - actual.mph) > tolerance.mph) {
++    failedFields.push('mph');
++  }
++  if (Math.abs(expected.accel_g - actual.accel_g) > tolerance.accel_g) {
++    failedFields.push('accel_g');
++  }
++  if (Math.abs(expected.rpm - actual.rpm) > tolerance.rpm) {
++    failedFields.push('rpm');
++  }
++  
++  return {
++    passes: failedFields.length === 0,
++    failedFields,
++  };
++}
++
++/**
++ * Find the earliest checkpoint that fails tolerance
++ * 
++ * @param expectedCheckpoints - JSON ground truth checkpoints
++ * @param actualTimeslipRows - Simulation timeslipRows output
++ * @param tolerance - Tolerance config for each field
++ * @returns MismatchInfo for earliest failure, or null if all pass
++ */
++export function findEarliestMismatch(
++  expectedCheckpoints: any[],
++  actualTimeslipRows: any[],
++  tolerance: ToleranceConfig
++): MismatchInfo | null {
++  
++  // Format both expected and actual using VB6 rules
++  const formattedExpected = expectedCheckpoints.map(cp => applyVB6Formatting(cp));
++  const formattedActual = actualTimeslipRows.map(row => applyVB6Formatting(row));
++  
++  // Match checkpoints by distance (or label for rollout)
++  for (let i = 0; i < formattedExpected.length; i++) {
++    const expected = formattedExpected[i];
++    
++    // Find matching actual checkpoint
++    let actual: FormattedCheckpoint | undefined;
++    
++    if (expected.label === 'Rollout' || expected.distance_ft === null) {
++      // Match rollout by label
++      actual = formattedActual.find(a => a.label === 'Rollout' || a.distance_ft === null);
++    } else if (expected.label === 'Staged' || expected.distance_ft === 0) {
++      // Match staged by distance = 0
++      actual = formattedActual.find(a => a.distance_ft === 0);
++    } else {
++      // Match numeric checkpoint by distance (exact match required)
++      actual = formattedActual.find(a => a.distance_ft === expected.distance_ft);
++    }
++    
++    if (!actual) {
++      // Checkpoint missing in actual output - this is a failure
++      // Use distance-based label for numeric checkpoints
++      const checkpointLabel = typeof expected.distance_ft === 'number' && expected.distance_ft > 0
++        ? `${expected.distance_ft}ft`
++        : expected.label;
++      
++      return {
++        checkpoint: checkpointLabel,
++        distance_ft: expected.distance_ft,
++        expected,
++        actual: {
++          label: 'MISSING',
++          distance_ft: expected.distance_ft,
++          time_s: 0,
++          mph: 0,
++          accel_g: 0,
++          rpm: 0,
++          gear: 0,
++        },
++        deltas: {
++          time_s: -expected.time_s,
++          mph: -expected.mph,
++          accel_g: -expected.accel_g,
++          rpm: -expected.rpm,
++          gear: -expected.gear,
++        },
++        failedFields: ['MISSING'],
++      };
++    }
++    
++    // Check tolerance
++    const { passes, failedFields } = checkTolerance(expected, actual, tolerance);
++    
++    if (!passes) {
++      // Found earliest mismatch - use distance-based label for numeric checkpoints
++      const checkpointLabel = typeof expected.distance_ft === 'number' && expected.distance_ft > 0
++        ? `${expected.distance_ft}ft`
++        : expected.label;
++      
++      return {
++        checkpoint: checkpointLabel,
++        distance_ft: expected.distance_ft,
++        expected,
++        actual,  // Debug field already preserved by applyVB6Formatting
++        deltas: {
++          time_s: actual.time_s - expected.time_s,
++          mph: actual.mph - expected.mph,
++          accel_g: actual.accel_g - expected.accel_g,
++          rpm: actual.rpm - expected.rpm,
++          gear: actual.gear - expected.rpm,
++        },
++        failedFields,
++      };
++    }
++  }
++  
++  // All checkpoints passed
++  return null;
++}
++
++/**
++ * Get default tolerance based on test case type
++ */
++export function getDefaultTolerance(caseId: string): ToleranceConfig {
++  // These tolerances match the existing vb6_equivalence_debug.ts logic
++  if (caseId.includes('ProStock')) {
++    return {
++      time_s: 0.01,
++      mph: 0.5,
++      accel_g: 0.05,
++      rpm: 50,
++    };
++  }
++  
++  // Default tolerance for Quarter Pro/Jr
++  return {
++    time_s: 0.30,
++    mph: 4.0,
++    accel_g: 0.50,
++    rpm: 500,
++  };
++}
