++## 8. Required TS Helpers
++
++```typescript
++/** VB6 assignment to Single variable - truncates Double result to Single */
++export const vb6AssignSingle = (x: number): number => Math.fround(x);
++
++/** VB6 assignment to Double variable - no truncation */
++export const vb6AssignDouble = (x: number): number => x;
++
++/** VB6 assignment to Integer variable - truncates to 16-bit signed integer */
++export const vb6AssignInteger = (x: number): number => Math.trunc(x) | 0;
++```
