++  Vel0: number,
++  Ags0: number,
++  TimeStep: number,
++  Jerk: number
++): number {
++  // Compute entire expression in Double, truncate only at assignment
++  return vb6AssignSingle(
++    Vel0 + Ags0 * gc * TimeStep + Jerk * gc * TimeStep * TimeStep / 2
++  );
++}
