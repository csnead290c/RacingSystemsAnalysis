+diff --git a/src/integration-tests/classic_pdf_parity.spec.ts b/src/integration-tests/classic_pdf_parity.spec.ts
+new file mode 100644
+index 00000000..a0ff3fbe
+--- /dev/null
++++ b/src/integration-tests/classic_pdf_parity.spec.ts
+@@ -0,0 +1,562 @@
++/**
++ * Classic PDF Parity Tests
++ * 
++ * Compares simulation output against PDF-extracted checkpoints (ground truth).
++ * Uses interpolation to sample sim traces at PDF checkpoint distances.
++ * Validates ET and MPH within model-specific tolerances.
++ */
++
++import { describe, it, expect } from 'vitest';
++import { loadClassicCase } from './helpers/classic_case_loader';
++import { runClassicSimCase } from './helpers/classic_sim_runner';
++import type { ClassicCaseCheckpointRow, ModelName } from './helpers/classic_types';
++import { QUARTERJR_CASES, BONNEVILLEPRO_CASES } from './fixtures/classic_case_inventory';
++import { QUARTERPRO_CHECKPOINTS_EXTRACTED } from './fixtures/quarterpro_checkpoints_extracted';
++
++/**
++ * Linear interpolation helper
++ */
++function lerp(x0: number, y0: number, x1: number, y1: number, x: number): number {
++  if (x1 === x0) return y0;
++  return y0 + (y1 - y0) * (x - x0) / (x1 - x0);
++}
++
++/**
++ * Sample simulation trace at a specific distance using linear interpolation
++ */
++function sampleSimAtDistance(
++  simCheckpoints: ClassicCaseCheckpointRow[],
++  targetDist: number
++): { et_s: number; mph: number } | null {
++  
++  // Find bracketing points
++  let before: ClassicCaseCheckpointRow | null = null;
++  let after: ClassicCaseCheckpointRow | null = null;
++  
++  for (let i = 0; i < simCheckpoints.length; i++) {
++    const cp = simCheckpoints[i];
++    if (cp.dist_ft <= targetDist) {
++      before = cp;
++    }
++    if (cp.dist_ft >= targetDist && !after) {
++      after = cp;
++      break;
++    }
++  }
++  
++  if (!before || !after) return null;
++  
++  // Interpolate
++  const et_s = lerp(before.dist_ft, before.time_et_s, after.dist_ft, after.time_et_s, targetDist);
++  const mph = lerp(before.dist_ft, before.mph || 0, after.dist_ft, after.mph || 0, targetDist);
++  
++  return { et_s, mph };
++}
++
++/**
++ * Get tolerance for ET comparison based on distance and model
++ */
++function getETTolerance(dist_ft: number, model: ModelName): number {
++  if (model === 'BonnevillePro') {
++    // Land speed racing: more lenient
++    return dist_ft > 20000 ? 0.20 : 0.10;
++  }
++  
++  // Drag racing (QuarterJr/QuarterPro)
++  if (dist_ft <= 330) return 0.03;
++  if (dist_ft <= 1000) return 0.05;
++  return 0.08;
++}
++
++/**
++ * Get tolerance for MPH comparison based on distance and model
++ */
++function getMPHTolerance(dist_ft: number, model: ModelName): number {
++  if (model === 'BonnevillePro') {
++    return dist_ft > 20000 ? 2.0 : 1.5;
++  }
++  
++  // Drag racing
++  if (dist_ft <= 660) return 0.8;
++  return 1.0;
++}
++
++/**
++ * Time mapping mode for PDF checkpoints
++ */
++interface TimeMapping {
++  mode: 'as_et' | 'abs_minus_offset';
++  offset_s: number;
++  rms: number;
++}
++
++/**
++ * Choose the best time mapping mode by comparing against sim at anchor distances
++ * Excludes early distances (< 60ft) and rollout from anchor selection
++ */
++function choosePdfTimeMapping(
++  pdfCheckpoints: ClassicCaseCheckpointRow[],
++  simCheckpoints: ClassicCaseCheckpointRow[]
++): TimeMapping {
++  
++  // Find rollout row to get time offset
++  const rolloutRow = pdfCheckpoints.find(cp => 
++    cp.label?.toLowerCase().includes('rollout') || 
++    (cp.time_abs_s !== null && cp.time_abs_s !== undefined && cp.time_et_s === 0)
++  );
++  
++  const timeOffset_s = rolloutRow && rolloutRow.time_abs_s !== null && rolloutRow.time_abs_s !== undefined
++    ? (rolloutRow.time_abs_s - rolloutRow.time_et_s)
++    : 0;
++  
++  // Select anchor distances for comparison (prefer standard checkpoints >= 60ft)
++  const preferredAnchors = [330, 660, 1000, 1320];
++  const availableAnchors: number[] = [];
++  
++  for (const dist of preferredAnchors) {
++    const cp = pdfCheckpoints.find(cp => 
++      Math.abs(cp.dist_ft - dist) < 1 && 
++      cp.label !== 'Rollout' && 
++      cp.label !== 'Staged' &&
++      cp.dist_ft >= 60
++    );
++    if (cp) availableAnchors.push(dist);
++  }
++  
++  // If < 3 standard anchors, use largest 3-5 distances >= 60ft
++  if (availableAnchors.length < 3) {
++    const largeDists = pdfCheckpoints
++      .filter(cp => 
++        cp.label !== 'Rollout' && 
++        cp.label !== 'Staged' && 
++        cp.dist_ft >= 60
++      )
++      .map(cp => cp.dist_ft)
++      .sort((a, b) => b - a)
++      .slice(0, 5);
++    
++    for (const dist of largeDists) {
++      if (!availableAnchors.includes(dist)) {
++        availableAnchors.push(dist);
++      }
++    }
++  }
++  
++  // Compute mean absolute error for each mode
++  const modes: TimeMapping[] = [];
++  
++  // Mode A: as_et (PDF time_et_s or time_abs_s used directly as ET)
++  {
++    let sumAbsErr = 0;
++    let count = 0;
++    
++    for (const anchorDist of availableAnchors) {
++      const pdfCp = pdfCheckpoints.find(cp => Math.abs(cp.dist_ft - anchorDist) < 1);
++      if (!pdfCp) continue;
++      
++      const sampled = sampleSimAtDistance(simCheckpoints, pdfCp.dist_ft);
++      if (!sampled) continue;
++      
++      // Use time_et_s if available, else time_abs_s
++      const pdfET = pdfCp.time_et_s ?? pdfCp.time_abs_s ?? 0;
++      const simET = sampled.et_s;
++      const err = Math.abs(simET - pdfET);
++      sumAbsErr += err;
++      count++;
++    }
++    
++    const mae = count > 0 ? sumAbsErr / count : Infinity;
++    modes.push({ mode: 'as_et', offset_s: 0, rms: mae });
++  }
++  
++  // Mode B: abs_minus_offset (PDF times are absolute, subtract rollout offset)
++  if (timeOffset_s > 0 && isFinite(timeOffset_s)) {
++    let sumAbsErr = 0;
++    let count = 0;
++    
++    for (const anchorDist of availableAnchors) {
++      const pdfCp = pdfCheckpoints.find(cp => Math.abs(cp.dist_ft - anchorDist) < 1);
++      if (!pdfCp) continue;
++      
++      const sampled = sampleSimAtDistance(simCheckpoints, pdfCp.dist_ft);
++      if (!sampled) continue;
++      
++      // Use time_abs_s if available, else time_et_s, then subtract offset
++      const pdfAbsTime = pdfCp.time_abs_s ?? pdfCp.time_et_s ?? 0;
++      const pdfET = pdfAbsTime - timeOffset_s;
++      const simET = sampled.et_s;
++      const err = Math.abs(simET - pdfET);
++      sumAbsErr += err;
++      count++;
++    }
++    
++    const mae = count > 0 ? sumAbsErr / count : Infinity;
++    modes.push({ mode: 'abs_minus_offset', offset_s: timeOffset_s, rms: mae });
++  }
++  
++  // Choose mode with lower MAE
++  modes.sort((a, b) => a.rms - b.rms);
++  
++  return modes[0] || { mode: 'as_et', offset_s: 0, rms: Infinity };
++}
++
++/**
++ * Compare sim output against PDF checkpoints for a single case
++ */
++interface ComparisonResult {
++  passed: number;
++  failed: number;
++  errors: string[];
++  timeMapping: TimeMapping;
++  deltas: Array<{ dist_ft: number; etDelta: number; mphDelta: number | null }>;
++}
++
++function compareSimToPDF(
++  caseId: string,
++  model: ModelName,
++  simCheckpoints: ClassicCaseCheckpointRow[],
++  pdfCheckpoints: ClassicCaseCheckpointRow[]
++): ComparisonResult {
++  
++  const errors: string[] = [];
++  const deltas: Array<{ dist_ft: number; etDelta: number; mphDelta: number | null }> = [];
++  let passed = 0;
++  let failed = 0;
++  
++  // Validate sim is monotonic (allow small floating point errors)
++  for (let i = 1; i < simCheckpoints.length; i++) {
++    if (simCheckpoints[i].time_et_s < simCheckpoints[i - 1].time_et_s - 0.001) {
++      errors.push(`${caseId}: Sim time not monotonic at index ${i}`);
++      failed++;
++      return { passed, failed, errors, timeMapping: { mode: 'as_et', offset_s: 0, rms: Infinity }, deltas };
++    }
++    if (simCheckpoints[i].dist_ft < simCheckpoints[i - 1].dist_ft - 0.001) {
++      errors.push(`${caseId}: Sim distance not monotonic at index ${i}`);
++      failed++;
++      return { passed, failed, errors, timeMapping: { mode: 'as_et', offset_s: 0, rms: Infinity }, deltas };
++    }
++  }
++  
++  // Choose time mapping mode
++  const timeMapping = choosePdfTimeMapping(pdfCheckpoints, simCheckpoints);
++  
++  // Compare at each PDF checkpoint distance
++  for (const pdfCp of pdfCheckpoints) {
++    // Skip rollout/staged rows (they're special and use dual-time format)
++    if (pdfCp.label?.toLowerCase().includes('rollout')) continue;
++    if (pdfCp.label?.toLowerCase().includes('staged')) continue;
++    if (pdfCp.dist_ft === 0) continue;
++    
++    const sampled = sampleSimAtDistance(simCheckpoints, pdfCp.dist_ft);
++    if (!sampled) {
++      errors.push(`${caseId} @${pdfCp.dist_ft}ft: Cannot interpolate sim data`);
++      failed++;
++      continue;
++    }
++    
++    // Check for NaN
++    if (!isFinite(sampled.et_s) || !isFinite(sampled.mph)) {
++      errors.push(`${caseId} @${pdfCp.dist_ft}ft: Sim has NaN values`);
++      failed++;
++      continue;
++    }
++    
++    // Map PDF time to ET basis using chosen mode
++    let pdfET: number;
++    if (timeMapping.mode === 'as_et') {
++      // Use time_et_s if available, else time_abs_s
++      pdfET = pdfCp.time_et_s ?? pdfCp.time_abs_s ?? 0;
++    } else {
++      // abs_minus_offset mode: subtract rollout offset from absolute time
++      const pdfAbsTime = pdfCp.time_abs_s ?? pdfCp.time_et_s ?? 0;
++      pdfET = pdfAbsTime - timeMapping.offset_s;
++    }
++    
++    // Compare ET
++    const simET = sampled.et_s;
++    const etDelta = Math.abs(simET - pdfET);
++    const etTol = getETTolerance(pdfCp.dist_ft, model);
++    
++    // Track delta for diagnostics
++    const mphDelta = (pdfCp.mph !== null && pdfCp.mph !== undefined && pdfCp.mph > 0)
++      ? Math.abs(sampled.mph - pdfCp.mph)
++      : null;
++    deltas.push({ dist_ft: pdfCp.dist_ft, etDelta, mphDelta });
++    
++    if (etDelta > etTol) {
++      errors.push(
++        `${caseId} @${pdfCp.dist_ft}ft: ET delta=${etDelta.toFixed(3)}s (tol=${etTol}s) ` +
++        `PDF=${pdfET.toFixed(2)}s vs Sim=${simET.toFixed(2)}s`
++      );
++      failed++;
++    } else {
++      passed++;
++    }
++    
++    // Compare MPH (if PDF has it)
++    if (pdfCp.mph !== null && pdfCp.mph !== undefined && pdfCp.mph > 0) {
++      const mphTol = getMPHTolerance(pdfCp.dist_ft, model);
++      
++      if (mphDelta! > mphTol) {
++        errors.push(
++          `${caseId} @${pdfCp.dist_ft}ft: MPH delta=${mphDelta!.toFixed(1)}mph (tol=${mphTol}mph) ` +
++          `PDF=${pdfCp.mph.toFixed(1)}mph vs Sim=${sampled.mph.toFixed(1)}mph`
++        );
++        failed++;
++      } else {
++        passed++;
++      }
++    }
++  }
++  
++  return { passed, failed, errors, timeMapping, deltas };
++}
++
++/**
++ * Generate parity diagnostics report per model
++ */
++interface BucketStats {
++  bucket: string;
++  count: number;
++  meanAbsETDelta: number;
++  p95ETDelta: number;
++  meanAbsMPHDelta: number;
++  p95MPHDelta: number;
++}
++
++function generateParityDiagnostics(
++  model: ModelName,
++  results: Array<{ caseId: string; result: ComparisonResult }>
++): void {
++  console.log(`\n${'='.repeat(100)}`);
++  console.log(`${model} PARITY DIAGNOSTICS`);
++  console.log('='.repeat(100));
++  
++  // Collect all deltas across all cases
++  const allDeltas = results.flatMap(r => 
++    r.result.deltas.map(d => ({ caseId: r.caseId, ...d }))
++  );
++  
++  // Define distance buckets
++  const buckets = [
++    { name: '60-330ft', min: 60, max: 330 },
++    { name: '330-660ft', min: 330, max: 660 },
++    { name: '660-1000ft', min: 660, max: 1000 },
++    { name: '1000-finish', min: 1000, max: 100000 },
++  ];
++  
++  const bucketStats: BucketStats[] = [];
++  
++  for (const bucket of buckets) {
++    const deltasInBucket = allDeltas.filter(d => d.dist_ft >= bucket.min && d.dist_ft < bucket.max);
++    
++    if (deltasInBucket.length === 0) continue;
