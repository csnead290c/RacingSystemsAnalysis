++/**
++ * Find M.* usage patterns in code
++ * Matches: M.add, M.sub, M.mul, M.div, M.sqrt, M.pow, M.abs
++ */
++function findMDotUsage(code: string): { line: number; match: string }[] {
++  const lines = code.split('\n');
++  const matches: { line: number; match: string }[] = [];
++  
++  // Pattern: M. followed by a method name and (
++  const pattern = /\bM\.(add|sub|mul|div|sqrt|pow|abs)\s*\(/g;
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i];
++    let match;
++    while ((match = pattern.exec(line)) !== null) {
++      matches.push({ line: i + 1, match: match[0] });
++    }
++    pattern.lastIndex = 0; // Reset regex state
++  }
++  
++  return matches;
++}
++
++/**
++ * Find F.* usage patterns in code (per-op Float32 arithmetic)
++ * Matches: F.add, F.sub, F.mul, F.div, F.sqrt, F.pow, F.abs
++ */
++function findFDotUsage(code: string): { line: number; match: string }[] {
++  const lines = code.split('\n');
++  const matches: { line: number; match: string }[] = [];
++  
++  const pattern = /\bF\.(add|sub|mul|div|sqrt|pow|abs|clamp|neg|exp|log)\s*\(/g;
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i];
++    let match;
++    while ((match = pattern.exec(line)) !== null) {
++      matches.push({ line: i + 1, match: match[0] });
++    }
++    pattern.lastIndex = 0;
++  }
++  
++  return matches;
++}
++
++/**
++ * Find f32() usage patterns in code (per-op Float32 truncation)
++ * Matches: f32( as a function call
++ */
++function findF32Usage(code: string): { line: number; match: string }[] {
++  const lines = code.split('\n');
++  const matches: { line: number; match: string }[] = [];
++  
++  const pattern = /\bf32\s*\(/g;
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i];
++    let match;
++    while ((match = pattern.exec(line)) !== null) {
++      matches.push({ line: i + 1, match: match[0] });
++    }
++    pattern.lastIndex = 0;
++  }
++  
++  return matches;
++}
++
++/**
++ * Find f() usage patterns in code
++ * Matches: f( as a function call (not part of other identifiers)
++ */
++function findFCallUsage(code: string): { line: number; match: string }[] {
++  const lines = code.split('\n');
++  const matches: { line: number; match: string }[] = [];
++  
++  // Pattern: standalone f( not preceded by alphanumeric or underscore
++  // Excludes: vb6_sng, Math.fround, etc.
++  const pattern = /(?<![a-zA-Z0-9_])f\s*\(/g;
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i];
++    let match;
++    while ((match = pattern.exec(line)) !== null) {
++      // Additional check: not part of Math.fround or vb6_sng or similar
++      const before = line.substring(0, match.index);
++      if (before.endsWith('Math.') || before.endsWith('vb6_') || before.endsWith('_')) {
++        continue;
++      }
++      matches.push({ line: i + 1, match: match[0] });
++    }
++    pattern.lastIndex = 0; // Reset regex state
++  }
++  
++  return matches;
++}
