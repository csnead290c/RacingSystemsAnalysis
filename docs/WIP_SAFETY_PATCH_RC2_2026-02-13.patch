++    (Destination As Any, Source As Any, ByVal Length As Long)
++
++' Convert Single to hex string (0x........)
++Private Function SingleToHex(ByVal val As Single) As String
++    Dim lngBits As Long
++    CopyMemory lngBits, val, 4
++    SingleToHex = "0x" & Right$("00000000" & Hex$(lngBits), 8)
++End Function
