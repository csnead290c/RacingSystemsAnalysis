++const CASES = [
++  { id: 'QuarterProTest1', filename: 'QuarterProTest1.json', model: 'QuarterPro' as ModelName },
++  { id: 'QuarterJrTest1', filename: 'QuarterJrTest1.json', model: 'QuarterJr' as ModelName },
++  { id: 'BonnevilleProTest1', filename: 'BonnevilleProTest1.json', model: 'BonnevillePro' as ModelName },
