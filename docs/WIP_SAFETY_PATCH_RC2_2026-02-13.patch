++/**
++ * Effective Four-Link Resolver
++ *
++ * Pure helper that resolves a vehicle's "effective four-link" by checking
++ * (in priority order):
++ *   1. fourLinkInstall  — pinned asset from the library, with optional overrides
++ *   2. fourLinkManual   — manual entry (no asset link)
++ *   3. legacy fields    — (none currently on vehicle schema, placeholder)
++ *
++ * Returns a normalized object so consumers don't need to know the source.
++ *
++ * Design: pure function, no side-effects, no React dependency.
++ */
++
++import type {
++  FourLinkAsset,
++  FourLinkOverridePatch,
++} from '../library/fourLinkAssets';
++
++// ── Output types ────────────────────────────────────────────────────
++
++export type EffectiveFourLinkSource = 'install' | 'manual' | 'legacy' | 'none';
++
++export interface EffectiveFourLink {
++  source: EffectiveFourLinkSource;
++  instantCenterIn?: number;
++  antiSquatPct?: number;
++  pinionAngleDeg?: number;
++  /** Info about the installed asset (only when source === 'install') */
++  installed?: {
++    assetId: string;
++    pinnedRevision: number;
++    name: string;
++    kind: FourLinkAsset['kind'];
++  };
++  /** Whether override patch is actively applied */
++  overridesActive: boolean;
++}
++
++// ── Minimal vehicle shape we need ───────────────────────────────────
++
++export interface VehicleFourLinkFields {
++  fourLinkInstall?: {
++    fourLinkAssetId: string;
++    pinnedRevision: number;
++    overrides?: FourLinkOverridePatch;
++  };
++  fourLinkManual?: {
++    instantCenterIn?: number;
++    antiSquatPct?: number;
++    pinionAngleDeg?: number;
++    upperBarLengthIn?: number;
++    lowerBarLengthIn?: number;
++    upperBarAngleDeg?: number;
++    lowerBarAngleDeg?: number;
++  };
++  // No legacy four-link fields on the vehicle schema today
++}
++
++/** Function signature for looking up a four-link asset by ID. */
++export type GetFourLinkAssetFn = (id: string) => FourLinkAsset | undefined;
++
++// ── Resolver ────────────────────────────────────────────────────────
++
++/**
++ * Resolve the effective four-link configuration for a vehicle.
++ *
++ * Priority: fourLinkInstall > fourLinkManual > none.
++ */
++export interface ResolveFourLinkOptions {
++  /** When false, skip fourLinkInstall and fall through to manual (non-Pro path). Default: true */
++  allowInstall?: boolean;
++}
++
++export function resolveVehicleFourLink(
++  vehicle: VehicleFourLinkFields,
++  getAsset: GetFourLinkAssetFn,
++  options: ResolveFourLinkOptions = {},
++): EffectiveFourLink {
++  const { allowInstall = true } = options;
++
++  // ── 1. Installed asset ──────────────────────────────────────────
++  if (allowInstall && vehicle.fourLinkInstall) {
++    const { fourLinkAssetId, pinnedRevision, overrides } = vehicle.fourLinkInstall;
++    const asset = getAsset(fourLinkAssetId);
++
++    if (asset) {
++      const hasOverrides = overrides != null && Object.keys(overrides).length > 0;
++
++      // Extract base values from asset payload
++      let instantCenterIn: number | undefined;
++      let antiSquatPct: number | undefined;
++      let pinionAngleDeg: number | undefined;
++
++      if (asset.kind === 'sim') {
++        const s = asset.payload.fourLinkSimResultSummary;
++        instantCenterIn = s.instantCenterIn;
++        antiSquatPct = s.antiSquatPct;
++        pinionAngleDeg = s.pinionAngleDeg;
++      } else {
++        // manual or measured
++        instantCenterIn = asset.payload.instantCenterIn;
++        antiSquatPct = asset.payload.antiSquatPct;
++        pinionAngleDeg = asset.payload.pinionAngleDeg;
++      }
++
++      // Apply overrides
++      if (overrides) {
++        if (overrides.instantCenterIn != null) instantCenterIn = overrides.instantCenterIn;
++        if (overrides.antiSquatPct != null) antiSquatPct = overrides.antiSquatPct;
++        if (overrides.pinionAngleDeg != null) pinionAngleDeg = overrides.pinionAngleDeg;
++      }
