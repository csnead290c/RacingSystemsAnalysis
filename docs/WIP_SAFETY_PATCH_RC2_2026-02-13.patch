++#!/usr/bin/env python3
++"""
++Extract raw inputs from Classic PDF printouts (QuarterJr v3.2 + BonnevillePro)
++NO normalization - captures ALL raw field variations exactly as they appear
++"""
++import fitz
++import json
++import re
++from pathlib import Path
++from typing import Dict, List, Any, Optional
++
++# VB6 RECON FINDINGS:
++# - QUARTER.FRM: gc_TireDia, gc_Rollout (QuarterJr has both tire diameter AND rollout distance)
++# - Print.bas: prints "Tire Diameter - inches", "Rollout - inches" 
++# - Clutch vs Converter: optConverter/optClutch radio buttons determine drivetrain mode
++# - HP curve: txtEngineHP/txtEngineTQ arrays for dyno table (BonnevillePro)
++# - Tire rollout conversion: TireCirc = tsq * TireDia * PI / 12 (Module1.bas line 74)
++
++def find_section_boundaries(lines: List[str]) -> Dict[str, tuple]:
++    """Identify major section boundaries in the PDF to prevent cross-contamination"""
++    sections = {}
++    
++    # Major section headers that mark END of dyno data section
++    # These are sections that definitely don't contain HP curve data
++    end_of_dyno_patterns = [
++        r'Final\s+Drive\s+Data',
++        r'Tire\s+Data',
++        r'Aerodynamic\s+Data',
++        r'Body\s+Data',
++        r'Track\s+Data',
++        r'Vehicle\s+Data',
++    ]
++    
++    # Find Engine Dyno Data section
++    for i, line in enumerate(lines):
++        if re.search(r'Engine\s+Dyno\s+Data', line, re.IGNORECASE):
++            # Find end of dyno section (next major non-dyno section)
++            end_idx = len(lines)
++            for j in range(i + 1, len(lines)):
++                if any(re.search(p, lines[j], re.IGNORECASE) for p in end_of_dyno_patterns):
++                    end_idx = j
++                    break
++            sections['engine_dyno'] = (i, end_idx)
++            break
++    
++    # Find aerodynamics/body sections for frontal area
++    for i, line in enumerate(lines):
++        if re.search(r'Aerodynamic\s+Data|Body\s+Data', line, re.IGNORECASE):
++            # Extend to next major section
++            end_idx = len(lines)
++            for j in range(i + 1, len(lines)):
++                if re.search(r'(Final\s+Drive|Tire\s+Data|Track\s+Data|Vehicle\s+Data)', lines[j], re.IGNORECASE):
++                    end_idx = j
++                    break
++            if 'Aerodynamic' in line:
++                sections['aerodynamics'] = (i, end_idx)
++            else:
++                sections['body_data'] = (i, end_idx)
++    
++    return sections
++
++def validate_hpcurve(curve: List[Dict[str, float]], case_id: str) -> List[Dict[str, float]]:
++    """Validate and filter hpCurve to remove contamination"""
++    if not curve:
++        return curve
++    
++    filtered = []
++    rejected = []
++    
++    for i, point in enumerate(curve):
++        rpm, hp, tq = point['rpm'], point['hp'], point.get('tq')
++        
++        # Rule 1: RPM must be strictly increasing
++        if filtered and rpm <= filtered[-1]['rpm']:
++            rejected.append((point, 'non-monotonic RPM'))
++            continue
++        
++        # Rule 2: HP and TQ must be positive
++        if hp <= 0 or (tq is not None and tq <= 0):
++            rejected.append((point, 'non-positive power'))
++            continue
++        
++        # Rule 3: Detect junk tail - sudden >70% HP drop OR large RPM gap with HP drop
++        if filtered:
++            prev_hp = filtered[-1]['hp']
++            prev_rpm = filtered[-1]['rpm']
++            hp_drop_pct = (prev_hp - hp) / prev_hp if prev_hp > 0 else 0
++            rpm_gap = rpm - prev_rpm
++            
++            # Reject if >70% HP drop
++            if hp < prev_hp * 0.3:
++                rejected.append((point, 'sudden HP drop >70%'))
++                continue
++            
++            # Reject if large RPM gap (>1000) with significant HP drop (>50%)
++            if rpm_gap > 1000 and hp < prev_hp * 0.5:
++                rejected.append((point, f'large RPM gap ({rpm_gap}) with HP drop'))
++                continue
++        
++        # Rule 4: Detect repeating low-hp signature at high RPM
++        # If we have high-power points (>500 HP) and then see very low HP (<100) at very high RPM (>10000)
++        if filtered:
++            max_hp_so_far = max(p['hp'] for p in filtered)
++            if max_hp_so_far > 500 and rpm > 10000 and hp < 100:
++                rejected.append((point, 'low-hp tail at high RPM'))
++                continue
++            
++            # Also reject if we see very low HP (<2000) at very high RPM (>8500) after high-power curve
++            if max_hp_so_far > 5000 and rpm > 8500 and hp < 2000:
++                rejected.append((point, 'low-hp tail after high-power curve'))
++                continue
++        
++        # Rule 5: Detect impossible outliers (>10x jump in HP)
++        if filtered and hp > filtered[-1]['hp'] * 10:
++            rejected.append((point, 'impossible HP spike >10x'))
++            continue
++        
++        filtered.append(point)
++    
++    # Log rejections
++    if rejected:
++        print(f"    ⚠️  WARNING [{case_id}]: Filtered {len(rejected)} contaminated hpCurve points:")
++        for point, reason in rejected[:5]:  # Show first 5
++            print(f"       - RPM={point['rpm']}, HP={point['hp']}, TQ={point.get('tq')} ({reason})")
++        if len(rejected) > 5:
++            print(f"       ... and {len(rejected) - 5} more")
++    
++    return filtered
++
++def extract_raw_inputs_from_pdf(pdf_path: str, model: str) -> Dict[str, Any]:
++    """Extract ALL raw input fields from PDF - no normalization"""
++    doc = fitz.open(pdf_path)
++    text = ""
++    for page in doc:
++        text += page.get_text()
++    doc.close()
++    
++    lines = [l.strip() for l in text.split('\n') if l.strip()]
++    raw = {}
++    
++    # Identify section boundaries to prevent cross-contamination
++    sections = find_section_boundaries(lines)
++    
++    # Parse all numeric fields with their exact labels
++    i = 0
++    while i < len(lines):
++        line = lines[i]
++        
++        # Weight
++        if 'Weight - lbs' in line or 'Weight-lbs' in line:
++            if i+1 < len(lines):
++                raw['weightLb'] = parse_number(lines[i+1])
++        
++        # Peak HP (explicit)
++        elif 'Peak HP' in line and 'RPM' not in line:
++            if i+1 < len(lines):
++                raw['powerHP'] = parse_number(lines[i+1])
++        
++        # RPM @ Peak HP
++        elif 'RPM@ Peak HP' in line or 'RPM @ Peak HP' in line:
++            if i+1 < len(lines):
++                raw['peakHPRPM'] = parse_number(lines[i+1])
++        
++        # Tire Diameter
++        elif 'Tire Diameter - inches' in line:
++            if i+1 < len(lines):
++                raw['tireDiaIn'] = parse_number(lines[i+1])
++        
++        # Tire Rollout (different from rollout distance!)
++        elif 'Tire Rollout' in line and 'inches' in line:
++            if i+1 < len(lines):
++                raw['tireRolloutIn'] = parse_number(lines[i+1])
++        
++        # Tire Size (BonnevillePro alternative label)
++        elif 'Tire Size' in line and '-' in line and i+1 < len(lines):
++            # Could be "33.0 x 16.0" format
++            val = parse_number(lines[i+1])
++            if val and 'tireDiaIn' not in raw:
++                raw['tireDiaIn'] = val
++        
++        # Rollout distance (QuarterJr staging rollout in inches)
++        elif 'Rollout - inches' in line or ('Rollout' in line and 'inches' in line and 'Tire' not in line):
++            if i+1 < len(lines):
++                raw['rolloutIn'] = parse_number(lines[i+1])
++        
++        # Rear Gear (final drive)
++        elif 'Rear Gear' in line or 'Final Drive' in line:
++            if i+1 < len(lines):
++                raw['rearGear'] = parse_number(lines[i+1])
++        
++        # Torque Converter
++        elif 'Torque Converter' in line:
++            raw['drivetrainMode'] = 'torqueConverter'
++            if 'Stall RPM' in line or (i+1 < len(lines) and 'Stall' in lines[i+1]):
++                idx = i+1 if i+1 < len(lines) else i
++                raw['stallRpm'] = parse_number(lines[idx])
++        
++        # Centrifugal Clutch
++        elif 'Centrifugal Clutch' in line or 'Clutch' in line:
++            if 'Converter' not in line:
++                raw['drivetrainMode'] = 'centrifugalClutch'
++                if 'Slip RPM' in line or (i+1 < len(lines) and 'Slip' in lines[i+1]):
++                    idx = i+1 if i+1 < len(lines) else i
++                    raw['slipRpm'] = parse_number(lines[idx])
++        
++        # Stall RPM (standalone)
++        elif 'Stall RPM' in line and 'stallRpm' not in raw:
++            if i+1 < len(lines):
++                raw['stallRpm'] = parse_number(lines[i+1])
++                if 'drivetrainMode' not in raw:
++                    raw['drivetrainMode'] = 'torqueConverter'
++        
++        # Slip RPM (standalone)
++        elif 'Slip RPM' in line and 'slipRpm' not in raw:
++            if i+1 < len(lines):
++                raw['slipRpm'] = parse_number(lines[i+1])
++                if 'drivetrainMode' not in raw:
++                    raw['drivetrainMode'] = 'centrifugalClutch'
++        
++        # Shift RPM
++        elif 'Shift RPM' in line:
++            if i+1 < len(lines):
++                raw['shiftRpm'] = parse_number(lines[i+1])
++        
++        # Launch RPM
++        elif 'Launch RPM' in line or 'Starting RPM' in line:
++            if i+1 < len(lines):
++                raw['launchRpm'] = parse_number(lines[i+1])
++        
++        # Lock-up option
++        elif 'Lock-up option' in line or 'Lock-Up' in line:
++            if i+1 < len(lines):
++                raw['lockupOption'] = 'Yes' in lines[i+1] or 'Y' in lines[i+1]
++        
++        # Gear ratios
++        elif re.match(r'^(1st|2nd|3rd|4th|5th|6th) Gear', line):
++            if i+1 < len(lines):
++                if 'gearRatios' not in raw:
++                    raw['gearRatios'] = []
++                raw['gearRatios'].append(parse_number(lines[i+1]))
++        
++        # Environment
++        elif 'Elevation' in line or 'Altitude' in line:
++            if i+1 < len(lines):
++                raw['elevation'] = parse_number(lines[i+1])
++        elif 'Barometer' in line:
