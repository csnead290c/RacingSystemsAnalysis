++#!/usr/bin/env python3
++"""
++PDF to PNG Renderer
++Utility for converting legacy QuarterPro printouts to images for analysis.
++Local-only tool - generated images are not committed to git.
++
++Usage:
++    python3 scripts/render_pdf_to_png.py <input.pdf> <output_dir>
++    
++Example:
++    python3 scripts/render_pdf_to_png.py "Reference Files/RsaClassicTestResults/QuarterProTestResults/QuarterProTest1.pdf" "Reference Files/QuarterProPrintouts/Test1"
++"""
++
++import sys
++import os
++import fitz  # PyMuPDF
++
++def render_pdf_to_png(pdf_path, output_dir, dpi=150):
++    """
++    Render each page of a PDF to PNG images.
++    
++    Args:
++        pdf_path: Path to input PDF file
++        output_dir: Directory to save PNG images
++        dpi: Resolution for rendering (default 150)
++    """
++    # Create output directory if it doesn't exist
++    os.makedirs(output_dir, exist_ok=True)
++    
++    # Open PDF
++    doc = fitz.open(pdf_path)
++    
++    page_count = len(doc)
++    print(f"Rendering {page_count} page(s) from {pdf_path}")
++    
++    # Render each page
++    for page_num in range(page_count):
++        page = doc[page_num]
++        
++        # Calculate zoom factor for desired DPI
++        # PyMuPDF default is 72 DPI
++        zoom = dpi / 72
++        mat = fitz.Matrix(zoom, zoom)
++        
++        # Render page to pixmap
++        pix = page.get_pixmap(matrix=mat)
++        
++        # Save as PNG
++        output_path = os.path.join(output_dir, f"page-{page_num + 1}.png")
++        pix.save(output_path)
++        
++        print(f"  Page {page_num + 1} -> {output_path}")
++    
++    doc.close()
++    print(f"Done! Rendered {page_count} page(s)")
++
++if __name__ == "__main__":
++    if len(sys.argv) < 3:
++        print(__doc__)
++        sys.exit(1)
++    
++    pdf_path = sys.argv[1]
++    output_dir = sys.argv[2]
++    
++    if not os.path.exists(pdf_path):
++        print(f"Error: PDF file not found: {pdf_path}")
++        sys.exit(1)
++    
++    render_pdf_to_png(pdf_path, output_dir)
