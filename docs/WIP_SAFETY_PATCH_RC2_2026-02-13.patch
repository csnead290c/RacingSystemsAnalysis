++describe('QuarterPro v3.2 - Baseline Regression Test (STEP 4)', () => {
++  const configs: ConfigName[] = ['ProStock_Pro', 'FunnyCar_Pro', 'Motorcycle_Pro', 'SuperComp_Pro', 'SuperGas_Pro', 'TA_Dragster_Pro'];
++  const distances: RaceLength[] = ['EIGHTH', 'QUARTER'];
++  
++  it('Current metrics must not regress beyond baseline thresholds', () => {
++    const failures: string[] = [];
++    
++    console.log('\n' + '='.repeat(120));
++    console.log('BASELINE REGRESSION TEST');
++    console.log('='.repeat(120));
++    console.log(`Baseline date: ${QUARTERPRO_V32_BASELINE[0] ? '2026-01-23' : 'N/A'}`);
++    console.log(`Thresholds:`);
++    console.log(`  - Median drift tolerance: ±${REGRESSION_THRESHOLDS.median_abs_dt_ms_tolerance} ms`);
++    console.log(`  - Max drift tolerance: ±${REGRESSION_THRESHOLDS.max_abs_dt_ms_tolerance} ms`);
++    console.log(`  - Trap marker tolerance: ±${REGRESSION_THRESHOLDS.trap_dt_tolerance_percent}%`);
++    console.log('');
++    
++    for (const configName of configs) {
++      for (const raceLength of distances) {
++        const checkpoints = getCheckpointsForRaceLength(configName, raceLength);
++        if (checkpoints.length === 0) continue;
++        
++        const caseName = `${configName} ${raceLength}`;
++        const baseline = QUARTERPRO_V32_BASELINE.find(b => b.caseName === caseName);
++        
++        if (!baseline) {
++          failures.push(`${caseName}: No baseline found`);
++          continue;
++        }
++        
++        const checkpointCase = {
++          caseName,
++          configName,
++          raceLength,
++          rollout_ft: 1.0,
++          rollout_time_s: 0.0,
