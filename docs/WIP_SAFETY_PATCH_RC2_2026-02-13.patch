++            ))}
++          </select>
++        </div>
++
++        <div style={styles.countBar}>
++          {sorted.length === 0
++            ? (assets.length === 0 ? 'No four-link assets yet' : 'No matches')
++            : `${sorted.length} four-link asset${sorted.length !== 1 ? 's' : ''}`}
++        </div>
++
++        <div style={styles.list}>
++          {pageItems.length === 0 ? (
++            <div style={styles.empty}>
++              {assets.length === 0
++                ? 'No four-link assets yet. Create one from the Four-Link Sim (coming soon).'
++                : 'No four-link assets match your search.'}
++            </div>
++          ) : (
++            pageItems.map(asset => (
++              <button
++                key={asset.id}
++                style={styles.row}
++                onClick={() => onInstall(asset.id, asset.revision)}
++                onMouseEnter={e => { (e.currentTarget as HTMLButtonElement).style.backgroundColor = 'var(--color-surface-hover, rgba(255,255,255,0.05))'; }}
++                onMouseLeave={e => { (e.currentTarget as HTMLButtonElement).style.backgroundColor = 'transparent'; }}
++              >
++                <div style={styles.rowLeft}>
++                  <div style={styles.rowName}>{asset.name}</div>
++                  <div style={styles.rowMeta}>{getAssetSummary(asset)}</div>
++                </div>
++                <div style={styles.rowRight}>
++                  <span style={{
++                    ...styles.kindBadge,
++                    backgroundColor: `${KIND_COLORS[asset.kind]}20`,
