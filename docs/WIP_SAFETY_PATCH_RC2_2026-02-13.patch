++DistToPrint(2) = 30
++DistToPrint(3) = 60
++DistToPrint(4) = 330
++DistToPrint(5) = 594   ' Trap speed calc only, not printed unless post-shift
++DistToPrint(6) = 660
++DistToPrint(7) = 1000
++DistToPrint(8) = 1254  ' Trap speed calc only, not printed unless post-shift
