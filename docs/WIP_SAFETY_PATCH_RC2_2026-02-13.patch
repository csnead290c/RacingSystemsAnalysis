++/**
++ * Land Speed Timeslip Rendering Logic Test
++ *
++ * Validates that:
++ * - Bonneville mode uses mile-marker labels (not drag-racing labels)
++ * - No 0.0 mph placeholders appear (checkpoints without data are omitted)
++ * - Quarter-mile labels (60', 330', 1/8, 1/4, 1000') are NOT used for land speed
++ * - Finish time equals interpolated time at finish distance, not overshoot time
++ */
++import { describe, it, expect } from 'vitest';
++import { RACE_LENGTH_INFO } from '../../domain/config/raceLengths';
++
++/** Replicate the interpolation helper used in Predict.tsx */
++function interpolateTraceAtDist(
++  traces: Array<{ s_ft: number; t_s: number; v_mph: number }>,
++  targetDist_ft: number,
++): { time_s: number; mph: number } | null {
++  for (let i = 0; i < traces.length - 1; i++) {
++    const a = traces[i];
++    const b = traces[i + 1];
++    if (a.s_ft <= targetDist_ft && b.s_ft >= targetDist_ft) {
++      const span = b.s_ft - a.s_ft;
++      const frac = span > 0 ? (targetDist_ft - a.s_ft) / span : 0;
++      return {
++        time_s: a.t_s + frac * (b.t_s - a.t_s),
++        mph: a.v_mph + frac * (b.v_mph - a.v_mph),
++      };
++    }
++  }
++  return null;
++}
++
++/** Replicate the checkpoint-building logic used in Predict.tsx land speed branch */
++function interpolateLandSpeedCheckpoints(
++  traces: Array<{ s_ft: number; t_s: number; v_mph: number }>,
++  raceLength: string,
++) {
++  const milePts = [
++    { label: '1 mi',   dist_ft: 5280 },
++    { label: '2 mi',   dist_ft: 10560 },
++    { label: '2.5',    dist_ft: 13200 },
++    { label: '3 mi',   dist_ft: 15840 },
++    { label: '3.5',    dist_ft: 18480 },
++    { label: '4 mi',   dist_ft: 21120 },
++    { label: '4.5',    dist_ft: 23760 },
++    { label: '5 mi',   dist_ft: 26400 },
