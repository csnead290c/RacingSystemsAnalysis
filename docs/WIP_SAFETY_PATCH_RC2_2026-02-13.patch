++++ b/src/integration-tests/helpers/classic_checkpoint_compare.ts
+@@ -0,0 +1,216 @@
++/**
++ * Comparison engine for sim vs PDF checkpoints
++ * Handles correct time basis (ET clock) for QuarterJr and BonnevillePro
++ */
++
++import type { ClassicCheckpointRow, ClassicCaseModel, ClassicComparisonResult, ClassicComparisonRow } from './classic_types';
++
++interface SimTraceRow {
++  dist_ft: number;
++  time_s: number;
++  mph: number;
++  gear?: number | null;
++  rpm?: number | null;
++}
++
++/**
++ * Interpolate value at target distance
++ */
++function interpolateAtDistance(trace: SimTraceRow[], targetDist: number, field: 'time_s' | 'mph'): number {
++  if (trace.length === 0) {
++    throw new Error(`Cannot interpolate: empty trace`);
++  }
++  
++  // Find bracketing points
++  let before: SimTraceRow | null = null;
++  let after: SimTraceRow | null = null;
++  
++  for (let i = 0; i < trace.length; i++) {
++    if (trace[i].dist_ft <= targetDist) {
++      before = trace[i];
++    }
++    if (trace[i].dist_ft >= targetDist && !after) {
++      after = trace[i];
++      break;
++    }
++  }
++  
++  // Handle edge cases
++  if (!before && after) return after[field];
++  if (before && !after) return before[field];
++  if (!before && !after) {
++    throw new Error(`Cannot interpolate at ${targetDist}ft: no trace data`);
++  }
++  
++  // Interpolate
++  const dist_range = after!.dist_ft - before!.dist_ft;
++  if (dist_range === 0) return before![field];
++  
++  const frac = (targetDist - before!.dist_ft) / dist_range;
++  return before![field] + frac * (after![field] - before![field]);
++}
++
++/**
++ * Get nearest gear/rpm at distance
++ */
++function getNearestAtDistance(trace: SimTraceRow[], targetDist: number, field: 'gear' | 'rpm'): number | null {
++  if (trace.length === 0) return null;
++  
++  let nearest = trace[0];
++  let minDiff = Math.abs(trace[0].dist_ft - targetDist);
++  
++  for (const row of trace) {
++    const diff = Math.abs(row.dist_ft - targetDist);
++    if (diff < minDiff) {
++      minDiff = diff;
++      nearest = row;
++    }
++  }
++  
++  const value = nearest[field];
++  return value !== undefined && value !== null ? value : null;
++}
++
++/**
++ * Determine rollout offset for QuarterJr (ET clock alignment)
++ * Method: Find PDF rollout row, then find sim time at that distance
++ */
++function determineRolloutOffset(pdfRows: ClassicCheckpointRow[], simTrace: SimTraceRow[]): number {
++  // Find rollout row in PDF checkpoints
++  const rolloutRow = pdfRows.find(cp => 
++    cp.label?.toLowerCase().includes('rollout') || 
++    (cp.time_abs_s !== null && cp.time_et_s === 0 && cp.dist_ft < 10)
++  );
++  
++  if (rolloutRow && rolloutRow.dist_ft !== undefined) {
++    // Find sim time at rollout distance
++    try {
++      const simTimeAtRollout = interpolateAtDistance(simTrace, rolloutRow.dist_ft, 'time_s');
++      return simTimeAtRollout;
++    } catch (e) {
++      // Fallback: use first movement in trace
++      console.warn(`Could not interpolate rollout, using first trace point`);
++    }
++  }
++  
++  // Fallback: use first movement in trace (first point where dist > 0.5ft)
++  const firstMovement = simTrace.find(row => row.dist_ft > 0.5);
++  return firstMovement ? firstMovement.time_s : (simTrace.length > 0 ? simTrace[0].time_s : 0);
++}
++
++/**
++ * Compare classic case checkpoints against sim trace
++ */
++export function compareClassicCaseToPdfCheckpoints(args: {
++  caseId: string;
++  model: ClassicCaseModel;
++  pdfRows: ClassicCheckpointRow[];
++  simTrace: SimTraceRow[];
++  simRolloutAbsTime?: number;
++}): ClassicComparisonResult {
++  const { caseId, model, pdfRows, simTrace, simRolloutAbsTime } = args;
++  
++  // Determine rollout offset for ET clock
++  const rolloutOffset = model === 'QuarterJr' 
++    ? (simRolloutAbsTime ?? determineRolloutOffset(pdfRows, simTrace))
++    : (simTrace.length > 0 ? simTrace[0].time_s : 0);
++  
++  const perRow: ClassicComparisonRow[] = [];
++  const dt_values: number[] = [];
++  const d_mph_values: number[] = [];
++  const d_rpm_values: number[] = [];
++  
++  for (const pdfRow of pdfRows) {
++    try {
++      const simTimeAbs = interpolateAtDistance(simTrace, pdfRow.dist_ft, 'time_s');
++      const simMph = interpolateAtDistance(simTrace, pdfRow.dist_ft, 'mph');
++      const simGear = getNearestAtDistance(simTrace, pdfRow.dist_ft, 'gear');
++      const simRpm = getNearestAtDistance(simTrace, pdfRow.dist_ft, 'rpm');
++      
++      // Convert to ET clock
++      const simTimeEt = simTimeAbs - rolloutOffset;
++      
++      // Compute deltas
++      const dt_ms = (simTimeEt - pdfRow.time_et_s) * 1000;
++      const pdfMph = pdfRow.mph ?? 0;
++      const d_mph = simMph - pdfMph;
++      const pdfRpm = pdfRow.rpm ?? null;
++      const d_rpm = simRpm !== null && pdfRpm !== null ? simRpm - pdfRpm : null;
++      
++      perRow.push({
++        dist_ft: pdfRow.dist_ft,
++        pdf_time_et_s: pdfRow.time_et_s,
++        sim_time_et_s: simTimeEt,
++        dt_ms,
++        pdf_mph: pdfMph,
++        sim_mph: simMph,
++        d_mph,
++        pdf_rpm: pdfRow.rpm,
++        sim_rpm: simRpm,
++        d_rpm,
++        pdf_gear: pdfRow.gear,
++        sim_gear: simGear,
++        label: pdfRow.label,
++      });
++      
++      dt_values.push(dt_ms);
++      d_mph_values.push(d_mph);
++      if (d_rpm !== null) d_rpm_values.push(d_rpm);
++      
++    } catch (error) {
++      throw new Error(
++        `Failed to compare checkpoint at ${pdfRow.dist_ft}ft for ${caseId}: ${error}`
++      );
++    }
++  }
++  
++  // Compute stats
++  const abs_dt_values = dt_values.map(Math.abs).sort((a, b) => a - b);
++  const abs_d_mph_values = d_mph_values.map(Math.abs).sort((a, b) => a - b);
++  const abs_d_rpm_values = d_rpm_values.map(Math.abs).sort((a, b) => a - b);
++  
++  const median_dt_ms = abs_dt_values.length > 0 ? abs_dt_values[Math.floor(abs_dt_values.length / 2)] : 0;
++  const max_dt_ms = abs_dt_values.length > 0 ? abs_dt_values[abs_dt_values.length - 1] : 0;
++  
++  const median_d_mph = abs_d_mph_values.length > 0 ? abs_d_mph_values[Math.floor(abs_d_mph_values.length / 2)] : 0;
++  const max_d_mph = abs_d_mph_values.length > 0 ? abs_d_mph_values[abs_d_mph_values.length - 1] : 0;
++  
++  const median_d_rpm = abs_d_rpm_values.length > 0 ? abs_d_rpm_values[Math.floor(abs_d_rpm_values.length / 2)] : null;
++  const max_d_rpm = abs_d_rpm_values.length > 0 ? abs_d_rpm_values[abs_d_rpm_values.length - 1] : null;
++  
++  // Hard stop rules: fail if config mismatch
++  const thresholds = model === 'QuarterJr' 
++    ? { median_dt: 200, max_dt: 1000, median_mph: 5, max_mph: 15 }
++    : { median_dt: 2000, max_dt: 5000, median_mph: 10, max_mph: 20 };
++  
++  if (median_dt_ms > thresholds.median_dt || max_dt_ms > thresholds.max_dt || 
++      median_d_mph > thresholds.median_mph || max_d_mph > thresholds.max_mph) {
++    const worst5 = [...perRow].sort((a, b) => Math.abs(b.dt_ms) - Math.abs(a.dt_ms)).slice(0, 5);
++    
++    throw new Error(
++      `CONFIG_MISMATCH for ${caseId} (${model}):\n` +
++      `  median_dt_ms: ${median_dt_ms.toFixed(1)}ms (threshold: ${thresholds.median_dt}ms)\n` +
++      `  max_dt_ms: ${max_dt_ms.toFixed(1)}ms (threshold: ${thresholds.max_dt}ms)\n` +
++      `  median_d_mph: ${median_d_mph.toFixed(1)}mph (threshold: ${thresholds.median_mph}mph)\n` +
++      `  max_d_mph: ${max_d_mph.toFixed(1)}mph (threshold: ${thresholds.max_mph}mph)\n` +
++      `\nWorst 5 checkpoints by time drift:\n` +
++      worst5.map(c => 
++        `  ${c.dist_ft}ft: PDF_ET=${(c.pdf_time_et_s ?? 0).toFixed(3)}s, Sim_ET=${(c.sim_time_et_s ?? 0).toFixed(3)}s, dt=${c.dt_ms.toFixed(1)}ms, PDF_MPH=${(c.pdf_mph ?? 0).toFixed(1)}, Sim_MPH=${c.sim_mph.toFixed(1)}`
++      ).join('\n')
++    );
++  }
++  
++  return {
++    caseId,
++    model,
++    stats: {
++      median_dt_ms,
++      max_dt_ms,
++      median_d_mph,
++      max_d_mph,
++      median_d_rpm,
++      max_d_rpm,
++    },
++    perRow,
++  };
++}
+diff --git a/src/integration-tests/helpers/classic_input_normalize.ts b/src/integration-tests/helpers/classic_input_normalize.ts
+new file mode 100644
+index 00000000..bde64f9f
+--- /dev/null
++++ b/src/integration-tests/helpers/classic_input_normalize.ts
+@@ -0,0 +1,123 @@
++import type { ModelName, ClassicRawInputs, ClassicEffectiveInputs, ClassicCaseCheckpointRow } from './classic_types';
++
++export const PI_VB6 = 3.141593;
++
++export function normalizeClassicCase(
++  caseId: string,
++  model: ModelName,
++  raw: ClassicRawInputs,
++  checkpoints: ClassicCaseCheckpointRow[]
++): { effective: ClassicEffectiveInputs; warnings: string[] } {
++  const warnings: string[] = [];
++  const missing: string[] = [];
++
++  // VB6 IF BRANCH 1: Weight (required)
++  if (!raw.weightLb) {
++    missing.push('weightLb');
++  }
++
++  // VB6 IF BRANCH 2: Power (program-aware)
++  // QuarterJr: powerHP + peakHPRPM (no dyno table)
++  // QuarterPro/BonnevillePro: hpCurve from Torque Curve Data table
++  let powerHP_effective: number | undefined;
++  let engineCurve: Array<{ rpm: number; hp: number; tq?: number }> | undefined;
++  
++  if (raw.hpCurve && raw.hpCurve.length > 0) {
++    engineCurve = raw.hpCurve;
++    powerHP_effective = Math.max(...raw.hpCurve.map(p => p.hp));
++    warnings.push(`Power from HP curve: peak=${powerHP_effective}HP at ${raw.hpCurve.length} points`);
++  } else if (raw.powerHP) {
++    powerHP_effective = raw.powerHP;
++    if (model === 'QuarterJr') {
++      warnings.push('Power from powerHP field (QuarterJr peak HP mode)');
++    }
++  } else {
++    if (model === 'QuarterJr') {
++      missing.push('powerHP');
++    } else {
++      missing.push('hpCurve (QuarterPro/BonnevillePro require dyno table)');
++    }
++  }
++
++  // VB6 IF BRANCH 3: Tire diameter
++  let tireDiaIn_effective: number | undefined;
++  
++  if (raw.tireDiaIn) {
++    tireDiaIn_effective = raw.tireDiaIn;
++  } else if (raw.tireRolloutIn) {
++    tireDiaIn_effective = raw.tireRolloutIn / PI_VB6;
++    warnings.push(`Tire diameter from rollout: ${raw.tireRolloutIn}in rollout -> ${tireDiaIn_effective.toFixed(2)}in diameter`);
++  } else {
++    missing.push('tireDiaIn or tireRolloutIn');
++  }
++
++  // VB6 IF BRANCH 4: Rear gear (required)
++  if (!raw.rearGear) {
++    missing.push('rearGear');
++  }
++
++  // VB6 IF BRANCH 5: Rollout (program-aware)
++  // QuarterJr/QuarterPro: rolloutIn required (staging rollout)
++  // BonnevillePro: rolloutIn does NOT exist (no staging)
++  let rolloutIn_effective: number | null;
++  
++  if (model === 'QuarterJr' || model === 'QuarterPro') {
++    if (raw.rolloutIn) {
++      rolloutIn_effective = raw.rolloutIn;
++    } else {
++      const rolloutRow = checkpoints.find(cp => cp.label?.toLowerCase().includes('rollout'));
++      if (rolloutRow) {
++        rolloutIn_effective = rolloutRow.dist_ft * 12;
++        warnings.push(`Rollout from checkpoint: ${rolloutIn_effective.toFixed(1)}in at ${rolloutRow.dist_ft}ft`);
++      } else {
++        missing.push('rolloutIn (required for QuarterJr/QuarterPro)');
++        rolloutIn_effective = null;
++      }
++    }
++  } else {
++    // BonnevillePro: no rollout
++    rolloutIn_effective = null;
++    if (raw.rolloutIn) {
++      warnings.push(`Unexpected rolloutIn for BonnevillePro: ${raw.rolloutIn}in (ignoring)`);
++    }
++  }
++
++  // VB6 IF BRANCH 6: Finish distance
++  const finishDistFt_effective = checkpoints.length > 0 
++    ? checkpoints[checkpoints.length - 1].dist_ft 
++    : (model === 'BonnevillePro' ? 26400 : 1320);
++  
++  if (model === 'BonnevillePro' && finishDistFt_effective < 1000) {
++    warnings.push(`Suspiciously small finish distance for Bonneville: ${finishDistFt_effective}ft (expected ~26400ft for 5 miles)`);
++  }
++
++  // Check for fields VB6 might use but sim ignores
++  if (raw.shiftRpm) {
++    warnings.push('FIELD_POSSIBLY_USED_BY_VB6_BUT_IGNORED_BY_SIM: shiftRpm');
++  }
++  if (raw.transType) {
++    warnings.push('FIELD_POSSIBLY_USED_BY_VB6_BUT_IGNORED_BY_SIM: transType');
++  }
++
++  if (missing.length > 0) {
++    const error = new Error(`MISSING_FIELDS for ${caseId} (${model}): ${missing.join(', ')}`) as any;
++    error.code = 'MISSING_FIELDS';
++    error.fields = missing;
++    error.caseId = caseId;
++    error.model = model;
++    throw error;
++  }
++
++  return {
++    effective: {
++      weightLb: raw.weightLb!,
++      powerHP_effective: powerHP_effective!,
++      tireDiaIn_effective: tireDiaIn_effective!,
++      rearGear_effective: raw.rearGear!,
++      rolloutIn_effective,
++      engineCurve,
++      finishDistFt_effective,
++    },
++    warnings,
++  };
++}
