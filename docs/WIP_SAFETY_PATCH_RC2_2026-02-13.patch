++#!/usr/bin/env npx tsx
++/**
++ * Route Scanner — reads App.tsx and extracts the route inventory.
++ *
++ * Usage:
++ *   npx tsx src/dev/scripts/scanRoutes.ts          # prints markdown table
++ *   npx tsx src/dev/scripts/scanRoutes.ts --json    # prints JSON
++ *
++ * The output can be pasted into SITE_AUDIT.md § C (Route & Feature Inventory).
++ */
++
++import { readFileSync } from 'fs';
++import { resolve, dirname } from 'path';
++import { fileURLToPath } from 'url';
++
++// ── Parse App.tsx ────────────────────────────────────────────────────
++
++const __filename = fileURLToPath(import.meta.url);
++const __dirname = dirname(__filename);
++const APP_PATH = resolve(__dirname, '../../app/App.tsx');
++const src = readFileSync(APP_PATH, 'utf-8');
++
++interface RouteEntry {
++  path: string;
++  component: string;
++  gate: string;       // e.g. "ET_SIM_FEATURE", "clutch_sim", "login-only", "public"
++  gateType: 'feature-const' | 'feature-literal' | 'product' | 'role' | 'login-only' | 'public';
++  notes: string;
++}
++
++const routes: RouteEntry[] = [];
++
++// Match <Route path="..." element={...} />
++// We look for the path, the component inside <Component />, and any ProtectedRoute props.
++const routeRe = /<Route\s+path="([^"]+)"\s+element=\{[\s\S]*?\}\s*\/>/g;
++
++let m: RegExpExecArray | null;
++while ((m = routeRe.exec(src)) !== null) {
++  const path = m[1];
++  const block = m[0];
++
++  // Extract component name: <ComponentName /> or <ComponentName>
++  const compMatch = block.match(/<(?!Route|ProtectedRoute|Suspense|div)([A-Z]\w+)/);
++  const component = compMatch ? compMatch[1] : '?';
++
++  // Determine gate
++  let gate = 'public';
++  let gateType: RouteEntry['gateType'] = 'public';
++  let notes = '';
++
++  if (block.includes('<ProtectedRoute')) {
++    // Check for requireFeature={CONSTANT}
++    const featureConstMatch = block.match(/requireFeature=\{(\w+)\}/);
++    // Check for requireFeature="literal"
++    const featureLitMatch = block.match(/requireFeature="([^"]+)"/);
++    // Check for requireProduct="literal"
++    const productMatch = block.match(/requireProduct="([^"]+)"/);
++    // Check for requireRole
++    const roleMatch = block.match(/requireRole=\{([^}]+)\}/);
++
++    if (featureConstMatch) {
++      gate = featureConstMatch[1];
++      gateType = 'feature-const';
++    } else if (featureLitMatch) {
++      gate = `"${featureLitMatch[1]}"`;
++      gateType = 'feature-literal';
++      notes = 'string literal — consider centralizing';
++    } else if (productMatch) {
++      gate = `product:${productMatch[1]}`;
++      gateType = 'product';
++    } else if (roleMatch) {
++      gate = `role:${roleMatch[1].replace(/'/g, '').replace(/[\[\]\s]/g, '')}`;
++      gateType = 'role';
++    } else {
++      gate = 'login-only';
++      gateType = 'login-only';
++    }
++  }
++
++  routes.push({ path, component, gate, gateType, notes });
++}
++
++// ── Output ───────────────────────────────────────────────────────────
++
++if (process.argv.includes('--json')) {
++  console.log(JSON.stringify(routes, null, 2));
++} else {
++  // Markdown table
++  console.log('| Route | Component | Gate | Type | Notes |');
++  console.log('|-------|-----------|------|------|-------|');
++  for (const r of routes) {
++    console.log(`| \`${r.path}\` | ${r.component} | ${r.gate} | ${r.gateType} | ${r.notes} |`);
++  }
++  console.log(`\n_${routes.length} routes scanned from App.tsx_`);
++}
