++    expect(ax.tickCount).toBe(8);
++  });
++
++  // GUARDRAIL: VB6 CDETAILS.CLS lines 480-510 — when min<0, tickCount is decremented
++  // by 1, so step = (max-min)/tickCount can be non-45 (e.g., 52.5).
++  // This is intentional VB6 behavior. Do NOT "fix" this to force 45° steps.
++  it('non-45 step guardrail: min=-45 max=270 → tickCount=6, step=52.5 (VB6 parity)', () => {
++    // firstAngle slightly negative, lastAngle yields min=-45 max=270
++    const ax = flowDetailsXAxis(-12, 252);
++    expect(ax.min).toBe(-45);
++    expect(ax.max).toBe(270);
++    // (270-(-45))/45 = 7, min<0 → 7-1=6, not in 2-5 → stays 6
++    expect(ax.tickCount).toBe(6);
++    // step = (270-(-45))/6 = 52.5 — NOT 45
++    const step = (ax.max - ax.min) / ax.tickCount;
++    expect(step).toBe(52.5);
++    // Ticks should be at 52.5° intervals from -45
++    expect(ax.ticks[0]).toBe(-45);
++    expect(ax.ticks[ax.ticks.length - 1]).toBe(270);
++    expect(ax.ticks.length).toBe(ax.tickCount + 1); // 7 tick marks for 6 intervals
++  });
++
++  // Positive-only range: no tickCount decrement, step stays 45
++  it('positive range: min=0 max=180 → step=45 (no decrement)', () => {
++    const ax = flowDetailsXAxis(5, 175);
++    expect(ax.min).toBe(0);
++    expect(ax.max).toBe(180);
++    // (180-0)/45 = 4, in 2-5 → doubled to 8
++    expect(ax.tickCount).toBe(8);
++    const step = (ax.max - ax.min) / ax.tickCount;
++    expect(step).toBe(22.5); // doubled ticks → halved step
++  });
++});
