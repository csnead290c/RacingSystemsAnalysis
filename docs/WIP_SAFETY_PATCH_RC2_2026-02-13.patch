++            key={pid}
++            onClick={() => setSelectedPlan(pid)}
++            style={{
++              padding: '0.4rem 1rem',
++              border: selectedPlan === pid ? `2px solid ${PLAN_COLORS[pid]}` : '2px solid var(--color-border)',
++              borderRadius: 'var(--radius-sm)',
++              background: selectedPlan === pid ? PLAN_COLORS[pid] : 'transparent',
