++/**
++ * VB6 Trace Normalization
++ * 
++ * Handles multiple possible trace field names and converts to canonical format.
++ * Fails loudly if trace schema is unexpected (no silent zeros).
++ */
++
++export interface NormalizedTraceRow {
++  time_s: number;
++  dist_ft: number;
++  mph: number;
++  rpm: number;
++  gear: number;
++  accel_g: number;
++}
++
++/**
++ * Normalize a raw trace row to canonical format
++ * 
++ * Supports multiple possible field names:
++ * - time: time_s, time, t
++ * - distance: dist_ft, distance_ft, dist, distance, d
++ * - speed: mph, speedMph, vel_mph, vel_fps (convert fps->mph)
++ * - rpm: rpm, engineRpm, EngRPM
++ * - gear: gear, currentGear, Gear
++ * - accel: accel_g, accel, acceleration_g, AGS_g
++ * 
++ * @throws Error if required fields cannot be found or derived
++ */
++export function normalizeTraceRow(rawRow: any): NormalizedTraceRow {
++  // Time - try time_et_s first (classic sim runner format), then time_s, time, t
++  const time_s = rawRow.time_et_s ?? rawRow.time_s ?? rawRow.time ?? rawRow.t;
++  if (time_s === undefined) {
++    throw new Error(`Cannot find time field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  
++  // Distance - handle TimeslipRow format where rollout has null distance
++  // Use ?? to skip null values and find first non-null/non-undefined
++  let dist_ft = rawRow.s_ft ?? rawRow.d_ft;
++  if (dist_ft === undefined) {
++    // Try dist_ft field (might be null for rollout)
++    dist_ft = rawRow.dist_ft;
++  }
++  if (dist_ft === undefined) {
++    // Try other variations
++    dist_ft = rawRow.distance_ft ?? rawRow.distance ?? rawRow.dist ?? rawRow.d;
++  }
++  // Allow null for rollout rows, but not undefined
++  if (dist_ft === undefined) {
++    throw new Error(`Cannot find distance field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  // Convert null to 0 for rollout rows
++  if (dist_ft === null) {
++    dist_ft = 0;
++  }
++  
++  // Speed (mph) - try direct mph first, then convert from fps
++  let mph = rawRow.mph ?? rawRow.speedMph ?? rawRow.vel_mph;
++  if (mph === undefined) {
++    // Try to convert from fps
++    const vel_fps = rawRow.vel_fps ?? rawRow.velocity_fps ?? rawRow.Vel_ftps;
++    if (vel_fps !== undefined) {
++      mph = vel_fps * 0.681818; // fps to mph conversion
++    }
++  }
++  if (mph === undefined) {
++    throw new Error(`Cannot find or derive mph field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  
++  // RPM
++  const rpm = rawRow.rpm ?? rawRow.engineRpm ?? rawRow.EngRPM;
++  if (rpm === undefined) {
++    throw new Error(`Cannot find rpm field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  
++  // Gear
++  const gear = rawRow.gear ?? rawRow.currentGear ?? rawRow.Gear;
++  if (gear === undefined) {
++    throw new Error(`Cannot find gear field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  
++  // Acceleration - try accel first (classic sim runner format), then accel_g, acceleration_g, AGS_g
++  const accel_g = rawRow.accel ?? rawRow.accel_g ?? rawRow.acceleration_g ?? rawRow.AGS_g;
++  if (accel_g === undefined) {
++    throw new Error(`Cannot find accel field in trace row. Available keys: ${Object.keys(rawRow).join(', ')}`);
++  }
++  
++  return {
++    time_s,
++    dist_ft,
++    mph,
++    rpm,
++    gear,
++    accel_g,
++  };
++}
++
++/**
++ * Normalize an entire trace array
++ */
++export function normalizeTrace(rawTrace: any[]): NormalizedTraceRow[] {
++  return rawTrace.map((row, idx) => {
++    try {
++      return normalizeTraceRow(row);
++    } catch (err) {
++      throw new Error(`Failed to normalize trace row ${idx}: ${err}`);
++    }
++  });
++}
++
++/**
++ * Validate trace meets basic sanity checks
++ */
++export function validateTrace(trace: NormalizedTraceRow[]): void {
++  if (trace.length === 0) {
++    throw new Error('Trace is empty');
++  }
++  
++  const lastRow = trace[trace.length - 1];
++  
++  // Check final distance
++  if (lastRow.dist_ft < 1200) {
++    throw new Error(`Trace ends too early: ${lastRow.dist_ft.toFixed(1)}ft (expected >1200ft)`);
++  }
++  
++  // Check final speed
++  if (lastRow.mph < 50) {
++    throw new Error(`Final speed too low: ${lastRow.mph.toFixed(1)} mph (expected >50mph)`);
++  }
++  
++  // Check for negative mph (optional but useful)
++  for (let i = 0; i < trace.length; i++) {
++    if (trace[i].mph < 0) {
++      throw new Error(`Negative mph at row ${i}: ${trace[i].mph.toFixed(1)} mph`);
++    }
++  }
++  
++  // Check monotonic-ish distance (should always increase)
++  for (let i = 1; i < trace.length; i++) {
++    if (trace[i].dist_ft < trace[i - 1].dist_ft) {
++      // Debug: print context around the failure
++      console.log(`\n[MONOTONICITY FAILURE] Context around row ${i}:`);
++      const start = Math.max(0, i - 3);
++      const end = Math.min(trace.length, i + 3);
++      for (let j = start; j < end; j++) {
++        const row = trace[j];
++        const marker = j === i ? ' <<< DECREASED' : (j === i - 1 ? ' <<< PREVIOUS' : '');
++        console.log(`  Row ${j}: dist=${row.dist_ft.toFixed(1)}ft, time=${row.time_s?.toFixed(4) ?? 'N/A'}s, label=${(row as any).label ?? 'N/A'}, name=${(row as any).name ?? 'N/A'}${marker}`);
++      }
++      throw new Error(`Distance decreased at row ${i}: ${trace[i - 1].dist_ft.toFixed(1)}ft -> ${trace[i].dist_ft.toFixed(1)}ft`);
++    }
++  }
++}
++
++/**
++ * Print trace structure for debugging
++ */
++export function printTraceStructure(rawTrace: any[], label: string = 'Trace'): void {
++  if (rawTrace.length === 0) {
++    console.log(`${label}: EMPTY`);
++    return;
++  }
++  
++  console.log(`\n========== ${label} Structure ==========`);
++  console.log(`Length: ${rawTrace.length} rows`);
++  console.log(`\nAvailable fields: ${Object.keys(rawTrace[0]).join(', ')}`);
++  
++  console.log(`\nFirst row:`);
++  console.log(JSON.stringify(rawTrace[0], null, 2));
++  
++  if (rawTrace.length > 2) {
++    const midIdx = Math.floor(rawTrace.length / 2);
++    console.log(`\nMiddle row (${midIdx}):`);
++    console.log(JSON.stringify(rawTrace[midIdx], null, 2));
++  }
++  
++  console.log(`\nLast row:`);
++  console.log(JSON.stringify(rawTrace[rawTrace.length - 1], null, 2));
++  console.log('========================================\n');
++}
