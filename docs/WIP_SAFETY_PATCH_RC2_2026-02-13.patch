++/**
++ * Step Trace Writer for VB6 Parity Analysis
++ * 
++ * Captures the state at the exact point VB6 defines as "CONVERGED VELOCITY STEP"
++ * (TIMESLIP.FRM line 1278: "300 Rem** CONVERGED VELOCITY STEP")
++ * 
++ * This is AFTER the inertia transient convergence loop and BEFORE print/trigger checks.
++ */
++
++export interface StepTraceRow {
++  // Step identification
++  stepIndex: number;           // L in VB6
++  
++  // Time values
++  t_abs_s: number;             // time(L) - absolute time from launch
++  t_et_s: number;              // ET time (after rollout)
++  dt_s: number;                // TimeStep used for this step
++  
++  // Position/velocity
++  dist_abs_ft: number;         // Dist(L) - absolute distance from launch
++  dist_track_ft: number;       // Distance on track (after ovradj)
++  vel_fps: number;             // Vel(L) in ft/s
++  vel_mph: number;             // Vel(L) in mph
++  
++  // Acceleration
++  accel_g: number;             // AGS(L) in g's
++  jerk_gps: number;            // Jerk in g's per second
++  
++  // Drivetrain state
++  gear: number;                // Gear(L)
++  engine_rpm: number;          // EngRPM(L)
++  driveshaft_rpm: number;      // DSRPM
++  
++  // Power chain
++  HP_raw: number;              // HP from curve (before losses)
++  HP_after_clutch: number;     // HP after ClutchSlip applied
++  HP_after_losses: number;     // HP after TGEff, Efficiency, TireSlip, DragHP
++  TQ_lbft: number;             // Torque at engine
++  
++  // Clutch/Converter
++  clutchSlip: number;          // ClutchSlip value (1.0 = locked, <1 = slipping)
++  torqueMult: number;          // TorqueMult for converters
++  slipRatio: number;           // SlipRatio for converters
++  
++  // Forces
++  tireForce_lbf: number;       // Force at tire contact patch
++  dragForce_lbf: number;       // Aerodynamic + rolling drag
++  rollRes_lbf: number;         // Rolling resistance component
++  gradeForce_lbf: number;      // Grade force (usually 0 for drag racing)
++  netForce_lbf: number;        // Net accelerating force
++  
++  // Weight transfer
++  rearWeight_lbf: number;      // DynamicRWT
++  frontWeight_lbf: number;     // DynamicFWT
++  wheelBarWeight_lbf: number;  // WheelBarWT
++  
++  // Traction
++  tractionLimit_g: number;     // AMax
++  CRTF: number;                // Traction force coefficient
++  tireSlip: number;            // TireSlip factor
++  
++  // Flags
++  slip_flag: boolean;          // SLIP(L) - traction limited
++  shift_flag: number;          // ShiftFlag (0, 1, or 2)
++  
++  // Trigger state
++  triggerFired: string;        // Which trigger fired this step (if any)
++  
++  // Convergence
++  PQWT: number;                // Power/weight term
++  k_iterations: number;        // Number of convergence iterations
++}
