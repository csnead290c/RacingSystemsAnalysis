++/**
++ * diff_first_divergence.ts
++ * 
++ * Compares VB6 step trace CSV with TS step trace CSV and finds the first divergence.
++ * 
++ * Usage:
++ *   npx ts-node src/integration-tests/tools/diff_first_divergence.ts --case QuarterProTest1
++ *   npx ts-node src/integration-tests/tools/diff_first_divergence.ts --case QuarterJrTest1
++ * 
++ * Input files:
++ *   reports/step_traces/vb6/<case>.csv
++ *   reports/step_traces/ts/<case>.csv
++ * 
++ * Output:
++ *   First row where any field differs beyond tolerance, with VB6 block attribution.
++ */
++
++import * as fs from 'fs';
++import * as path from 'path';
++import { parseStepTraceCsv, StepTraceRow } from './step_trace_writer';
++
++// Field tolerances
++// "Input parity" fields use 1e-9 (should be identical)
++// Dynamic values use tight numeric tolerances
++const TOLERANCES: Record<string, number> = {
++  // Input parity fields (should match exactly)
++  stepIndex: 0,
++  gear: 0,
++  shift_flag: 0,
++  
++  // Time fields (very tight)
++  t_abs_s: 1e-6,
++  t_et_s: 1e-6,
++  dt_s: 1e-6,
++  
++  // Position/velocity (tight)
++  dist_abs_ft: 1e-4,
++  dist_track_ft: 1e-4,
++  vel_fps: 1e-4,
++  vel_mph: 1e-3,
++  
++  // Acceleration (tight)
++  accel_g: 1e-5,
++  jerk_gps: 1e-4,
++  
++  // RPM (integer-ish)
++  engine_rpm: 0.5,
++  driveshaft_rpm: 0.5,
++  
++  // Power chain
++  HP_raw: 0.01,
++  HP_after_clutch: 0.01,
++  HP_after_losses: 0.01,
++  TQ_lbft: 0.01,
++  
++  // Clutch/Converter
++  clutchSlip: 1e-5,
++  torqueMult: 1e-5,
++  slipRatio: 1e-5,
++  
++  // Forces
++  tireForce_lbf: 0.1,
++  dragForce_lbf: 0.01,
++  rollRes_lbf: 0.01,
++  gradeForce_lbf: 0.01,
++  netForce_lbf: 0.1,
++  
++  // Weight
++  rearWeight_lbf: 0.1,
++  frontWeight_lbf: 0.1,
++  wheelBarWeight_lbf: 0.1,
++  
++  // Traction
++  tractionLimit_g: 1e-5,
++  CRTF: 0.1,
++  tireSlip: 1e-5,
++  
++  // Flags
++  slip_flag: 0,
++  
++  // Convergence
++  PQWT: 0.01,
++  k_iterations: 0,
++};
++
++// VB6 block attribution for each field
++const VB6_BLOCKS: Record<string, string> = {
++  stepIndex: 'loop_control',
++  t_abs_s: 'convergence_loop',
++  t_et_s: 'convergence_loop',
++  dt_s: 'timestep_calc',
++  dist_abs_ft: 'distance_calc',
++  dist_track_ft: 'distance_calc',
++  vel_fps: 'velocity_calc',
++  vel_mph: 'velocity_calc',
++  accel_g: 'acceleration_clamp',
++  jerk_gps: 'jerk_calc',
++  gear: 'shift_logic',
++  engine_rpm: 'clutch_converter_calc',
++  driveshaft_rpm: 'clutch_converter_calc',
++  HP_raw: 'hp_curve_lookup',
++  HP_after_clutch: 'clutch_converter_calc',
++  HP_after_losses: 'hp_chain',
++  TQ_lbft: 'torque_calc',
++  clutchSlip: 'clutch_converter_calc',
++  torqueMult: 'converter_init',
++  slipRatio: 'clutch_converter_calc',
++  tireForce_lbf: 'force_calc',
++  dragForce_lbf: 'drag_calc',
++  rollRes_lbf: 'drag_calc',
++  gradeForce_lbf: 'drag_calc',
++  netForce_lbf: 'force_calc',
++  rearWeight_lbf: 'weight_transfer',
++  frontWeight_lbf: 'weight_transfer',
++  wheelBarWeight_lbf: 'weight_transfer',
++  tractionLimit_g: 'traction_calc',
++  CRTF: 'traction_calc',
++  tireSlip: 'traction_calc',
++  slip_flag: 'acceleration_clamp',
++  shift_flag: 'shift_logic',
++  triggerFired: 'trigger_logic',
++  PQWT: 'convergence_loop',
++  k_iterations: 'convergence_loop',
++};
++
++interface FieldDiff {
++  field: string;
++  vb6Value: number | string | boolean;
++  tsValue: number | string | boolean;
++  delta: number | string;
++  tolerance: number;
++  vb6Block: string;
++}
++
++interface DivergenceResult {
++  stepIndex: number;
++  diffs: FieldDiff[];
++}
++
++function compareRows(vb6Row: StepTraceRow, tsRow: StepTraceRow): FieldDiff[] {
++  const diffs: FieldDiff[] = [];
++  
++  const numericFields = [
++    'stepIndex', 't_abs_s', 't_et_s', 'dt_s', 'dist_abs_ft', 'dist_track_ft',
++    'vel_fps', 'vel_mph', 'accel_g', 'jerk_gps', 'gear', 'engine_rpm',
++    'driveshaft_rpm', 'HP_raw', 'HP_after_clutch', 'HP_after_losses', 'TQ_lbft',
++    'clutchSlip', 'torqueMult', 'slipRatio', 'tireForce_lbf', 'dragForce_lbf',
++    'rollRes_lbf', 'gradeForce_lbf', 'netForce_lbf', 'rearWeight_lbf',
++    'frontWeight_lbf', 'wheelBarWeight_lbf', 'tractionLimit_g', 'CRTF',
++    'tireSlip', 'shift_flag', 'PQWT', 'k_iterations',
++  ];
++  
++  for (const field of numericFields) {
++    const vb6Val = (vb6Row as any)[field] as number;
++    const tsVal = (tsRow as any)[field] as number;
++    const tolerance = TOLERANCES[field] ?? 1e-6;
++    const delta = Math.abs(vb6Val - tsVal);
++    
++    if (delta > tolerance) {
++      diffs.push({
++        field,
++        vb6Value: vb6Val,
++        tsValue: tsVal,
++        delta,
++        tolerance,
++        vb6Block: VB6_BLOCKS[field] ?? 'unknown',
++      });
++    }
++  }
++  
++  // Boolean field
++  if (vb6Row.slip_flag !== tsRow.slip_flag) {
++    diffs.push({
++      field: 'slip_flag',
++      vb6Value: vb6Row.slip_flag,
++      tsValue: tsRow.slip_flag,
++      delta: 'mismatch',
++      tolerance: 0,
++      vb6Block: VB6_BLOCKS.slip_flag,
++    });
++  }
++  
++  // String field
++  if (vb6Row.triggerFired !== tsRow.triggerFired) {
++    diffs.push({
++      field: 'triggerFired',
++      vb6Value: vb6Row.triggerFired,
++      tsValue: tsRow.triggerFired,
++      delta: 'mismatch',
++      tolerance: 0,
++      vb6Block: VB6_BLOCKS.triggerFired,
++    });
++  }
++  
++  return diffs;
++}
++
++function findFirstDivergence(vb6Rows: StepTraceRow[], tsRows: StepTraceRow[]): DivergenceResult | null {
++  const minLen = Math.min(vb6Rows.length, tsRows.length);
++  
++  for (let i = 0; i < minLen; i++) {
++    const diffs = compareRows(vb6Rows[i], tsRows[i]);
++    if (diffs.length > 0) {
++      return {
++        stepIndex: vb6Rows[i].stepIndex,
++        diffs,
++      };
++    }
++  }
++  
++  // Check for length mismatch
++  if (vb6Rows.length !== tsRows.length) {
++    return {
++      stepIndex: minLen,
++      diffs: [{
++        field: 'row_count',
++        vb6Value: vb6Rows.length,
++        tsValue: tsRows.length,
++        delta: Math.abs(vb6Rows.length - tsRows.length),
++        tolerance: 0,
++        vb6Block: 'loop_control',
++      }],
++    };
++  }
++  
++  return null;
++}
++
++function formatDivergenceReport(result: DivergenceResult, caseId: string): string {
++  const lines: string[] = [];
++  
++  lines.push(`\n${'='.repeat(80)}`);
++  lines.push(`FIRST DIVERGENCE REPORT: ${caseId}`);
++  lines.push(`${'='.repeat(80)}\n`);
++  
++  lines.push(`Step Index: ${result.stepIndex}`);
++  lines.push(`Number of divergent fields: ${result.diffs.length}\n`);
++  
++  lines.push('DIVERGENT FIELDS:');
++  lines.push('-'.repeat(80));
++  
++  for (const diff of result.diffs) {
++    lines.push(`  Field: ${diff.field}`);
++    lines.push(`    VB6 Block: ${diff.vb6Block}`);
++    lines.push(`    VB6 Value: ${diff.vb6Value}`);
++    lines.push(`    TS Value:  ${diff.tsValue}`);
++    lines.push(`    Delta:     ${diff.delta}`);
++    lines.push(`    Tolerance: ${diff.tolerance}`);
++    lines.push('');
++  }
++  
++  lines.push('-'.repeat(80));
++  lines.push('\nNEXT STEPS:');
++  lines.push('  1. Open VB6 TIMESLIP.FRM and locate the block(s) listed above');
++  lines.push('  2. Compare the exact formula/precedence/clamps in VB6 vs TS');
++  lines.push('  3. Port the VB6 logic exactly to TS');
++  lines.push('  4. Re-run this diff to verify the divergence moves later');
++  lines.push('  5. Document the fix in PARITY_REPORT.md with VB6 line references');
++  
++  return lines.join('\n');
++}
++
++async function main() {
++  const args = process.argv.slice(2);
++  const caseIndex = args.indexOf('--case');
++  
