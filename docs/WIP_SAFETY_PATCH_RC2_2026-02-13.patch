++/**
++ * JSON Semantics Proof Utility
++ * 
++ * CRITICAL: Proves what JSON checkpoint fields represent (absolute vs ET/track coordinates)
++ * DO NOT ASSUME - prove using actual JSON data and physics
++ */
++
++export interface JsonSemanticsProof {
++  caseId: string;
++  rolloutIn: number;
++  rolloutFt: number;
++  
++  // Sample checkpoints
++  stagedRow: any | null;
++  rolloutRow: any | null;
++  firstNumericRow: any | null;
++  
++  // Conclusions
++  timeSemantics: 'ABSOLUTE' | 'ET_POST_ROLLOUT' | 'AMBIGUOUS';
++  distanceSemantics: 'ABSOLUTE' | 'TRACK_POST_ROLLOUT' | 'AMBIGUOUS';
++  
++  // Evidence
++  timeEvidence: string;
++  distanceEvidence: string;
++}
++
++/**
++ * Prove JSON checkpoint semantics using physics reasoning
++ */
++export function proveJsonSemantics(
++  caseId: string,
++  rolloutIn: number,
++  jsonCheckpoints: any[]
++): JsonSemanticsProof {
++  
++  const rolloutFt = rolloutIn / 12;
++  
++  // Find key rows
++  const stagedRow = jsonCheckpoints.find(cp => cp.distance_ft === 0);
++  const rolloutRow = jsonCheckpoints.find(cp => cp.distance_ft === null || cp.label?.includes('Rollout'));
++  const firstNumericRow = jsonCheckpoints.find(cp => cp.distance_ft && cp.distance_ft > 0);
++  
++  let timeSemantics: 'ABSOLUTE' | 'ET_POST_ROLLOUT' | 'AMBIGUOUS' = 'AMBIGUOUS';
++  let distanceSemantics: 'ABSOLUTE' | 'TRACK_POST_ROLLOUT' | 'AMBIGUOUS' = 'AMBIGUOUS';
++  let timeEvidence = '';
++  let distanceEvidence = '';
++  
++  // Distance semantics: Check if numeric distances are track or absolute
++  if (firstNumericRow) {
++    const dist = firstNumericRow.distance_ft;
++    
++    // If first numeric distance is small (e.g., 21ft), it's likely track distance
++    // because absolute would start near rolloutFt (e.g., 8.5ft for 102.5" rollout)
++    if (dist > rolloutFt + 5) {
++      distanceSemantics = 'TRACK_POST_ROLLOUT';
++      distanceEvidence = `First numeric checkpoint is ${dist}ft, which is >> rolloutFt (${rolloutFt.toFixed(1)}ft). ` +
++                        `This indicates TRACK distance (measured from rollout).`;
++    } else if (dist < rolloutFt + 2) {
++      distanceSemantics = 'ABSOLUTE';
++      distanceEvidence = `First numeric checkpoint is ${dist}ft, which is near rolloutFt (${rolloutFt.toFixed(1)}ft). ` +
++                        `This indicates ABSOLUTE distance (from launch).`;
++    } else {
++      distanceEvidence = `First numeric checkpoint is ${dist}ft. Ambiguous relative to rolloutFt (${rolloutFt.toFixed(1)}ft).`;
++    }
++  }
++  
++  // Time semantics: Use physics reasoning
++  // If we have rollout row with time info and first numeric row with time
++  if (rolloutRow && firstNumericRow && firstNumericRow.time_s != null) {
++    const firstTime = firstNumericRow.time_s;
++    const firstDist = firstNumericRow.distance_ft;
++    
++    // Estimate: If time at 21ft is ~0.5s, that's ET (rollout ~0.13s + 21ft ~0.37s = ~0.5s ET)
++    // If time at 21ft is ~0.63s, that's absolute (0.13s rollout + 0.5s to 21ft)
++    
++    // Heuristic: For typical drag racing, 21ft takes ~0.4-0.6s from rollout
++    // So if time_s at 21ft is 0.4-0.6s, it's likely ET
++    // If time_s at 21ft is 0.6-0.8s, it's likely absolute
++    
++    if (firstDist === 21 || firstDist === 30) {
++      if (firstTime < 0.7) {
++        timeSemantics = 'ET_POST_ROLLOUT';
++        timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(2)}s. ` +
++                      `For typical drag racing, this is consistent with ET (post-rollout). ` +
++                      `Absolute time would be ~${(firstTime + 0.13).toFixed(2)}s.`;
++      } else {
++        timeSemantics = 'ABSOLUTE';
++        timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(2)}s. ` +
++                      `This is consistent with ABSOLUTE time (includes rollout ~0.13s).`;
++      }
++    } else {
++      timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(2)}s. Need more analysis for this distance.`;
++    }
++  } else if (firstNumericRow && firstNumericRow.time_s != null) {
++    // No rollout row, but we have first numeric
++    const firstTime = firstNumericRow.time_s;
++    const firstDist = firstNumericRow.distance_ft;
++    
++    // If time starts near 0 at first checkpoint, it's likely ET
++    if (firstTime < 0.1) {
++      timeSemantics = 'ET_POST_ROLLOUT';
++      timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(3)}s ≈ 0. ` +
++                    `This indicates ET (timer starts at rollout).`;
++    } else if (firstTime > 0.5) {
++      timeSemantics = 'ABSOLUTE';
++      timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(2)}s > 0.5s. ` +
++                    `This indicates ABSOLUTE time (from launch).`;
++    } else {
++      timeEvidence = `Time at ${firstDist}ft is ${firstTime.toFixed(2)}s. Ambiguous.`;
++    }
++  }
++  
++  return {
++    caseId,
++    rolloutIn,
++    rolloutFt,
++    stagedRow,
++    rolloutRow,
++    firstNumericRow,
++    timeSemantics,
++    distanceSemantics,
++    timeEvidence,
++    distanceEvidence,
++  };
++}
++
++/**
++ * Print JSON semantics proof to console
++ */
++export function printJsonSemantics(proof: JsonSemanticsProof): void {
++  console.log('\n========================================');
++  console.log('JSON SEMANTICS PROOF');
++  console.log('========================================');
++  console.log(`Case: ${proof.caseId}`);
++  console.log(`Rollout: ${proof.rolloutIn}" = ${proof.rolloutFt.toFixed(3)}ft`);
++  console.log('');
++  
++  console.log('SAMPLE JSON CHECKPOINTS:');
++  
++  if (proof.stagedRow) {
++    console.log(`Staged (0ft): time=${proof.stagedRow.time_s}s, mph=${proof.stagedRow.mph}, rpm=${proof.stagedRow.rpm}`);
++  }
++  
++  if (proof.rolloutRow) {
++    console.log(`Rollout: time=${proof.rolloutRow.time_s}, mph=${proof.rolloutRow.mph}, rpm=${proof.rolloutRow.rpm}`);
++  }
++  
++  if (proof.firstNumericRow) {
