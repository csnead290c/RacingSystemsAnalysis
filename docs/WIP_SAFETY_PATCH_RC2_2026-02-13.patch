++/**
++ * Audit Drift Prevention
++ *
++ * Ensures the SITE_AUDIT.md document stays in sync with the actual codebase.
++ *
++ * Fails if:
++ *   1. src/dev/SITE_AUDIT.md is missing
++ *   2. The "Total: N routes" count in SITE_AUDIT.md doesn't match the
++ *      number of <Route> entries currently in App.tsx
++ *
++ * Fix:
++ *   npx tsx src/dev/scripts/scanRoutes.ts
++ *   Then paste/update the route table in SITE_AUDIT.md.
++ */
++
++import { describe, it, expect } from 'vitest';
++import { readFileSync, existsSync } from 'fs';
++import { resolve } from 'path';
++
++const ROOT = resolve(__dirname, '../../..');
++const AUDIT_PATH = resolve(ROOT, 'src/dev/SITE_AUDIT.md');
++const APP_PATH = resolve(ROOT, 'src/app/App.tsx');
++
++// ── Helpers ──────────────────────────────────────────────────────────
++
++/** Count <Route path="..."> entries in App.tsx (same regex as scanRoutes.ts). */
++function countAppRoutes(): number {
++  const src = readFileSync(APP_PATH, 'utf-8');
++  const routeRe = /<Route\s+path="([^"]+)"\s+element=\{[\s\S]*?\}\s*\/>/g;
++  let count = 0;
++  while (routeRe.exec(src) !== null) count++;
++  return count;
++}
++
++/** Extract the "Total: N routes" number from SITE_AUDIT.md. */
++function extractAuditRouteCount(): number | null {
++  const md = readFileSync(AUDIT_PATH, 'utf-8');
++  const m = md.match(/\*\*Total:\s*(\d+)\s*routes\*\*/);
++  return m ? parseInt(m[1], 10) : null;
++}
++
++// ── Tests ────────────────────────────────────────────────────────────
++
++describe('Audit drift prevention', () => {
++  it('src/dev/SITE_AUDIT.md exists', () => {
++    expect(
++      existsSync(AUDIT_PATH),
++      'SITE_AUDIT.md is missing! Create it or restore it from version control.',
++    ).toBe(true);
++  });
++
++  it('route count in SITE_AUDIT.md matches App.tsx', () => {
++    if (!existsSync(AUDIT_PATH)) {
++      expect.fail('Cannot check route count — SITE_AUDIT.md is missing.');
++    }
++
++    const auditCount = extractAuditRouteCount();
++    expect(
++      auditCount,
++      'Could not find "**Total: N routes**" in SITE_AUDIT.md. ' +
++      'Ensure the route inventory section contains this line.',
++    ).not.toBeNull();
++
++    const appCount = countAppRoutes();
++    expect(
++      appCount,
++      `SITE_AUDIT.md says ${auditCount} routes but App.tsx has ${appCount}. ` +
++      'Run:\n  npx tsx src/dev/scripts/scanRoutes.ts\n' +
++      'and update the route table in src/dev/SITE_AUDIT.md.',
++    ).toBe(auditCount);
++  });
++});
