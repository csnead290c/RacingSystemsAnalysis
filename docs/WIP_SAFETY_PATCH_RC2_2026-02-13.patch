++// ============================================================================
++// Summary comparison
++// ============================================================================
++
++export interface SummaryComparison {
++  field: string;
++  vb6: number;
++  ts: number;
++  delta: number;
++  tolerance: number;
++  pass: boolean;
++}
++
++export function compareSummary(
++  vb6Summary: { et_s: number; mph: number },
++  tsResult: { et_s: number; mph: number },
++  etTolerance: FieldTolerance = { abs: 0.30, rel: 0.02 },
++  mphTolerance: FieldTolerance = { abs: 3.0, rel: 0.02 },
++): SummaryComparison[] {
++  const results: SummaryComparison[] = [];
++
++  const etCheck = withinTolerance(tsResult.et_s, vb6Summary.et_s, etTolerance);
++  results.push({
++    field: 'ET (s)',
++    vb6: vb6Summary.et_s,
++    ts: tsResult.et_s,
++    delta: tsResult.et_s - vb6Summary.et_s,
++    tolerance: etCheck.tolerance,
++    pass: etCheck.pass,
++  });
++
++  const mphCheck = withinTolerance(tsResult.mph, vb6Summary.mph, mphTolerance);
++  results.push({
++    field: 'MPH',
++    vb6: vb6Summary.mph,
++    ts: tsResult.mph,
++    delta: tsResult.mph - vb6Summary.mph,
++    tolerance: mphCheck.tolerance,
++    pass: mphCheck.pass,
++  });
++
++  return results;
++}
