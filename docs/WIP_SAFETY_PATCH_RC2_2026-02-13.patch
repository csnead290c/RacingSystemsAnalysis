++/**
++ * Canonical TABY Implementation Guard
++ * 
++ * This test ensures that the TABY/BISC implementation structure is correct:
++ * - dtaby.ts is the canonical 0-indexed implementation
++ * - vb6Interpolation.ts is a thin 1-indexed adapter (calls dtaby.ts)
++ * - No other production files contain standalone TABY implementations
++ * 
++ * ADAPTER STRUCTURAL RULES (enforced at runtime via function.toString()):
++ * - Adapter function bodies must NOT contain algorithm tokens (KBOTM, KTOP, etc.)
++ * - Adapter function bodies must NOT contain loops (for/while)
++ * - Adapter function bodies must call dtaby.taby or dtaby.dtaby (or aliases)
++ * - Adapter function bodies must be short (≤10 statements)
++ * 
++ * This test validates structural invariants by inspecting function source code.
++ * Comments in function bodies are stripped before scanning to avoid false positives.
++ */
++
++import { describe, it, expect } from 'vitest';
++
++// Import the modules to verify their structure
++import * as dtaby from '../dtaby';
++import * as vb6Interpolation from '../../engine/vb6Interpolation';
++
++/**
++ * Strip comments from source code to avoid false positives.
++ * Removes // line comments and /* block comments *\/
++ */
++function stripComments(source: string): string {
++  // Remove block comments
++  let result = source.replace(/\/\*[\s\S]*?\*\//g, '');
++  // Remove line comments
++  result = result.replace(/\/\/.*$/gm, '');
++  return result;
++}
++
++/**
++ * Check if a function body contains algorithm tokens that indicate
++ * a standalone implementation rather than an adapter.
++ */
++function containsAlgorithmTokens(fnSource: string): string[] {
++  const stripped = stripComments(fnSource);
++  const found: string[] = [];
++  
++  // Algorithm tokens that indicate standalone implementation
++  const tokens = [
++    { pattern: /\bKBOTM\b/, name: 'KBOTM' },
++    { pattern: /\bKTOP\b/, name: 'KTOP' },
++    { pattern: /\bKMID\b/, name: 'KMID' },
++    { pattern: /\bJJ\b/, name: 'JJ' },
++    { pattern: /\bYVAL\b/, name: 'YVAL' },
++    { pattern: /\bP\s*[+]?=/, name: 'P assignment' },
++    { pattern: /\bfor\s*\(/, name: 'for loop' },
++    { pattern: /\bwhile\s*\(/, name: 'while loop' },
++  ];
++  
++  for (const { pattern, name } of tokens) {
++    if (pattern.test(stripped)) {
++      found.push(name);
++    }
++  }
++  
++  return found;
++}
++
++/**
++ * Check if a function body delegates to the canonical implementation.
++ * Returns true if it calls taby0, dtaby0, taby, or dtaby.
++ */
++function delegatesToCanonical(fnSource: string): boolean {
++  const stripped = stripComments(fnSource);
++  // Check for calls to canonical functions (with various import aliases)
++  return /\b(taby0|dtaby0|taby|dtaby)\s*\(/.test(stripped);
++}
++
