++import { writeFileSync } from 'fs';
++import { simulateVB6Exact } from '../../domain/physics/models/vb6Exact';
++import { jsonToClassicRawInputs } from '../helpers/json_to_classic_raw';
++import { normalizeClassicCase } from '../helpers/classic_input_normalize';
