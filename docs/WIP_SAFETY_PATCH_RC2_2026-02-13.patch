++/**
++ * BonnevillePro - Golden Summary Tests
++ * Strict string equality tests for summary ET/MPH
++ */
++
++import { describe, it } from 'vitest';
++import { BONNEVILLEPRO_CHECKPOINTS_EXTRACTED } from './fixtures/bonnevillepro_checkpoints_extracted';
++import { runClassicCase } from './helpers/run_classic_case';
++
++describe('BonnevillePro - Golden Summary Tests', () => {
++  it('PDF vs Sim summary comparison', async () => {
++    console.log('\n' + '='.repeat(80));
++    console.log('BONNEVILLEPRO - GOLDEN SUMMARY TESTS');
++    console.log('='.repeat(80));
++    console.log('');
++    
++    let passCount = 0;
++    let failCount = 0;
++    
++    const caseIds = BONNEVILLEPRO_CHECKPOINTS_EXTRACTED.map(c => c.caseId).sort();
++    
++    for (const caseId of caseIds) {
++      const checkpointData = BONNEVILLEPRO_CHECKPOINTS_EXTRACTED.find(c => c.caseId === caseId);
