++];
++
++function sortClutches(items: ClutchAsset[], key: string): ClutchAsset[] {
++  const sorted = [...items];
++  switch (key) {
++    case 'updated': return sorted.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
++    case 'name': return sorted.sort((a, b) => a.name.localeCompare(b.name));
++    case 'slip': return sorted.sort((a, b) => getSlipRPM(b) - getSlipRPM(a));
