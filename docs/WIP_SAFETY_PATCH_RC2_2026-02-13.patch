++#!/usr/bin/env npx ts-node
++/**
++ * diff_first_divergence_from_fixture.ts
++ * 
++ * Compares TS simulation output to fixture rows using VB6 print schedule
++ * encoded by fixture row order (index-based alignment), NOT by distance matching.
++ * 
++ * This is the correct way to compare: expectedRows[i] vs actualRows[i]
++ * 
++ * Usage:
++ *   npx ts-node src/integration-tests/tools/diff_first_divergence_from_fixture.ts --case QuarterProTest1
++ *   npx ts-node src/integration-tests/tools/diff_first_divergence_from_fixture.ts --case QuarterJrTest1
++ * 
++ * Output:
++ *   First row index where any field differs beyond tolerance, with per-field deltas.
++ */
++
++
++// Field tolerances for comparison
++const TOLERANCES: Record<string, number> = {
++  time_s: 0.02,      // 20ms tolerance for time
++  distance_ft: 2,    // 2ft tolerance for distance
++  mph: 1.0,          // 1 mph tolerance
++  accel_g: 0.1,      // 0.1g tolerance
++  rpm: 50,           // 50 rpm tolerance
++  gear: 0,           // Exact match for gear
++};
++
++interface FixtureRow {
++  label?: string;
++  time_s?: number;
++  time_abs_s?: number;
++  time_et_s?: number;
++  distance_ft?: number;
++  distance?: string | number;
++  mph: number;
++  accel?: number;
++  accel_g?: number;
++  gear: number;
++  rpm: number;
++}
++
++interface ActualRow {
++  label: string;
++  time_s: number | null;
++  distance_ft: number | null;
++  mph: number | null;
++  accel_g: number | null;
++  gear: number | null;
++  rpm: number | null;
++  event_type?: string;
++  event_value?: number;
++  seq?: number;
++}
++
++interface FieldDelta {
++  field: string;
++  expected: number | string | null;
++  actual: number | string | null;
++  delta: number | null;
++  tolerance: number;
++  exceeds: boolean;
++}
++
++interface DivergenceReport {
++  caseId: string;
++  firstDivergentIndex: number | null;
++  totalExpectedRows: number;
++  totalActualRows: number;
++  lengthMatch: boolean;
++  divergence: {
++    index: number;
++    expectedRow: FixtureRow;
++    actualRow: ActualRow;
++    fieldDeltas: FieldDelta[];
++    eventTypeMismatch: boolean;
++  } | null;
++  summary: string;
++}
++
++/**
++ * Normalize fixture row to common format
++ */
++function normalizeFixtureRow(row: FixtureRow): { time_s: number; distance_ft: number; mph: number; accel_g: number; gear: number; rpm: number; label: string } {
++  // Handle different time field names
++  const time_s = row.time_s ?? row.time_et_s ?? 0;
++  
++  // Handle different distance field names
++  let distance_ft = 0;
++  if (typeof row.distance_ft === 'number') {
++    distance_ft = row.distance_ft;
++  } else if (typeof row.distance === 'number') {
++    distance_ft = row.distance;
++  } else if (row.distance === 'Rollout') {
++    distance_ft = 0;
++  }
++  
++  // Handle different accel field names
++  const accel_g = row.accel_g ?? row.accel ?? 0;
++  
++  // Generate label
++  let label = row.label ?? `${distance_ft}ft`;
++  if (row.distance === 'Rollout' || row.label === 'Rollout') {
++    label = 'Rollout';
++  }
