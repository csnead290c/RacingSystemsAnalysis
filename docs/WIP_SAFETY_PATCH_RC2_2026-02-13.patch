++// Auth events
++const AUDIT_AUTH_LOGIN              = 'auth.login';
++const AUDIT_AUTH_REGISTER           = 'auth.register';
++const AUDIT_AUTH_CLERK_SYNC         = 'auth.clerk_sync';
