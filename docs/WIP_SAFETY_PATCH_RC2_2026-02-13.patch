++/**
++ * Compare two rows and return field deltas
++ */
++function compareRows(expected: ReturnType<typeof normalizeFixtureRow>, actual: ActualRow): FieldDelta[] {
++  const deltas: FieldDelta[] = [];
++  
++  const fields: Array<{ name: string; exp: number | null; act: number | null }> = [
++    { name: 'time_s', exp: expected.time_s, act: actual.time_s },
++    { name: 'distance_ft', exp: expected.distance_ft, act: actual.distance_ft },
++    { name: 'mph', exp: expected.mph, act: actual.mph },
++    { name: 'accel_g', exp: expected.accel_g, act: actual.accel_g },
++    { name: 'gear', exp: expected.gear, act: actual.gear },
++    { name: 'rpm', exp: expected.rpm, act: actual.rpm },
++  ];
++  
++  for (const { name, exp, act } of fields) {
++    const tolerance = TOLERANCES[name] ?? 0;
++    let delta: number | null = null;
++    let exceeds = false;
++    
++    if (exp !== null && act !== null) {
++      delta = act - exp;
++      exceeds = Math.abs(delta) > tolerance;
++    } else if (exp !== null && act === null) {
++      exceeds = true;
++    }
++    
++    deltas.push({
++      field: name,
++      expected: exp,
++      actual: act,
++      delta,
++      tolerance,
++      exceeds,
++    });
++  }
++  
++  return deltas;
++}
