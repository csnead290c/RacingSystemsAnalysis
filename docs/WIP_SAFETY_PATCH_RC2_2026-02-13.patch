++// VB6 distance checkpoints for Bonneville 5-mile (DistToPrint 2..9)
++const VB6_MILE_CHECKPOINTS = [
++  { dist_ft: 5280,  vb6_time: 20.56, vb6_mph: 249.5 },
++  { dist_ft: 10560, vb6_time: 34.25, vb6_mph: 270.1 },
++  { dist_ft: 13200, vb6_time: 40.89, vb6_mph: 271.5 },
++  { dist_ft: 15840, vb6_time: 47.52, vb6_mph: 272.1 },
++  { dist_ft: 18480, vb6_time: 54.12, vb6_mph: 272.7 },
++  { dist_ft: 21120, vb6_time: 60.72, vb6_mph: 273.3 },
++  { dist_ft: 23760, vb6_time: 67.30, vb6_mph: 273.9 },
++  { dist_ft: 26400, vb6_time: 73.86, vb6_mph: 274.4 },
++];
++
++describe('Bonneville land speed checkpoints (GASCOUPE)', () => {
++  // Run sim once for all tests
++  const simInputs = fixtureToSimInputs(BONNEVILLE_PRO_32_GASCOUPE, 'BONNEVILLE_LONG');
++  const result = simulateVB6Exact(simInputs);
++  const printedRows = (result as any).printedRows as Array<{
++    type: string;
++    raw: { time_s: number; dist_ft: number; vel_fps: number };
++    quantized: { time_s: number; dist_ft: number; mph: number };
++  }>;
++  const distRows = printedRows.filter(r => r.type === 'distance');
++
++  it('sim uses rolloutIn=0 for land speed', () => {
++    const debugData = (result as any).debugData?.simParams;
++    expect(debugData?.rolloutIn).toBe(0);
++    expect(debugData?.rolloutTime_s).toBe(0);
++  });
++
++  it('printedRows contains a distance entry for each VB6 mile checkpoint', () => {
++    for (const cp of VB6_MILE_CHECKPOINTS) {
++      const row = distRows.find(r => Math.abs(r.raw.dist_ft - cp.dist_ft) < 2);
++      expect(row, `missing printedRow for ${cp.dist_ft} ft`).toBeDefined();
++    }
++  });
++
++  it('checkpoint times from printedRows match VB6 within ±0.30s', () => {
++    for (const cp of VB6_MILE_CHECKPOINTS) {
++      const row = distRows.find(r => Math.abs(r.raw.dist_ft - cp.dist_ft) < 2)!;
++      const ts_time = row.raw.time_s;
++      const delta = Math.abs(ts_time - cp.vb6_time);
++      expect(delta, `time at ${cp.dist_ft}ft: TS=${ts_time.toFixed(2)} vs VB6=${cp.vb6_time} (Δ=${delta.toFixed(3)}s)`).toBeLessThan(0.35);
++    }
++  });
++
++  it('checkpoint speeds from printedRows match VB6 within ±4.0 mph', () => {
++    for (const cp of VB6_MILE_CHECKPOINTS) {
++      const row = distRows.find(r => Math.abs(r.raw.dist_ft - cp.dist_ft) < 2)!;
++      const ts_mph = row.raw.vel_fps * Z5;
++      const delta = Math.abs(ts_mph - cp.vb6_mph);
++      expect(delta, `mph at ${cp.dist_ft}ft: TS=${ts_mph.toFixed(1)} vs VB6=${cp.vb6_mph} (Δ=${delta.toFixed(1)})`).toBeLessThan(4.0);
++    }
++  });
++
++  it('final time matches VB6 within ±0.30s', () => {
++    const finishRow = distRows.find(r => Math.abs(r.raw.dist_ft - 26400) < 2)!;
