++// =========================================================================
++// hasAnyMismatch
++// =========================================================================
++describe('hasAnyMismatch', () => {
++  it('returns false when all systems agree (all true)', () => {
++    expect(hasAnyMismatch(makeDiags({ etSim: T, raceTools: T, runLogging: T, vehicles: T }))).toBe(false);
