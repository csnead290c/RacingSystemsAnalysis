++function calcHP_TABY_VB6Semantics(
++  xrpm: number[],
++  yhp: number[],
++  NHP: number,
++  EngRPM: number
++): number {
++  // TABY performs Lagrange interpolation, returns HP as Single
++  // tabyLagrange returns Double, we truncate to Single at assignment
++  return vb6AssignSingle(taby(xrpm, yhp, NHP, 1, EngRPM));
++}
++
++/**
++ * Apply HPTQMult correction using VB6 semantics
++ * VB6 line 1177: HP = gc_HPTQMult.Value * HP / hpc
