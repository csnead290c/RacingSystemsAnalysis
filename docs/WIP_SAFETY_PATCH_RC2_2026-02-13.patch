++' Emit a trace step as JSONL (matches TS schema exactly)
++' IMPORTANT: No math inside this function - only formatting
++Private Sub TraceStep(ByVal stepName As String, ByVal val As Single, ByVal vb6Line As String)
++    Debug.Print "{""step"":""" & stepName & """,""value"":" & val & ",""valueHex"":""" & SingleToHex(val) & """,""vb6Line"":""" & vb6Line & """}"
++End Sub
++```
