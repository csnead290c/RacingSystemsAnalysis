++ */
++function loadFixture(caseId: string): JsonFixture {
++  const fixturePath = path.join(__dirname, '..', 'json-fixtures', `${caseId}.json`);
++  if (!fs.existsSync(fixturePath)) {
++    throw new Error(`Fixture not found: ${fixturePath}`);
