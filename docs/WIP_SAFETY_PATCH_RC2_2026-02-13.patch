++  // TiresPMI/TransPMI/GearRatio are CValue (Double), TGR is Single but ^ 2 promotes to Double
++  // Entire expression computed in Double, assigned to ChassisPMI (Single)
++  return vb6AssignSingle(
++    TiresPMI + TransPMI * Math.pow(GearRatio, 2) * Math.pow(TGR_gear, 2)
++  );
++}
++
++/**
++ * Calculate velocity estimate using VB6 semantics
++ * VB6 line 1107: Vel(L) = Vel0 + Ags0 * gc * TimeStep + Jerk * gc * TimeStep ^ 2 / 2
++ */
++function calcVelocity_VB6Semantics(
++  Vel0: number,
++  Ags0: number,
++  TimeStep: number,
++  Jerk: number
++): number {
++  // Vel0/Ags0/TimeStep/Jerk are Single, gc is Double constant → computed in Double
++  // Vel(L) is Single → truncated on assignment
++  return vb6AssignSingle(
++    Vel0 + Ags0 * gc * TimeStep + Jerk * gc * Math.pow(TimeStep, 2) / 2
++  );
++}
