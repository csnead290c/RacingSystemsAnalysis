++  const v7 = splitValues(lines[7]); // chamber, deck, gasket, dome
++
++  const inline = v2[0] ?? 1;
++  const noCyl = v2[1] ?? 8;
++  const bore = v2[2] ?? 4.03;
++  const stroke = v2[3] ?? 3.48;
++  const rod = v2[4] ?? 5.85;
++  const compressionRatio = v2[5] ?? 12.9;
++
++  const camType = v3[0] ?? 4;
