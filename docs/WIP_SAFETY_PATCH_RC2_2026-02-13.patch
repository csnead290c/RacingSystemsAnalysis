++/**
++ * FourLinkAssetInstallModal
++ *
++ * Searchable, sortable, paginated modal that lists four-link assets from the library.
++ * Selecting one calls onInstall with the asset ID + revision.
++ */
++
++import { useState, useMemo, useEffect, useRef } from 'react';
++import type { FourLinkAsset, FourLinkAssetKind } from '../../domain/library/fourLinkAssets';
++import { listFourLinkAssets } from '../../state/fourLinkAssets';
++
++// ── Props ───────────────────────────────────────────────────────────
++
++interface FourLinkAssetInstallModalProps {
++  onInstall: (assetId: string, pinnedRevision: number) => void;
++  onClose: () => void;
++}
++
++// ── Constants ───────────────────────────────────────────────────────
++
++const PAGE_SIZE = 20;
++const DEBOUNCE_MS = 200;
++
++type SortKey = 'updated' | 'name';
++
++const SORT_OPTIONS: { value: SortKey; label: string }[] = [
++  { value: 'updated', label: 'Recently Updated' },
++  { value: 'name', label: 'Name (A-Z)' },
++];
++
++const KIND_LABELS: Record<FourLinkAssetKind, string> = {
++  sim: 'Sim',
++  manual: 'Manual',
++  measured: 'Measured',
++};
++
++const KIND_COLORS: Record<FourLinkAssetKind, string> = {
++  sim: '#8b5cf6',
++  manual: '#3b82f6',
++  measured: '#f59e0b',
++};
++
++// ── Helpers ─────────────────────────────────────────────────────────
++
++function sortAssets(assets: FourLinkAsset[], key: SortKey): FourLinkAsset[] {
++  const sorted = [...assets];
++  switch (key) {
++    case 'updated':
++      return sorted.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
++    case 'name':
++      return sorted.sort((a, b) => a.name.localeCompare(b.name));
++  }
++}
++
++function getAssetSummary(asset: FourLinkAsset): string {
++  switch (asset.kind) {
++    case 'sim': {
++      const s = asset.payload.fourLinkSimResultSummary;
++      return `IC ${s.instantCenterIn}" • Anti-squat ${s.antiSquatPct}% • Pinion ${s.pinionAngleDeg}°`;
++    }
++    case 'manual':
++    case 'measured': {
++      const p = asset.payload;
++      const parts: string[] = [];
++      if (p.instantCenterIn != null) parts.push(`IC ${p.instantCenterIn}"`);
++      if (p.antiSquatPct != null) parts.push(`Anti-squat ${p.antiSquatPct}%`);
++      if (p.pinionAngleDeg != null) parts.push(`Pinion ${p.pinionAngleDeg}°`);
++      return parts.length > 0 ? parts.join(' • ') : 'No data';
++    }
++  }
++}
++
++// ── Component ───────────────────────────────────────────────────────
++
++export function FourLinkAssetInstallModal({ onInstall, onClose }: FourLinkAssetInstallModalProps) {
++  const [searchInput, setSearchInput] = useState('');
++  const [debouncedSearch, setDebouncedSearch] = useState('');
++  const [sortKey, setSortKey] = useState<SortKey>('updated');
++  const [page, setPage] = useState(0);
++  const debounceRef = useRef<ReturnType<typeof setTimeout>>();
