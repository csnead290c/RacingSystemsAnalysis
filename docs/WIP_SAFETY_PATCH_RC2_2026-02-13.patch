++#!/usr/bin/env python3
++"""
++Extract QuarterPro v3.2 checkpoint tables from PDF printouts.
++
++Uses text extraction (PyMuPDF) as primary method, with OCR fallback if needed.
++Generates TypeScript fixtures for checkpoint parity tests.
++"""
++
++import sys
++import json
++import re
++from pathlib import Path
++from typing import List, Dict, Optional, Any
++from dataclasses import dataclass, asdict
++
++try:
++    import fitz  # PyMuPDF
++except ImportError:
++    print("ERROR: PyMuPDF not installed. Install with: pip install PyMuPDF")
++    sys.exit(1)
++
++
++@dataclass
++class Checkpoint:
++    dist_ft: float
++    time_et_s: float  # ET clock (reset at rollout, same as summary ET)
++    mph: float
++    accel: Optional[float]
++    gear: int
++    rpm: int
++    time_abs_s: Optional[float] = None  # Absolute time (only for rollout row)
++    label: Optional[str] = None  # "Staged", "Rollout", etc.
++    note: Optional[str] = None
++
++
++@dataclass
++class Summary:
++    eighth_et_s: Optional[float] = None
++    eighth_mph: Optional[float] = None
++    quarter_et_s: Optional[float] = None
++    quarter_mph: Optional[float] = None
++
++
++@dataclass
++class CaseData:
++    case_id: str
++    config_name: str
++    checkpoints: List[Checkpoint]
++    summary: Summary
++    source: Dict[str, Any]
++    extraction_mode: str
++
++
++def clean_number(s: str) -> str:
++    """Remove commas and other non-numeric characters except decimal point and minus."""
++    return re.sub(r'[^\d.\-]', '', s)
++
++
++def parse_checkpoint_line(line: str) -> Optional[Checkpoint]:
++    """
++    Parse a checkpoint table line.
++    
++    Expected format (columns may vary in spacing):
++    Time    Distance    MPH    Acceleration    Gear    RPM
++    0.23    11          21.5   2.45            1       7,200
++    
++    Special cases:
++    - Rollout line: "0.146/0.00 Rollout" where 0.146=absolute time, 0.00=ET clock
++    - Staged line: "0.00 0 ..." (first row)
++    - Acceleration may have "(s)" suffix
++    - RPM has commas
++    """
++    # Skip empty lines
++    if not line.strip():
++        return None
++    
++    # Split by whitespace (multiple spaces/tabs)
++    parts = line.split()
++    if len(parts) < 5:
++        return None
++    
++    try:
++        label = None
++        time_abs_s = None
++        time_et_s = 0.0
++        
++        # Handle rollout special case
++        if 'Rollout' in line:
++            label = 'Rollout'
++            # Time format: "X/Y" where X=absolute, Y=ET clock
++            time_str = parts[0]
++            if '/' in time_str:
++                time_parts = time_str.split('/')
++                time_abs_s = float(clean_number(time_parts[0]))
++                time_et_s = float(clean_number(time_parts[1]))
++            else:
++                # Fallback: single value (treat as absolute, assume ET=0)
++                time_abs_s = float(clean_number(time_str))
++                time_et_s = 0.0
++            
++            # Distance might be "Rollout" text
++            if 'Rollout' in parts[1]:
++                dist_ft = 0.0
++                parts = parts[2:]  # Shift remaining parts
++            else:
++                dist_ft = float(clean_number(parts[1]))
++                parts = parts[2:]
++        else:
++            # Normal line or staged line
++            time_et_s = float(clean_number(parts[0]))
++            dist_ft = float(clean_number(parts[1]))
++            parts = parts[2:]
++            
++            # Check if this is the staged line (time=0, dist=0)
++            if time_et_s == 0.0 and dist_ft == 0.0:
++                label = 'Staged'
++        
++        # Parse remaining fields
++        if len(parts) < 4:
++            return None
++        
++        mph = float(clean_number(parts[0]))
++        
++        # Acceleration - may be missing or have "(s)" suffix
++        accel_str = clean_number(parts[1])
++        accel = float(accel_str) if accel_str else None
++        
++        gear = int(clean_number(parts[2]))
++        rpm = int(clean_number(parts[3]))
++        
++        return Checkpoint(
++            dist_ft=dist_ft,
++            time_et_s=time_et_s,
++            mph=mph,
++            accel=accel,
++            gear=gear,
++            rpm=rpm,
++            time_abs_s=time_abs_s,
++            label=label,
++            note=None  # Deprecated, use label instead
++        )
++    except (ValueError, IndexError) as e:
++        # Failed to parse this line
++        return None
++
