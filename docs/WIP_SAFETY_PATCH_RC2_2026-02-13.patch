++/**
++ * Canonical caseId helpers for QuarterJr and BonnevillePro validation
++ */
++
++/**
++ * Extract canonical caseId from PDF path
++ * Rule: Use the PDF filename stem exactly as it appears
++ * Example: "QuarterJrTest1.pdf" -> "QuarterJrTest1"
++ */
++export function caseIdFromPdfPath(pdfPath: string): string {
++  const filename = pdfPath.split('/').pop() || pdfPath;
++  return filename.replace(/\.pdf$/i, '');
++}
++
++/**
++ * Assert that a caseId is in the known list, throw if not
++ */
++export function assertKnownCaseId(caseId: string, available: string[]): void {
++  if (!available.includes(caseId)) {
++    throw new Error(
++      `Unknown caseId: ${caseId}\n` +
++      `Available cases: ${available.join(', ')}`
++    );
++  }
++}
++
++/**
++ * Validate caseId format (no double underscores, no spaces, etc)
++ */
++export function validateCaseId(caseId: string): void {
++  if (caseId.includes('  ')) {
++    throw new Error(`Invalid caseId (double spaces): ${caseId}`);
++  }
++  if (caseId.includes('__')) {
++    throw new Error(`Invalid caseId (double underscores): ${caseId}`);
++  }
++  if (caseId !== caseId.trim()) {
++    throw new Error(`Invalid caseId (leading/trailing whitespace): ${caseId}`);
++  }
++}
