++#!/usr/bin/env python3
++"""
++QuarterJr v3.2 and BonnevillePro Checkpoint Extraction from PDFs
++
++Extracts checkpoint tables and summary data from VB6 PDF printouts.
++Mirrors the QuarterPro extraction methodology:
++- Dual-time rollout format ("X/Y Rollout")
++- ET clock vs absolute time separation
++- Summary ET/MPH extraction
++
++Usage:
++    python scripts/extract_quarterjr_bonnevillepro_checkpoints.py
++
++Outputs:
++    src/integration-tests/fixtures/quarterjr_v32_checkpoints_extracted.ts
++    src/integration-tests/fixtures/bonnevillepro_checkpoints_extracted.ts
++"""
++
++import re
++import sys
++from pathlib import Path
++from dataclasses import dataclass, field
++from typing import Optional, List, Dict
++
++try:
++    import fitz  # PyMuPDF
++except ImportError:
++    print("ERROR: PyMuPDF not installed. Run: pip install PyMuPDF")
++    sys.exit(1)
++
++
++@dataclass
++class Checkpoint:
++    """Single checkpoint row from PDF table"""
++    dist_ft: float
++    time_et_s: float  # ET clock time (0.00 at rollout)
++    time_abs_s: Optional[float] = None  # Absolute time (only for rollout row)
++    label: Optional[str] = None  # "Staged", "Rollout", or None
++    mph: Optional[float] = None
++    accel: Optional[float] = None
++    gear: Optional[int] = None
++    rpm: Optional[int] = None
++
++
++@dataclass
++class Summary:
++    """Summary ET/MPH from PDF"""
++    eighth_et_s: Optional[float] = None
++    eighth_mph: Optional[float] = None
++    quarter_et_s: Optional[float] = None
++    quarter_mph: Optional[float] = None
++    thousand_et_s: Optional[float] = None  # BonnevillePro
++    thousand_mph: Optional[float] = None
++    
++    # Expected summary for golden tests (finish row)
++    finish_ft: Optional[float] = None
++    finish_et_s: Optional[float] = None
++    finish_mph: Optional[float] = None
++
++
++@dataclass
++class CheckpointCase:
++    """Complete test case from one PDF"""
++    case_id: str
++    config_name: str
++    pdf_filename: str
++    checkpoints: List[Checkpoint] = field(default_factory=list)
++    summary: Summary = field(default_factory=Summary)
++
++
++def parse_checkpoint_line(line: str, prev_line: Optional[str] = None, model: str = 'QuarterJr') -> Optional[Checkpoint]:
++    """
++    Parse a checkpoint table line.
++    
++    CRITICAL: PDF format is "Time Distance MPH Accel Gear RPM"
++    
++    Format examples from actual PDFs:
++        QuarterJr/QuarterPro (distance in FEET):
++            0.00        0      0.0     0.92      1   3,000
++            0.252/0.00 Rollout    5.8     0.89      1   3,000
++            1.00       25     21.8     0.60      1   3,170
++            8.60      660     81.6     0.21      3   4,380
++            13.50     1320    101.6     0.17      3   5,230
++        
++        BonnevillePro (distance in MILES):
++            0.00      0.00     0.0     0.92      1   3,000
++            1.00      0.05    21.8     0.60      1   3,170
++            50.00     5.00   250.0     0.21      3   4,380
++    
++    Rollout row has dual-time format: "X/Y Rollout" where X=abs, Y=ET
++    """
++    line = line.strip()
++    if not line or line.startswith('Distance') or line.startswith('Time'):
++        return None
++    
++    # Ignore stray single number before header (e.g., "1.108")
++    if prev_line and re.match(r'^\s*\d+\.\d+\s*$', prev_line):
++        if 'Time' in line or 'Distance' in line or 'MPH' in line:
++            return None
++    
++    # Remove commas from numbers (e.g., "3,000" -> "3000")
++    line = line.replace(',', '')
++    
++    # Check for labels AFTER removing commas but BEFORE splitting
++    label = None
++    if 'Staged' in line:
++        label = 'Staged'
++    elif 'Rollout' in line:
++        label = 'Rollout'
++    
++    # Split on whitespace
++    parts = line.split()
++    if len(parts) < 2:
++        return None
++    
++    try:
++        # CORRECT FORMAT: Time Distance MPH Accel Gear RPM
++        # First field is TIME (may be dual-time for rollout)
++        # For rollout rows: "0.252/0.00 Rollout 5.8 ..." 
++        # After split: ['0.252/0.00', 'Rollout', '5.8', ...]
++        
++        # Check if first field contains '/' (rollout dual-time)
++        if '/' in parts[0]:
++            # Rollout row: "X/Y [Rollout] distance mph ..."
++            time_parts = parts[0].split('/')
++            time_abs_s = float(time_parts[0])
++            time_et_s = float(time_parts[1])
++            
++            # Skip "Rollout" label if present as second token
++            dist_idx = 2 if len(parts) > 2 and parts[1].lower() == 'rollout' else 1
++            
++            dist_raw = float(parts[dist_idx]) if len(parts) > dist_idx else 0.0
++            # Convert to feet if BonnevillePro
++            dist_ft = dist_raw * 5280 if model == 'BonnevillePro' else dist_raw
++            
++            mph = float(parts[dist_idx + 1]) if len(parts) > dist_idx + 1 else None
++            accel_str = parts[dist_idx + 2].replace('(s)', '').replace('(S)', '') if len(parts) > dist_idx + 2 else None
++            accel = float(accel_str) if accel_str else None
++            gear = int(parts[dist_idx + 3]) if len(parts) > dist_idx + 3 else None
++            rpm = int(parts[dist_idx + 4]) if len(parts) > dist_idx + 4 else None
++            
++            return Checkpoint(
++                dist_ft=dist_ft,
++                time_et_s=time_et_s,
++                time_abs_s=time_abs_s,
++                label=label,
++                mph=mph,
++                accel=accel,
++                gear=gear,
++                rpm=rpm
++            )
++        else:
++            # Normal row: time(ET) distance mph accel gear rpm
++            # May have "Staged" label: "0.00 Staged 0 0.0 ..."
++            time_et_s = float(parts[0])
++            
++            # Skip "Staged" label if present as second token
++            dist_idx = 2 if len(parts) > 2 and parts[1].lower() == 'staged' else 1
++            
++            dist_raw = float(parts[dist_idx])
++            # Convert to feet if BonnevillePro
++            dist_ft = dist_raw * 5280 if model == 'BonnevillePro' else dist_raw
++            time_abs_s = None
++            
++            mph = float(parts[dist_idx + 1]) if len(parts) > dist_idx + 1 else None
++            accel_str = parts[dist_idx + 2].replace('(s)', '').replace('(S)', '') if len(parts) > dist_idx + 2 else None
++            accel = float(accel_str) if accel_str else None
++            gear = int(parts[dist_idx + 3]) if len(parts) > dist_idx + 3 else None
++            rpm = int(parts[dist_idx + 4]) if len(parts) > dist_idx + 4 else None
++            
++            return Checkpoint(
++                dist_ft=dist_ft,
++                time_et_s=time_et_s,
++                time_abs_s=time_abs_s,
++                label=label,
++                mph=mph,
++                accel=accel,
++                gear=gear,
++                rpm=rpm
++            )
++    
++    except (ValueError, IndexError) as e:
++        return None
++
++
++def extract_summary(text: str, model: str) -> Summary:
++    """Extract summary ET/MPH from PDF text"""
++    summary = Summary()
++    
++    # Look for summary lines like:
++    # "1/8 Mile: 8.60 sec @ 80.3 MPH   1/4 Mile: 13.50 sec @ 100.8 MPH"
++    # "1000 ft: 3.50 @ 250.0" (BonnevillePro)
++    
++    # QuarterJr format: "1/8 Mile: X.XX sec @ XX.X MPH"
++    eighth_match = re.search(r'1/8\s+[Mm]ile[:\s]+(\d+\.\d+)\s+sec\s+@\s+(\d+\.\d+)\s+MPH', text, re.IGNORECASE)
++    if eighth_match:
++        summary.eighth_et_s = float(eighth_match.group(1))
++        summary.eighth_mph = float(eighth_match.group(2))
++    
++    quarter_match = re.search(r'1/4\s+[Mm]ile[:\s]+(\d+\.\d+)\s+sec\s+@\s+(\d+\.\d+)\s+MPH', text, re.IGNORECASE)
++    if quarter_match:
++        summary.quarter_et_s = float(quarter_match.group(1))
++        summary.quarter_mph = float(quarter_match.group(2))
++    
++    if model == 'BonnevillePro':
++        # BonnevillePro doesn't have summary line - will extract from checkpoints later
++        pass
++    
++    return summary
++
++
++def validate_checkpoints(case: CheckpointCase, model: str) -> None:
++    """
++    Self-check: validate extracted checkpoints meet sanity requirements
++    """
++    if not case.checkpoints:
++        raise ValueError(f"{case.case_id}: No checkpoints extracted")
++    
++    # Check monotonic distance (allow equal for very low speed cases)
++    prev_dist = -1
++    for i, cp in enumerate(case.checkpoints):
++        if cp.dist_ft < prev_dist:
++            raise ValueError(
++                f"{case.case_id}: Non-monotonic distance at checkpoint {i}: "
++                f"{prev_dist}ft -> {cp.dist_ft}ft"
++            )
++        prev_dist = cp.dist_ft
++    
++    # Check monotonic ET time (after rollout for QuarterJr)
++    rollout_idx = next((i for i, cp in enumerate(case.checkpoints) if cp.label == 'Rollout'), None)
++    start_idx = rollout_idx + 1 if rollout_idx is not None else 0
++    
++    prev_time = -1
++    for i in range(start_idx, len(case.checkpoints)):
++        cp = case.checkpoints[i]
++        if cp.time_et_s <= prev_time:
++            raise ValueError(
++                f"{case.case_id}: Non-monotonic ET time at checkpoint {i}: "
++                f"{prev_time}s -> {cp.time_et_s}s"
++            )
++        prev_time = cp.time_et_s
++    
++    # Check plausible time range
++    final_time = case.checkpoints[-1].time_et_s
++    if model == 'QuarterJr' and final_time > 20:
++        raise ValueError(
++            f"{case.case_id}: Implausible final ET time: {final_time}s (expected < 20s for QuarterJr)"
++        )
++
++
++def extract_checkpoints_from_pdf(pdf_path: Path, model: str) -> Optional[CheckpointCase]:
++    """Extract checkpoint table and summary from a single PDF"""
++    try:
++        doc = fitz.open(pdf_path)
++        full_text = ""
++        
++        for page in doc:
++            full_text += page.get_text()
++        
++        doc.close()
++        
++        # Extract config name from filename
++        # QuarterJrTest1.pdf -> Test1
++        # BonnevilleProTest1.pdf -> Test1
++        filename = pdf_path.name
++        config_name = filename.replace('QuarterJr', '').replace('BonnevillePro', '').replace('.pdf', '')
++        base_name = pdf_path.stem  # e.g., "QuarterJrTest1"
++        case_id = base_name  # Keep as-is to match inputs JSON
++        
++        # Parse checkpoint table
++        checkpoints = []
++        lines = full_text.split('\n')
++        
++        for i, line in enumerate(lines):
++            prev_line = lines[i-1] if i > 0 else None
++            cp = parse_checkpoint_line(line, prev_line, model)
++            if cp:
++                checkpoints.append(cp)
++        
++        # Extract summary
++        summary = extract_summary(full_text, model)
++        
++        # Extract expected summary from finish row (last checkpoint)
++        if checkpoints:
++            # Find finish row (last non-rollout checkpoint)
++            finish_row = None
++            for cp in reversed(checkpoints):
++                if cp.label != 'Rollout' and cp.time_et_s is not None:
++                    finish_row = cp
++                    break
++            
++            if finish_row:
++                summary.finish_ft = finish_row.dist_ft
++                summary.finish_et_s = finish_row.time_et_s
++                summary.finish_mph = finish_row.mph
++        
++        # For BonnevillePro, also extract summary from checkpoints at key distances
++        if model == 'BonnevillePro' and checkpoints:
++            for target_dist, et_field, mph_field in [
++                (660, 'eighth_et_s', 'eighth_mph'),
++                (1000, 'thousand_et_s', 'thousand_mph'),
++                (1320, 'quarter_et_s', 'quarter_mph')
++            ]:
++                closest_cp = min(checkpoints, key=lambda cp: abs(cp.dist_ft - target_dist))
++                if abs(closest_cp.dist_ft - target_dist) < 100:
++                    setattr(summary, et_field, closest_cp.time_et_s)
++                    setattr(summary, mph_field, closest_cp.mph)
++        
++        if not checkpoints:
++            print(f"WARNING: No checkpoints found in {pdf_path.name}")
++            return None
++        
++        return CheckpointCase(
++            case_id=case_id,
++            config_name=config_name,
++            pdf_filename=filename,
++            checkpoints=checkpoints,
++            summary=summary
++        )
++    
++    except Exception as e:
++        print(f"ERROR processing {pdf_path.name}: {e}")
++        return None
++
++
++def validate_checkpoint_case(case: CheckpointCase) -> List[str]:
++    """Validate extracted checkpoint data"""
++    errors = []
++    
++    # BonnevillePro doesn't have rollout/staged rows, skip those checks
++    model = 'BonnevillePro' if 'Bonneville' in case.case_id else 'QuarterJr'
++    
++    if model != 'BonnevillePro':
++        # Check for rollout row (QuarterJr only)
++        rollout_rows = [cp for cp in case.checkpoints if cp.label == 'Rollout']
++        if not rollout_rows:
++            errors.append(f"{case.case_id}: No rollout row found")
++        elif len(rollout_rows) > 1:
++            errors.append(f"{case.case_id}: Multiple rollout rows found")
++        else:
++            rollout = rollout_rows[0]
++            if rollout.time_abs_s is None:
++                errors.append(f"{case.case_id}: Rollout missing time_abs_s")
++            if rollout.time_et_s != 0.0:
++                errors.append(f"{case.case_id}: Rollout time_et_s should be 0.00, got {rollout.time_et_s}")
++    
++    # Check time monotonicity (ET clock should increase after rollout)
++    rollout_idx = next((i for i, cp in enumerate(case.checkpoints) if cp.label == 'Rollout'), -1)
++    if rollout_idx >= 0:
++        for i in range(rollout_idx + 1, len(case.checkpoints)):
++            if case.checkpoints[i].time_et_s <= case.checkpoints[i-1].time_et_s:
++                errors.append(f"{case.case_id}: Non-monotonic ET at index {i}")
++                break
++    
++    return errors
++
++
++def generate_typescript_fixture(cases: List[CheckpointCase], model: str, output_path: Path):
++    """Generate TypeScript fixture file"""
++    
++    # Header
++    lines = [
++        "/**",
++        f" * {model} Checkpoint Data - AUTO-GENERATED",
++        " * ",
++        " * DO NOT EDIT MANUALLY",
++        " * ",
++        " * Generated from PDF printouts using:",
++        " *   scripts/extract_quarterjr_bonnevillepro_checkpoints.py",
++        " * ",
++        f" * Source PDFs: Reference Files/RsaClassicTestResults/{model}TestResults/",
++        " * ",
