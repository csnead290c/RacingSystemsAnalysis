++/**
++ * Clutch/Converter Truncation Boundary Semantic Tests
++ * 
++ * This test validates that VB6 type coercion rules are correctly applied
++ * to the Clutch/Converter calculations in vb6SimulationStep.ts.
++ * 
++ * VB6 Source: TIMESLIP.FRM lines 1144-1174
++ * 
++ * VB6 Variable Types:
++ *   LockRPM    - Single (line 510)
++ *   EngRPM(L)  - Single (line 536)
++ *   ClutchSlip - Single (line 511)
++ *   SlipRatio  - Single (line 516)
++ *   Stall      - Single (line 517)
++ *   zStall     - Single (line 517)
++ *   Work       - Single (line 539)
++ *   gc_GearRatio.Value   - Variant→Double (CValue)
++ *   gc_Slippage.Value    - Variant→Double (CValue)
++ *   gc_TorqueMult.Value  - Variant→Double (CValue)
++ * 
++ * VB6 Coercion Rules:
++ *   1. gc_*.Value are CValue (Variant→Double)
++ *   2. Single * Double → computed in Double
++ *   3. Truncation to Single occurs ONLY at assignment
++ */
++
++import { describe, it, expect } from 'vitest';
++import { vb6AssignSingle } from '../exactMath';
++
++/**
++ * Calculate LockRPM using VB6 semantics
++ * VB6 line 1145: LockRPM = DSRPM * gc_GearRatio.Value * TGR(iGear)
++ */
++function calcLockRPM_VB6Semantics(
++  DSRPM: number,
++  GearRatio: number,
++  TGR_gear: number
++): number {
++  // DSRPM/TGR are Single, gc_GearRatio.Value is CValue (Double) → computed in Double
++  // LockRPM is Single → truncated on assignment
++  return vb6AssignSingle(DSRPM * GearRatio * TGR_gear);
++}
++
++/**
++ * Calculate EngRPM using VB6 semantics
++ * VB6 line 1146: EngRPM(L) = gc_Slippage.Value * LockRPM
++ */
++function calcEngRPM_VB6Semantics(Slippage: number, LockRPM: number): number {
++  // gc_Slippage.Value is CValue (Double), LockRPM is Single → computed in Double
++  // EngRPM(L) is Single → truncated on assignment
++  return vb6AssignSingle(Slippage * LockRPM);
++}
++
++/**
++ * Calculate ClutchSlip for clutch type (VB6 line 1152)
++ * VB6: ClutchSlip = LockRPM / EngRPM(L)
++ */
++function calcClutchSlip_Clutch_VB6Semantics(LockRPM: number, EngRPM: number): number {
++  // LockRPM/EngRPM are Single → Single / Single = Single (no Double operand)
++  // ClutchSlip is Single → truncated on assignment
++  return vb6AssignSingle(LockRPM / EngRPM);
++}
++
++/**
++ * Calculate SlipRatio for converter (VB6 line 1156)
++ * VB6: SlipRatio = gc_Slippage.Value * LockRPM / zStall
++ */
++function calcSlipRatio_VB6Semantics(
++  Slippage: number,
++  LockRPM: number,
++  zStall: number
++): number {
++  // gc_Slippage.Value is CValue (Double), LockRPM/zStall are Single → computed in Double
++  // SlipRatio is Single → truncated on assignment
++  return vb6AssignSingle(Slippage * LockRPM / zStall);
++}
++
++/**
++ * Calculate zStall adjustment for converter (VB6 line 1159)
++ * VB6: zStall = zStall * (1 + (gc_Slippage.Value - 1) * (SlipRatio - 0.6) / ((1 / gc_Slippage.Value) - 0.6))
++ */
++function calcZStallAdjusted_VB6Semantics(
++  zStall: number,
++  Slippage: number,
++  SlipRatio: number
++): number {
++  // gc_Slippage.Value is CValue (Double), literals are Double → computed in Double
++  // zStall is Single → truncated on assignment
++  return vb6AssignSingle(
++    zStall * (1 + (Slippage - 1) * (SlipRatio - 0.6) / ((1 / Slippage) - 0.6))
++  );
++}
++
