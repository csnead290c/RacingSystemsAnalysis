++/**
++ * Get checkpoints for a specific config and race length
++ */
++export function getCheckpointsForRaceLength(
++  configName: string,
++  raceLength: 'EIGHTH' | 'QUARTER' | 'THOUSAND'
++): Checkpoint[] {
++  const caseData = BONNEVILLEPRO_CHECKPOINTS_EXTRACTED.find(c => c.configName === configName);
++  if (!caseData) return [];
++  
++  const maxDist = raceLength === 'EIGHTH' ? 660 : raceLength === 'THOUSAND' ? 1000 : 1320;
++  return caseData.checkpoints.filter(cp => cp.dist_ft <= maxDist);
++}
