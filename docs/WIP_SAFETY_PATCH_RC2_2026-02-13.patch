++/**
++ * Unit tests for resolveModelId() — backward-compatible model ID resolution.
++ * 
++ * Ensures legacy/unknown model IDs gracefully map to valid PhysicsModelId
++ * values instead of crashing the worker.
++ */
++import { describe, it, expect, vi, beforeEach } from 'vitest';
++import { resolveModelId, _resetLegacyWarnings } from '../index';
++
++describe('resolveModelId', () => {
++  beforeEach(() => {
++    _resetLegacyWarnings();
++    vi.restoreAllMocks();
++  });
++
++  // ── Valid current model IDs (pass-through) ──────────────────────────
++
++  it('returns "VB6Exact" unchanged', () => {
++    expect(resolveModelId('VB6Exact')).toBe('VB6Exact');
++  });
++
++  it('returns "SimpleV1" unchanged', () => {
++    expect(resolveModelId('SimpleV1')).toBe('SimpleV1');
++  });
++
++  // ── Legacy RSACLASSIC variants ──────────────────────────────────────
++
++  it('maps "RSACLASSIC" to "VB6Exact"', () => {
++    expect(resolveModelId('RSACLASSIC')).toBe('VB6Exact');
++  });
++
++  it('maps "rsaclassic" to "VB6Exact"', () => {
++    expect(resolveModelId('rsaclassic')).toBe('VB6Exact');
++  });
++
++  it('maps "RSAClassic" to "VB6Exact"', () => {
++    expect(resolveModelId('RSAClassic')).toBe('VB6Exact');
++  });
++
++  // ── Legacy Blend variants ───────────────────────────────────────────
++
++  it('maps "Blend" to "VB6Exact"', () => {
++    expect(resolveModelId('Blend')).toBe('VB6Exact');
++  });
++
++  it('maps "blend" to "VB6Exact"', () => {
++    expect(resolveModelId('blend')).toBe('VB6Exact');
++  });
++
++  // ── Empty / missing input ───────────────────────────────────────────
++
++  it('maps undefined to "VB6Exact"', () => {
++    expect(resolveModelId(undefined)).toBe('VB6Exact');
++  });
++
++  it('maps null to "VB6Exact"', () => {
++    expect(resolveModelId(null)).toBe('VB6Exact');
++  });
++
++  it('maps empty string to "VB6Exact"', () => {
++    expect(resolveModelId('')).toBe('VB6Exact');
++  });
++
++  // ── Unknown model IDs ──────────────────────────────────────────────
++
++  it('maps unknown "FOO" to "VB6Exact"', () => {
++    expect(resolveModelId('FOO')).toBe('VB6Exact');
++  });
++
++  it('maps unknown "v6bExact" (typo) to "VB6Exact"', () => {
++    expect(resolveModelId('v6bExact')).toBe('VB6Exact');
++  });
++
++  // ── Warn-once behavior ─────────────────────────────────────────────
++
++  describe('warn-once behavior', () => {
++    it('warns on first legacy ID call, not on second', () => {
++      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
++
++      resolveModelId('RSACLASSIC');
++      expect(warnSpy).toHaveBeenCalledTimes(1);
++      expect(warnSpy).toHaveBeenCalledWith(
++        expect.stringContaining('RSACLASSIC')
++      );
++      expect(warnSpy).toHaveBeenCalledWith(
++        expect.stringContaining('VB6Exact')
++      );
++
++      resolveModelId('RSACLASSIC');
++      expect(warnSpy).toHaveBeenCalledTimes(1); // still 1 — no spam
++    });
++
++    it('warns on first unknown ID call, not on second', () => {
++      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
++
++      resolveModelId('FOO');
++      expect(warnSpy).toHaveBeenCalledTimes(1);
++      expect(warnSpy).toHaveBeenCalledWith(
++        expect.stringContaining('FOO')
++      );
++
++      resolveModelId('FOO');
++      expect(warnSpy).toHaveBeenCalledTimes(1);
++    });
++
++    it('warns on first empty call, not on second', () => {
++      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
++
++      resolveModelId(undefined);
++      expect(warnSpy).toHaveBeenCalledTimes(1);
++
++      resolveModelId(null);
++      expect(warnSpy).toHaveBeenCalledTimes(1); // same bucket
++
++      resolveModelId('');
++      expect(warnSpy).toHaveBeenCalledTimes(1); // same bucket
++    });
++
++    it('warns separately for different legacy IDs', () => {
++      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
++
++      resolveModelId('RSACLASSIC');
++      resolveModelId('Blend');
++      resolveModelId('FOO');
++      expect(warnSpy).toHaveBeenCalledTimes(3);
++    });
++
++    it('does not warn for valid model IDs', () => {
++      const warnSpy = vi.spyOn(console, 'warn').mockImplementation(() => {});
++
++      resolveModelId('VB6Exact');
++      resolveModelId('SimpleV1');
++      expect(warnSpy).not.toHaveBeenCalled();
++    });
++  });
++});
