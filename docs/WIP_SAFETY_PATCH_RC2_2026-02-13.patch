++/** Reverse maps for EngineInputs numeric codes → EngineSimConfig string enums */
++const LAYOUT_REVERSE: Record<number, EngineSimConfig['layout']> = {
++  0: 'inline', 1: 'vee', 2: 'flat',
++};
