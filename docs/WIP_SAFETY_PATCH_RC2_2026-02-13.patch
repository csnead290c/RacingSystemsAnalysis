++function analyzeETRoundingCliff(rawET: number, expectedDisplay: string): {
++  category: 'ROUNDING_CLIFF' | 'REAL_MISMATCH';
++  delta_to_flip_s: number;
++  delta_ulps_f64: number;
++  actual_display: string;
++  flip_direction: 'up' | 'down' | 'none';
++  notes: string;
