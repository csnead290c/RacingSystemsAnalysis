++// ASSIGNMENT BOUNDARY GUARANTEE TEST
++// ============================================================================
++// This test verifies that known "Single assignment hotspots" in VB6 production
++// code use vb6AssignSingle() at assignment boundaries.
++// ============================================================================
++
++/**
++ * Known Single assignment hotspots that MUST use vb6AssignSingle()
++ * These are VB6 Single variables that require truncation at assignment.
++ */
++const SINGLE_ASSIGNMENT_HOTSPOTS = [
++  // State variables (VB6: Dim ... As Single)
++  'state.time_s',
++  'state.Vel_ftps',
++  'state.Dist_ft',
++  'state.AGS_g',
++  'state.EngRPM',
++  'state.DSRPM',
++  'state.Vel0_ftps',
++  'state.Ags0_g',
++  'state.Dist0_ft',
++  // Key physics variables
++  'Vel_L',
++  'time_L',
++  'Dist_L',
++  'AGS_g',
++  'EngRPM_L',
++  'TimeStep',
++];
++
++/**
++ * Find assignments to hotspot variables and check if they use vb6AssignSingle
++ */
++function findHotspotAssignments(code: string, hotspot: string): { line: number; text: string; usesVb6Assign: boolean }[] {
++  const lines = code.split('\n');
++  const results: { line: number; text: string; usesVb6Assign: boolean }[] = [];
++  
++  // Escape special regex characters in hotspot
++  const escaped = hotspot.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
++  
++  // Pattern: hotspot = something (assignment)
++  const assignPattern = new RegExp(`${escaped}\\s*=\\s*(.+)`, 'g');
++  
++  for (let i = 0; i < lines.length; i++) {
++    const line = lines[i];
++    let match;
++    while ((match = assignPattern.exec(line)) !== null) {
++      const rhs = match[1];
++      // Check if RHS uses vb6AssignSingle
++      const usesVb6Assign = rhs.includes('vb6AssignSingle');
++      results.push({
++        line: i + 1,
++        text: line.trim(),
++        usesVb6Assign
++      });
++    }
++    assignPattern.lastIndex = 0;
++  }
++  
++  return results;
++}
