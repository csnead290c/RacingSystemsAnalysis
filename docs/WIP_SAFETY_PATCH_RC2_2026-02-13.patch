++#!/usr/bin/env python3
++"""
++Timeout wrapper for commands - kills process after N seconds and reports status
++"""
++import sys
++import subprocess
++import signal
++import time
++
++def run_with_timeout(timeout_seconds, command_args):
++    """Run command with timeout, print output, return exit code"""
++    print(f"[TIMEOUT_WRAPPER] Running command with {timeout_seconds}s timeout:")
++    print(f"[TIMEOUT_WRAPPER] {' '.join(command_args)}")
++    print(f"[TIMEOUT_WRAPPER] Starting at {time.strftime('%H:%M:%S')}")
++    print("-" * 80)
++    
++    try:
++        process = subprocess.Popen(
++            command_args,
++            stdout=subprocess.PIPE,
++            stderr=subprocess.STDOUT,
++            text=True,
++            bufsize=1
++        )
++        
++        start_time = time.time()
++        output_lines = []
++        
++        # Read output with timeout
++        while True:
++            elapsed = time.time() - start_time
++            if elapsed > timeout_seconds:
++                print(f"\n[TIMEOUT_WRAPPER] TIMEOUT after {elapsed:.1f}s - killing process")
++                process.kill()
++                process.wait()
++                print(f"[TIMEOUT_WRAPPER] Process killed")
++                print(f"[TIMEOUT_WRAPPER] Exit code: -9 (SIGKILL)")
++                return -9
++            
++            # Check if process finished
++            if process.poll() is not None:
++                # Read remaining output
++                remaining = process.stdout.read()
++                if remaining:
++                    print(remaining, end='')
++                    output_lines.append(remaining)
++                break
++            
++            # Read available output
++            line = process.stdout.readline()
++            if line:
++                print(line, end='')
++                output_lines.append(line)
++            else:
++                time.sleep(0.1)
++        
++        exit_code = process.returncode
++        elapsed = time.time() - start_time
++        
++        print("-" * 80)
++        print(f"[TIMEOUT_WRAPPER] Completed at {time.strftime('%H:%M:%S')}")
++        print(f"[TIMEOUT_WRAPPER] Duration: {elapsed:.1f}s")
++        print(f"[TIMEOUT_WRAPPER] Exit code: {exit_code}")
++        
++        return exit_code
++        
++    except Exception as e:
++        print(f"[TIMEOUT_WRAPPER] ERROR: {e}")
++        return 1
++
++if __name__ == "__main__":
++    if len(sys.argv) < 3:
++        print("Usage: run_with_timeout.py <timeout_seconds> <command> [args...]")
++        sys.exit(1)
++    
++    timeout = int(sys.argv[1])
++    command = sys.argv[2:]
++    
++    exit_code = run_with_timeout(timeout, command)
++    sys.exit(exit_code)
