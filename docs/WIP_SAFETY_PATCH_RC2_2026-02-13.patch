++  // Power mode determination
++  if (json.model === 'QuarterJr') {
++    // QuarterJr uses powerHP mode
++    if (vehicle.peakHorsepower !== undefined) {
++      rawInputs.powerHP = vehicle.peakHorsepower;
++    }
++    if (vehicle.peakHorsepowerRpm !== undefined) {
