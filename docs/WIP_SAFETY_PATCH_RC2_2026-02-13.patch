++/**
++ * Randomized Input Test
++ * 
++ * Purpose: Prevent "fixture cheating" - ensures the simulation produces
++ * reasonable outputs for random inputs, not just hardcoded fixture values.
++ * 
++ * This test generates random vehicle/environment parameters within valid ranges
++ * and verifies the simulation produces physically plausible results.
++ */
++
++import { describe, it, expect } from 'vitest';
++import { simulateVB6Exact } from '../domain/physics/models/vb6Exact';
++import type { SimInputs } from '../domain/physics';
++
++/**
++ * Generate random number in range [min, max]
++ */
++function randomInRange(min: number, max: number): number {
++  return min + Math.random() * (max - min);
++}
++
++/**
++ * Generate random integer in range [min, max]
++ */
++function randomIntInRange(min: number, max: number): number {
++  return Math.floor(randomInRange(min, max + 1));
++}
++
++/**
++ * Generate random vehicle inputs within physically valid ranges
++ */
++function generateRandomVehicleInputs(): SimInputs {
++  // Random weight: 1500-4000 lbs (typical drag car range)
++  const weightLb = randomInRange(1500, 4000);
++  
++  // Random tire diameter: 26-34 inches
++  const tireDiameterIn = randomInRange(26, 34);
++  
++  // Random rear gear: 3.5-5.5
++  const rearGear = randomInRange(3.5, 5.5);
++  
++  // Random wheelbase: 90-130 inches
++  const wheelbaseIn = randomInRange(90, 130);
++  
++  // Random HP: 300-1500
++  const peakHP = randomInRange(300, 1500);
++  const peakRPM = randomIntInRange(6000, 9000);
++  
++  // Generate simple HP curve
++  const hpCurve = [];
++  for (let rpm = peakRPM - 2000; rpm <= peakRPM + 500; rpm += 250) {
++    // Parabolic curve peaking at peakRPM
++    const rpmDiff = rpm - peakRPM;
++    const hpFactor = 1 - (rpmDiff * rpmDiff) / (2500 * 2500);
++    const hp = peakHP * Math.max(0.6, hpFactor);
++    hpCurve.push({ rpm, hp });
++  }
++  
++  // Random gear ratios (3-5 gears)
++  const numGears = randomIntInRange(3, 5);
++  const gearRatios: number[] = [];
++  const shiftRPM: number[] = [];
++  let ratio = randomInRange(2.2, 3.0); // First gear
++  for (let i = 0; i < numGears; i++) {
++    gearRatios.push(ratio);
++    shiftRPM.push(i < numGears - 1 ? peakRPM + randomIntInRange(0, 400) : 0);
++    ratio *= randomInRange(0.7, 0.85); // Gear step
++  }
++  
++  // Random launch device (clutch or converter)
++  const useClutch = Math.random() > 0.5;
++  
++  const vehicle: any = {
++    weightLb,
++    tireDiameterIn,
++    rearGear,
++    wheelbaseIn,
++    frontalArea_ft2: randomInRange(15, 30),
++    cd: randomInRange(0.2, 0.5),
++    engine: { hpCurve },
++    gearRatios,
++    shiftRPM,
++    tireWidthIn: randomInRange(10, 18),
++  };
++  
++  if (useClutch) {
++    vehicle.clutch = {
++      launchRPM: peakRPM - randomIntInRange(500, 1500),
++      slipRPM: peakRPM - randomIntInRange(0, 1000),
++      slippage: randomInRange(1.0, 1.01),
++    };
++  } else {
++    vehicle.converter = {
++      stallRPM: randomIntInRange(3000, 5000),
++      lockup: Math.random() > 0.5,
++    };
++  }
++  
++  // Random environment
++  const env = {
++    elevation: randomInRange(0, 5000),
++    temperatureF: randomInRange(50, 100),
++    barometerInHg: randomInRange(28, 31),
++    humidityPct: randomInRange(20, 80),
++    windMph: randomInRange(0, 15),
++    windAngleDeg: randomInRange(0, 360),
++    trackTempF: randomInRange(70, 130),
++    tractionIndex: randomIntInRange(1, 5),
++  };
++  
++  return {
++    vehicle,
++    env,
++    raceLength: 'QUARTER',
++    vb6Strict: true,
++    applyVB6Rounding: true,
++  };
++}
++
++describe('Randomized Input Tests', () => {
++  
++  it('should produce physically plausible results for random inputs', () => {
++    // Run 10 random simulations
++    const numTrials = 10;
++    const results: Array<{ et: number; mph: number; hp: number; weight: number }> = [];
++    
++    for (let trial = 0; trial < numTrials; trial++) {
++      const inputs = generateRandomVehicleInputs();
++      
++      try {
++        const result = simulateVB6Exact(inputs);
++        
++        // Extract final results
++        const timeslipRows = (result as any).timeslipRows || [];
++        const finalRow = timeslipRows.find((r: any) => 
++          r.label === '1320ft' || r.distance_ft === 1320
++        );
++        
++        if (finalRow) {
++          results.push({
++            et: finalRow.time_s,
++            mph: finalRow.mph,
++            hp: inputs.vehicle.engine?.hpCurve?.[Math.floor(inputs.vehicle.engine.hpCurve.length / 2)]?.hp || 0,
++            weight: inputs.vehicle.weightLb,
++          });
++        }
++      } catch (e) {
++        // Some random combinations may not be valid - that's OK
++        console.log(`Trial ${trial} failed: ${(e as Error).message}`);
++      }
++    }
++    
++    console.log(`\n========================================`);
++    console.log(`RANDOMIZED INPUT TEST RESULTS`);
++    console.log(`========================================\n`);
++    console.log(`Successful trials: ${results.length}/${numTrials}`);
++    
++    // Verify we got some successful results
++    expect(results.length).toBeGreaterThan(0);
++    
++    // Verify results are physically plausible
++    for (const r of results) {
++      console.log(`  ET: ${r.et.toFixed(2)}s, MPH: ${r.mph.toFixed(1)}, HP: ${r.hp.toFixed(0)}, Weight: ${r.weight.toFixed(0)}lb`);
++      
++      // Quarter mile ET should be between 4-20 seconds for reasonable cars
++      expect(r.et).toBeGreaterThan(4);
++      expect(r.et).toBeLessThan(20);
++      
++      // Trap speed should be between 80-200 mph
++      expect(r.mph).toBeGreaterThan(80);
++      expect(r.mph).toBeLessThan(250);
++    }
++    
++    console.log(`\n✓ All results within physically plausible ranges`);
++    console.log(`  This confirms the simulation is not fixture-cheating.\n`);
++  });
++  
++  it('should produce monotonically increasing distance over time', () => {
++    const inputs = generateRandomVehicleInputs();
++    
++    const result = simulateVB6Exact(inputs);
++    const timeslipRows = (result as any).timeslipRows || [];
++    
++    // Filter to distance-based checkpoints (exclude staged/rollout)
++    const distanceRows = timeslipRows.filter((r: any) => 
++      r.distance_ft !== null && r.distance_ft > 0 && r.event_type === 'distance'
++    );
++    
++    console.log(`\nMonotonicity check: ${distanceRows.length} distance rows`);
++    
++    // Verify distances are monotonically increasing
++    for (let i = 1; i < distanceRows.length; i++) {
++      const prev = distanceRows[i - 1];
++      const curr = distanceRows[i];
++      
++      if (curr.distance_ft < prev.distance_ft) {
++        console.error(`Distance decreased at row ${i}: ${prev.distance_ft}ft -> ${curr.distance_ft}ft`);
++      }
++      
++      expect(curr.distance_ft).toBeGreaterThanOrEqual(prev.distance_ft);
++    }
++    
++    console.log(`✓ All distances monotonically increasing\n`);
++  });
++  
++  it('should have consistent event_type and seq metadata', () => {
++    const inputs = generateRandomVehicleInputs();
++    
++    const result = simulateVB6Exact(inputs);
++    const timeslipRows = (result as any).timeslipRows || [];
++    
++    console.log(`\nEvent metadata check: ${timeslipRows.length} rows`);
++    
++    // Verify all rows have event metadata
++    let hasMetadata = 0;
++    let missingMetadata = 0;
++    
++    for (const row of timeslipRows) {
++      if (row.event_type !== undefined && row.seq !== undefined) {
++        hasMetadata++;
++      } else {
++        missingMetadata++;
++        console.log(`  Missing metadata: ${row.label} (event_type=${row.event_type}, seq=${row.seq})`);
++      }
++    }
++    
++    console.log(`  With metadata: ${hasMetadata}`);
++    console.log(`  Missing metadata: ${missingMetadata}`);
++    
++    // All rows should have metadata
++    expect(hasMetadata).toBe(timeslipRows.length);
++    
++    // Verify seq is monotonically increasing
++    for (let i = 1; i < timeslipRows.length; i++) {
++      const prev = timeslipRows[i - 1];
++      const curr = timeslipRows[i];
++      
++      if (prev.seq !== undefined && curr.seq !== undefined) {
++        expect(curr.seq).toBeGreaterThan(prev.seq);
++      }
++    }
++    
++    console.log(`✓ All rows have consistent event metadata\n`);
++  });
++});
