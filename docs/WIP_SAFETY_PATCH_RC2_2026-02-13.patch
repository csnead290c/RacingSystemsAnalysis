++/**
++ * STEP 2: Raw Interval Helpers for Display Values
++ * 
++ * Given a displayed value (after VB6 banker's rounding), compute the interval
++ * of raw values that would display to that value.
++ * 
++ * CRITICAL: Must account for banker's rounding tie behavior (round-half-to-even)
++ */
++
++/**
++ * Float32 cast helper
++ */
++function f32(x: number): number {
++  const arr = new Float32Array(1);
++  arr[0] = x;
++  return arr[0];
++}
++
++/**
++ * Banker's rounding (round-half-to-even)
++ */
++function bankersRound(value: number, decimals: number): number {
++  const factor = Math.pow(10, decimals);
++  const scaled = value * factor;
++  const floor = Math.floor(scaled);
++  const frac = scaled - floor;
++  
++  const isHalf = Math.abs(frac - 0.5) < 1e-10;
++  
++  if (isHalf) {
++    return (floor % 2 === 0 ? floor : floor + 1) / factor;
++  }
++  
++  return Math.round(scaled) / factor;
++}
++
++/**
++ * Get the interval of raw ET values (Float64) that display to the given value
++ * when formatted with banker's rounding to 2 decimals.
++ * 
++ * @param displayValue The displayed ET value (e.g., 4.37)
++ * @returns {lo, hi} interval where any raw ET in [lo, hi) displays to displayValue
++ */
++export function getRawIntervalForDisplayedET(displayValue: number): { lo: number; hi: number } {
++  const scale = 100; // 2 decimals
++  const targetScaled = Math.round(displayValue * scale);
++  const isEven = targetScaled % 2 === 0;
