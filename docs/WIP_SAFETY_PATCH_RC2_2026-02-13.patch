++++ b/src/integration-tests/helpers/semantics_forensic_audit.ts
+@@ -0,0 +1,293 @@
++/**
++ * Forensic Semantics Audit
++ * 
++ * CRITICAL: Prove JSON semantics with NUMERIC EVIDENCE, not inference.
++ * Compare MODE 1 (ABS) vs MODE 2 (TRACK) and score which matches VB6 better.
++ */
++
++export interface SemanticsAuditResult {
++  caseId: string;
++  rolloutIn: number;
++  rolloutFt: number;
++  
++  // Time semantics proof
++  timeProof: {
++    mode: 'ET_POST_ROLLOUT' | 'ABSOLUTE' | 'AMBIGUOUS';
++    etScore: number;
++    absScore: number;
++    evidence: Array<{
++      checkpoint: string;
++      jsonTime: number;
++      simET: number;
++      simAbs: number;
++      errorET: number;
++      errorAbs: number;
++    }>;
++  };
++  
++  // Distance semantics proof
++  distanceProof: {
++    mode: 'TRACK_POST_ROLLOUT' | 'ABSOLUTE' | 'AMBIGUOUS';
++    trackScore: number;
++    absScore: number;
++    evidence: Array<{
++      checkpoint: string;
++      jsonDist: number;
++      mode1_trackDist: number;
++      mode2_absDist: number;
++      mode1_errors: { time: number; mph: number; rpm: number };
++      mode2_errors: { time: number; mph: number; rpm: number };
++    }>;
++  };
++}
++
++/**
++ * Conduct forensic audit of JSON semantics
++ */
++export async function conductSemanticsAudit(
++  caseId: string,
++  rolloutIn: number,
++  jsonCheckpoints: any[],
++  simTrace: Array<{ dist_ft: number; time_s?: number; time_et_s?: number; mph: number; rpm: number; gear: number }>
++): Promise<SemanticsAuditResult> {
++  
++  const rolloutFt = rolloutIn / 12;
++  
++  // Get time from trace (prefer time_et_s which is already ET)
++  const getTraceTime = (row: any) => row.time_et_s ?? row.time_s ?? 0;
++  
++  // ========================================================================
++  // STEP 1: Prove TIME semantics (ET vs ABSOLUTE)
++  // ========================================================================
++  
++  // Find timerStartTime_s by locating rollout in trace
++  // Trace uses trackDist (0 at rollout), so rollout is at dist≈0
++  let timerStartTime_s = 0;
++  let rolloutTraceRow = null;
++  
