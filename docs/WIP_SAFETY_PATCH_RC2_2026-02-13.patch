++      console.log(`  ✓ Resolved inputs captured`);
++      console.log(`  ✓ Integration steps: ${diagnostic.integrationSteps.length}`);
++      console.log(`  ✓ Emitted rows: ${diagnostic.emittedTable.length}`);
++      console.log(`  ✓ Expected rows: ${diagnostic.expectedTable.length}`);
++      
++      if (diagnostic.firstMismatch) {
