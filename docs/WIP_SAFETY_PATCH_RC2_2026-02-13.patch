++
++function sortAssets(assets: ClutchAsset[], key: SortKey): ClutchAsset[] {
++  const sorted = [...assets];
++  switch (key) {
++    case 'updated':
++      return sorted.sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
++    case 'name':
++      return sorted.sort((a, b) => a.name.localeCompare(b.name));
++  }
++}
++
++function getAssetSummary(asset: ClutchAsset): string {
++  switch (asset.kind) {
++    case 'sim': {
++      const s = asset.payload.clutchSimResultSummary;
++      return `Slip ${s.slipRPM} RPM • Launch ${s.launchRPM} RPM`;
++    }
++    case 'manual':
++    case 'measured': {
++      const p = asset.payload;
++      const parts: string[] = [`Slip ${p.slipRPM} RPM`];
++      if (p.launchRPM != null) parts.push(`Launch ${p.launchRPM} RPM`);
++      return parts.join(' • ');
++    }
++  }
++}
