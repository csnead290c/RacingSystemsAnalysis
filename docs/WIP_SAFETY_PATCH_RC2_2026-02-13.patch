++ * Defines the types for the Four-Link (rear suspension) Asset ecosystem,
++ * following the same install/override pattern as Engine Assets.
++ *
++ * Three kinds of four-link assets:
++ *  - "sim"          — created from Four-Link Sim (full config + result summary)
++ *  - "manual"       — user-entered geometry parameters
++ *  - "measured"     — data from real-world measurement
++ *
++ * Design mirrors engineAssets.ts:
++ *  - Scope: "personal" | "team"
++ *  - Revision number for pinned references
++ *  - Override patch for tweaking without modifying the original asset
++ */
++
++// ── Enums / Literals ────────────────────────────────────────────────
++
++export type FourLinkAssetScope = 'personal' | 'team';
++export type FourLinkAssetKind = 'sim' | 'manual' | 'measured';
++
++// ── Base ────────────────────────────────────────────────────────────
++
++export interface FourLinkAssetBase {
++  id: string;
++  name: string;
++  scope: FourLinkAssetScope;
++  kind: FourLinkAssetKind;
++  tags?: string[];
++  notes?: string;
++  createdAt: string;   // ISO-8601
++  updatedAt: string;   // ISO-8601
++  createdByUserId?: string;
++  revision: number;    // starts at 1, increments on update
++}
++
++// ── Payloads ────────────────────────────────────────────────────────
++
++export interface FourLinkAssetSimPayload {
++  /** Placeholder — will hold full Four-Link Sim config when that sim ships */
++  fourLinkSimConfig: Record<string, unknown>;
++  fourLinkSimResultSummary: FourLinkResultSummary;
++}
++
++export interface FourLinkResultSummary {
++  instantCenterIn: number;      // Instant center height (inches)
++  antiSquatPct: number;         // Anti-squat percentage
