++/**
++ * Classic JSON Fixture Validation Tests
++ * Validates that JSON conversions match existing PDF-extracted fixtures
++ */
++
++import { describe, it, expect } from 'vitest';
++import { loadClassicJsonCase } from './helpers/classic_json_loader';
++import { jsonToClassicRawInputs } from './helpers/classic_json_to_classicraw';
++import { normalizeJsonPdfCheckpoints } from './helpers/classic_json_outputs_to_fixture';
++import { CLASSIC_RAW_INPUT_CASES } from './fixtures/classic_raw_inputs_extracted';
++import { QUARTERJR_CHECKPOINTS_EXTRACTED } from './fixtures/quarterjr_v32_checkpoints_extracted';
++import { QUARTERPRO_CHECKPOINTS_EXTRACTED } from './fixtures/quarterpro_checkpoints_extracted';
++
++interface ValidationResult {
++  passed: boolean;
++  errors: string[];
++}
++
++function compareScalarField(
++  caseId: string,
++  fieldName: string,
++  expected: any,
++  actual: any,
++  tolerance: number = 1e-6
++): string | null {
++  // Handle null/undefined
++  if (expected === null || expected === undefined) {
++    if (actual === null || actual === undefined) {
++      return null;
++    }
++    return `${caseId}.${fieldName}: expected ${expected}, got ${actual}`;
++  }
++  
++  if (actual === null || actual === undefined) {
++    return `${caseId}.${fieldName}: expected ${expected}, got ${actual}`;
++  }
++  
++  // Handle numbers with tolerance
++  if (typeof expected === 'number' && typeof actual === 'number') {
++    if (Math.abs(expected - actual) > tolerance) {
++      return `${caseId}.${fieldName}: expected ${expected}, got ${actual} (diff: ${Math.abs(expected - actual)})`;
++    }
++    return null;
++  }
++  
++  // Handle booleans and strings
++  if (expected !== actual) {
++    return `${caseId}.${fieldName}: expected ${expected}, got ${actual}`;
++  }
++  
++  return null;
++}
++
++function validateInputs(caseId: string, jsonInputs: any, fixtureInputs: any): ValidationResult {
++  const errors: string[] = [];
++  
++  // Define fields to compare (from fixture)
++  const fieldsToCompare = [
++    'elevation',
++    'barometerInHg',
++    'temperatureF',
++    'humidityPct',
++    'tractionIndex',
++    'weightLb',
++    'wheelbaseIn',
++    'rolloutIn',
++    'rearGear',
++    'tireDiaIn',
++    'tireRolloutIn',
++    'tireWidthIn',
++    'frontalArea_ft2',
++    'dragCoeff',
++    'drivetrainMode',
++    'lockupOption',
++    'stallRpm',
++    'slipRpm',
++    'powerHP',
++    'peakHPRPM',
++    'hpTorqueMultiplier'
++  ];
++  
++  for (const field of fieldsToCompare) {
++    // Skip if field not in fixture
++    if (!(field in fixtureInputs)) {
++      continue;
++    }
++    
++    const expected = fixtureInputs[field];
++    const actual = jsonInputs[field];
++    
++    const error = compareScalarField(caseId, field, expected, actual);
++    if (error) {
++      errors.push(error);
++    }
++  }
++  
++  // Compare hpCurve if present
++  if (fixtureInputs.hpCurve && Array.isArray(fixtureInputs.hpCurve)) {
++    if (!jsonInputs.hpCurve || !Array.isArray(jsonInputs.hpCurve)) {
++      errors.push(`${caseId}.hpCurve: expected array, got ${typeof jsonInputs.hpCurve}`);
++    } else {
++      if (fixtureInputs.hpCurve.length !== jsonInputs.hpCurve.length) {
++        errors.push(`${caseId}.hpCurve: expected ${fixtureInputs.hpCurve.length} points, got ${jsonInputs.hpCurve.length}`);
++      } else {
++        for (let i = 0; i < fixtureInputs.hpCurve.length; i++) {
++          const expPt = fixtureInputs.hpCurve[i];
