++/**
++ * Classic JSON Simulation Runner
++ * Runs physics simulation for JSON test cases
++ */
++
++import { simulateVB6Exact } from '../../domain/physics/models/vb6Exact';
++import type { SimResult } from '../../domain/physics';
++import type { ClassicJsonCase } from '../json-fixtures/classic_json_case_types';
++import { buildSimInputsFromClassicJson } from './classic_json_to_sim_inputs';
++
++export interface JsonSimTrace {
++  t_s: number;
++  s_ft: number;
++  v_mph: number;
++  a_g: number;
++  rpm: number;
++  gear: number;
++}
++
++export interface JsonSimRolloutInfo {
++  rolloutIn: number;
++  t_roll_s: number;
++  mph_at_rollout: number;
++  rpm_at_rollout: number;
++  gear_at_rollout: number;
++}
++
++export interface JsonSimResult {
++  trace: JsonSimTrace[];
++  rolloutInfo: JsonSimRolloutInfo | null;
++  simResult: SimResult;
++}
++
++export function runClassicJsonCase(jsonCase: ClassicJsonCase): JsonSimResult {
++  // Build SimInputs from JSON
++  const simInputs = buildSimInputsFromClassicJson(jsonCase);
++  
++  // Run VB6Exact simulation
++  const simResult: SimResult = simulateVB6Exact(simInputs);
++  
++  // Extract trace data
++  const trace: JsonSimTrace[] = [];
++  
++  if (simResult.traces && simResult.traces.length > 0) {
++    // Use detailed traces if available
++    for (const row of simResult.traces) {
++      trace.push({
++        t_s: row.t_s,
++        s_ft: row.s_ft,
++        v_mph: row.v_mph,
++        a_g: row.a_g,
++        rpm: row.rpm,
++        gear: row.gear,
++      });
++    }
++  } else {
++    // Fall back to timeslip data
++    for (const row of simResult.timeslip) {
++      trace.push({
++        t_s: row.t_s,
++        s_ft: row.d_ft,
++        v_mph: row.v_mph,
++        a_g: 0, // Not available in timeslip
++        rpm: 0,
++        gear: 0,
++      });
++    }
++  }
++  
++  // Extract rollout info if available
++  let rolloutInfo: JsonSimRolloutInfo | null = null;
++  if (simResult.meta.rollout) {
++    const rolloutIn = simResult.meta.rollout.rolloutIn;
++    const t_roll_s = simResult.meta.rollout.t_roll_s;
++    
++    // Find trace point at rollout
++    const rolloutPoint = trace.find(pt => pt.s_ft >= rolloutIn / 12); // Convert inches to feet
++    
++    if (rolloutPoint) {
++      rolloutInfo = {
++        rolloutIn: rolloutIn,
++        t_roll_s: t_roll_s,
++        mph_at_rollout: rolloutPoint.v_mph,
++        rpm_at_rollout: rolloutPoint.rpm,
++        gear_at_rollout: rolloutPoint.gear,
++      };
++    }
++  }
++  
++  return {
++    trace,
++    rolloutInfo,
++    simResult,
++  };
++}
