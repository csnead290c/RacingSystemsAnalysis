++export function getCheckpointsForRaceLength(
++  configName: string,
++  raceLength: 'EIGHTH' | 'QUARTER' | 'THOUSAND'
++): Checkpoint[] {
++  const caseData = QUARTERJR_CHECKPOINTS_EXTRACTED.find(c => c.configName === configName);
