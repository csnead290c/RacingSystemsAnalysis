++  const min = roundTo(throttleDia / 2, 3);
++  const max = roundTo(throttleDia, 3);
++  let clamped = v;
++  if (clamped < min) clamped = min;
++  if (clamped > max) clamped = max;
++  return roundTo(clamped, 3);
++}
++
++/**
