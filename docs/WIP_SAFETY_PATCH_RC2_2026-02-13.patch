++async function diagnoseCas(caseId: string, filename: string, model: ModelName): Promise<DiagnosticCase> {
++  // Load fixture
++  const jsonCase = await import(`../json-fixtures/${filename}`).then(m => m.default);
++  
++  // Detect if this is a Bonneville case where distance_ft is actually in miles
++  const isBonneville = model.includes('Bonneville') || 
++                       jsonCase.inputs?.track?.includes('Bonneville') ||
++                       (jsonCase.outputs?.pdfCheckpoints?.length > 0 && 
++                        jsonCase.outputs.pdfCheckpoints.some((cp: any) => cp.distance_ft > 0 && cp.distance_ft < 10));
