++import { normalizeClassicCase } from '../helpers/classic_input_normalize';
++import type { ModelName } from '../helpers/classic_types';
++
++interface StepSnapshot {
++  step: number;
++  time_s: number;
++  time_abs_s: number;
++  dist_ft: number;
++  dist_abs_ft: number;
++  vel_fps: number;
++  accel_ftps2: number;
++  accel_g: number;
++  gear: number;
++  rpm: number;
++  engine_hp: number;
++  engine_tq: number;
++  wheel_tq: number;
++  tire_force: number;
++  drag_force: number;
++  roll_force: number;
++  net_force: number;
++  clutch_slip?: number;
++  converter_slip?: number;
++}
++
++interface FirstDivergence {
++  case_id: string;
++  step_index: number;
++  ts_snapshot: StepSnapshot;
++  vb6_snapshot: StepSnapshot;
++  deltas: Record<string, number>;
++  vb6_source: {
++    file: string;
++    function: string;
++    line_range: string;
++  };
++  torque_breakdown: {
++    ts: Record<string, number>;
++    vb6: Record<string, number>;
++  };
++  force_breakdown: {
++    ts: Record<string, number>;
++    vb6: Record<string, number>;
++  };
++}
++
++/**
++ * Capture step-by-step trace from TS simulation
++ */
++function captureStepTrace(caseId: string, model: ModelName): StepSnapshot[] {
++  const steps: StepSnapshot[] = [];
++  
++  // Load fixture and build inputs
++  const jsonCase = require(`../json-fixtures/${caseId}.json`);
++  const rawInputs = jsonToClassicRawInputs(jsonCase);
++  const pdfCheckpoints = jsonCase.outputs.pdfCheckpoints;
++  const normalized = normalizeClassicCase(caseId, model, rawInputs, pdfCheckpoints);
++  const effectiveInputs = normalized.effective;
++  // Build sim inputs directly from effective inputs
++  const simInputs = {
++    vehicle: effectiveInputs,
++    env: rawInputs,
++    vb6Strict: true,
++  } as any;
++  
++  // Monkey-patch to capture step data
++  const originalLog = console.log;
++  let stepIndex = 0;
++  
++  console.log = (...args: any[]) => {
++    const msg = args[0];
++    if (typeof msg === 'string' && msg.includes('[vb6Step]')) {
++      // Parse step log to extract state
++      // This is a simplified parser - real implementation would need more robust parsing
++      const stepData = parseStepLog(msg, stepIndex++);
++      if (stepData) {
++        steps.push(stepData);
++      }
++    }
++    originalLog(...args);
++  };
++  
++  // Run simulation
++  simulateVB6Exact(simInputs);
++  
++  console.log = originalLog;
++  
++  return steps;
++}
++
++/**
++ * Parse step log message to extract state snapshot
++ */
++function parseStepLog(msg: string, stepIndex: number): StepSnapshot | null {
++  // This is a placeholder - actual implementation would parse the log format
++  // For now, return null to indicate we need actual step logging
++  return null;
++}
++
++/**
++ * Load VB6 reference trace
++ * 
++ * NOTE: This requires VB6 reference data to be pre-generated and stored.
++ * The VB6 executable should output step-by-step CSV traces.
++ */
++function loadVB6Reference(caseId: string): StepSnapshot[] {
++  // Check for pre-generated VB6 reference trace
++  const refPath = `./fixtures/vb6_step_traces/${caseId}_vb6_steps.csv`;
++  
++  try {
++    const fs = require('fs');
++    const csv = fs.readFileSync(refPath, 'utf-8');
++    return parseVB6CSV(csv);
++  } catch (e) {
++    console.error(`VB6 reference trace not found: ${refPath}`);
++    console.error('You must generate VB6 reference traces first by running VB6 with step logging enabled.');
++    return [];
++  }
++}
++
++/**
++ * Parse VB6 CSV trace
++ */
++function parseVB6CSV(csv: string): StepSnapshot[] {
++  const lines = csv.trim().split('\n');
++  const headers = lines[0].split(',').map(h => h.trim());
++  const steps: StepSnapshot[] = [];
++  
++  for (let i = 1; i < lines.length; i++) {
++    const values = lines[i].split(',');
++    const row: any = {};
++    
++    for (let j = 0; j < headers.length; j++) {
++      const h = headers[j];
++      const v = values[j]?.trim();
++      if (v !== undefined && v !== '') {
++        row[h] = parseFloat(v);
++      }
++    }
++    
++    steps.push(row as StepSnapshot);
++  }
++  
++  return steps;
++}
++
++/**
++ * Find first divergence between TS and VB6 traces
++ */
++function findFirstDivergence(
++  caseId: string,
++  tsSteps: StepSnapshot[],
++  vb6Steps: StepSnapshot[]
++): FirstDivergence | null {
++  const eps = 1e-6; // Tolerance for floating-point comparison
++  
++  const n = Math.min(tsSteps.length, vb6Steps.length);
++  
++  for (let i = 0; i < n; i++) {
++    const ts = tsSteps[i];
++    const vb6 = vb6Steps[i];
++    
++    // Compare key fields
++    const deltas: Record<string, number> = {};
++    const fields: (keyof StepSnapshot)[] = [
++      'time_s', 'dist_ft', 'vel_fps', 'accel_g', 'rpm', 'gear',
++      'engine_hp', 'engine_tq', 'wheel_tq', 'tire_force', 'drag_force'
++    ];
++    
++    for (const field of fields) {
++      const tsVal = ts[field] as number ?? 0;
++      const vb6Val = vb6[field] as number ?? 0;
++      const delta = Math.abs(tsVal - vb6Val);
++      
++      if (delta > eps) {
++        deltas[field] = tsVal - vb6Val;
++      }
++    }
++    
++    if (Object.keys(deltas).length > 0) {
++      // Found first divergence
++      return {
++        case_id: caseId,
++        step_index: i,
++        ts_snapshot: ts,
++        vb6_snapshot: vb6,
++        deltas,
++        vb6_source: identifyVB6Source(caseId, i, deltas),
++        torque_breakdown: {
++          ts: {
++            engine_tq: ts.engine_tq ?? 0,
++            wheel_tq: ts.wheel_tq ?? 0,
++          },
++          vb6: {
++            engine_tq: vb6.engine_tq ?? 0,
++            wheel_tq: vb6.wheel_tq ?? 0,
++          }
++        },
++        force_breakdown: {
++          ts: {
++            tire_force: ts.tire_force ?? 0,
++            drag_force: ts.drag_force ?? 0,
++            roll_force: ts.roll_force ?? 0,
++            net_force: ts.net_force ?? 0,
++          },
++          vb6: {
++            tire_force: vb6.tire_force ?? 0,
++            drag_force: vb6.drag_force ?? 0,
++            roll_force: vb6.roll_force ?? 0,
++            net_force: vb6.net_force ?? 0,
++          }
++        }
++      };
++    }
++  }
++  
++  return null;
++}
++
++/**
++ * Identify VB6 source file/function responsible for divergence
++ */
++function identifyVB6Source(caseId: string, stepIndex: number, deltas: Record<string, number>): {
++  file: string;
++  function: string;
++  line_range: string;
++} {
++  // Map divergence fields to VB6 source locations
++  const divergentFields = Object.keys(deltas);
++  
++  if (divergentFields.includes('engine_hp') || divergentFields.includes('engine_tq')) {
++    return {
++      file: 'TIMESLIP.FRM',
++      function: 'EngineCalc',
++      line_range: '2100-2250'
++    };
++  }
++  
++  if (divergentFields.includes('tire_force') || divergentFields.includes('wheel_tq')) {
++    return {
++      file: 'TIMESLIP.FRM',
++      function: 'TireForceCalc',
++      line_range: '1800-1950'
++    };
++  }
++  
++  if (divergentFields.includes('drag_force')) {
++    return {
++      file: 'TIMESLIP.FRM',
++      function: 'AeroCalc',
++      line_range: '1700-1750'
++    };
++  }
++  
++  if (divergentFields.includes('accel_g') || divergentFields.includes('vel_fps')) {
++    return {
++      file: 'TIMESLIP.FRM',
++      function: 'IntegrationStep',
++      line_range: '2500-2650'
++    };
++  }
++  
++  return {
++    file: 'TIMESLIP.FRM',
++    function: 'SimulationLoop',
++    line_range: '1000-3000'
++  };
++}
++
++/**
++ * Write divergence reports
++ */
++function writeReports(caseId: string, divergence: FirstDivergence | null, tsSteps: StepSnapshot[], vb6Steps: StepSnapshot[]) {
++  // Write first_divergence.json
