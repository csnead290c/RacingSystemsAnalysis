++  const scale = 100; // 2 decimals
++  const expectedValue = parseFloat(expectedDisplay);
++  const actualRounded = bankersRound(rawET, 2);
++  const actualDisplay = actualRounded.toFixed(2);
++  
++  // Determine which direction we need to flip
++  let flip_direction: 'up' | 'down' | 'none' = 'none';
++  let targetValue = expectedValue;
++  
++  if (actualRounded < expectedValue) {
++    flip_direction = 'up';
++    targetValue = expectedValue;
++  } else if (actualRounded > expectedValue) {
++    flip_direction = 'down';
++    targetValue = expectedValue;
++  }
++  
++  // Find the exact flip boundary using banker's rounding rules
++  // For banker's rounding, the boundary depends on whether we're rounding to even
++  let flipBoundary: number;
++  
++  if (flip_direction === 'up') {
++    // We need to find the smallest value that rounds UP to targetValue
++    // This is targetValue - 0.005 if targetValue/0.01 is even, else targetValue - 0.0049999...
++    const targetScaled = Math.round(targetValue * scale);
