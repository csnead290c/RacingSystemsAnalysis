++/**
++ * Compute derived mph from Δdist/Δtime between the two bracketing raw trace
++ * points around a target distance. This gives the "average speed over the
++ * local trace interval" — a sanity check independent of the trace's v_mph.
++ *
++ * Returns null if target is outside trace range or trace has < 2 points.
++ */
++function derivedMphAtDist(
++  targetDist_ft: number,
++  rawTraces: Array<{ s_ft: number; t_s: number }>,
++): number | null {
++  if (rawTraces.length < 2) return null;
++
++  // Find bracketing pair
++  for (let i = 0; i < rawTraces.length - 1; i++) {
++    const a = rawTraces[i];
++    const b = rawTraces[i + 1];
++    if (a.s_ft <= targetDist_ft && b.s_ft >= targetDist_ft) {
++      const dt = b.t_s - a.t_s;
++      if (dt <= 0) return null;
++      const ds_ft = b.s_ft - a.s_ft;
++      // average speed over this interval in mph
++      return (ds_ft / dt) * (3600 / 5280);
++    }
++  }
++  return null;
++}
