++        };
++        
++        const input = buildSimInputs(configName, raceLength);
++        const result = simulateVB6Exact(input);
++        const analysis = compareCheckpoints(result, checkpointCase);
++        
++        // Compute current metrics
++        const dt_values = analysis.comparisons.map(c => c.dt_ms).filter((v): v is number => v !== null);
++        const abs_dt_values = dt_values.map(Math.abs);
++        abs_dt_values.sort((a, b) => a - b);
++        
++        const current_median = abs_dt_values.length > 0 ? abs_dt_values[Math.floor(abs_dt_values.length / 2)] : 0;
++        const current_max = abs_dt_values.length > 0 ? abs_dt_values[abs_dt_values.length - 1] : 0;
++        const current_dt_660 = analysis.comparisons.find(c => Math.abs(c.checkpoint.dist_ft - 660) < 1)?.dt_ms ?? null;
++        const current_dt_1320 = analysis.comparisons.find(c => Math.abs(c.checkpoint.dist_ft - 1320) < 1)?.dt_ms ?? null;
++        
++        // Check median drift
++        const median_delta = current_median - baseline.median_abs_dt_ms;
++        if (median_delta > REGRESSION_THRESHOLDS.median_abs_dt_ms_tolerance) {
++          failures.push(`${caseName}: Median drift worsened by ${median_delta.toFixed(1)}ms (${baseline.median_abs_dt_ms.toFixed(1)} → ${current_median.toFixed(1)})`);
++        }
++        
++        // Check max drift
++        const max_delta = current_max - baseline.max_abs_dt_ms;
++        if (max_delta > REGRESSION_THRESHOLDS.max_abs_dt_ms_tolerance) {
++          failures.push(`${caseName}: Max drift worsened by ${max_delta.toFixed(1)}ms (${baseline.max_abs_dt_ms.toFixed(1)} → ${current_max.toFixed(1)})`);
++        }
++        
