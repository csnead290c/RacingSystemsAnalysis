++/**
++ * VB6 Display Pipeline Proof - QuarterPro Summary MPH
++ * 
++ * GOAL: Determine the ACTUAL VB6 pipeline for formatting trap MPH.
++ * 
++ * We know:
++ * - Trap MPH computed as: mph = 45.0 / dt (where dt = t_finish - t_save)
++ * - VB6 uses Single (Float32) for dt and mph in trap calculation
++ * - VB6 Format$() applies banker's rounding
++ * 
++ * QUESTION: Does VB6 Format$() operate on:
++ * V1: The Single value directly (banker's rounding in Single precision)?
++ * V2: The Single promoted to Double (banker's rounding in Double precision)?
++ * 
++ * This test creates controlled Float32 values near tie points and compares
++ * the two formatting pipelines to determine which matches VB6 behavior.
++ */
++
++import { describe, it, expect } from 'vitest';
++
++/**
++ * Float32 cast helper
++ */
++function f32(x: number): number {
++  const arr = new Float32Array(1);
++  arr[0] = x;
++  return arr[0];
++}
++
++/**
++ * Banker's rounding (round-half-to-even)
++ */
++function bankersRound(value: number, decimals: number): number {
++  const factor = Math.pow(10, decimals);
++  const scaled = value * factor;
++  const floor = Math.floor(scaled);
++  const frac = scaled - floor;
++  
++  const isHalf = Math.abs(frac - 0.5) < 1e-10;
++  
++  if (isHalf) {
++    return (floor % 2 === 0 ? floor : floor + 1) / factor;
++  }
++  
++  return Math.round(scaled) / factor;
++}
++
++/**
++ * V1: Format from Single directly
++ * Banker's rounding operates on the Float32 value as-is (in Float64 representation)
++ */
++function formatMPH_V1(mph_single: number): string {
++  // mph_single is already Float32 precision
++  // Banker's rounding operates in Float64 space on this value
++  const rounded = bankersRound(mph_single, 1);
++  return rounded.toFixed(1);
++}
++
++/**
++ * V2: Cast to Single before rounding
++ * This would break banker's rounding at ties (what we thought was a bug)
++ */
++function formatMPH_V2_BROKEN(mph_double: number): string {
++  // Cast to Float32 THEN round
++  const mph_single = f32(mph_double);
++  const rounded = bankersRound(mph_single, 1);
++  return rounded.toFixed(1);
++}
++
++/**
++ * Get exact Float32 bit representation
++ */
++function getFloat32Bits(x: number): string {
++  const arr = new Float32Array(1);
++  const view = new Uint32Array(arr.buffer);
++  arr[0] = x;
++  return '0x' + view[0].toString(16).padStart(8, '0');
++}
++
++/**
++ * Get exact Float32 value as decimal string
++ */
++function getFloat32Exact(x: number): string {
++  return f32(x).toString();
++}
++
++describe('VB6 Pipeline Proof - MPH Formatting', () => {
++  describe('Understanding Float32 representation at tie points', () => {
