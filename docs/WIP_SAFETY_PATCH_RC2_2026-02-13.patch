++function computeETFlipDistance(et_raw: number, expected_display: string): {
++  delta_to_flip_s: number;
++  actual_display: string;
++  flip_direction: 'up' | 'down' | 'none';
++} {
++  const actualRounded = bankersRound(et_raw, 2);
++  const actualDisplay = actualRounded.toFixed(2);
++  const expectedValue = parseFloat(expected_display);
++  
++  if (actualRounded === expectedValue) {
++    return { delta_to_flip_s: 0, actual_display: actualDisplay, flip_direction: 'none' };
++  }
++  
++  const flip_direction = actualRounded < expectedValue ? 'up' : 'down';
++  
++  // Find flip boundary
++  const scale = 100;
++  const targetScaled = Math.round(expectedValue * scale);
++  const isEven = targetScaled % 2 === 0;
++  
++  let boundary: number;
++  if (flip_direction === 'up') {
++    const prevValue = targetScaled - 1;
++    const midpoint = (prevValue + targetScaled) / 2 / scale;
++    boundary = isEven ? midpoint : midpoint + 1e-15;
++  } else {
++    const nextValue = targetScaled + 1;
++    const midpoint = (targetScaled + nextValue) / 2 / scale;
++    boundary = isEven ? midpoint : midpoint - 1e-15;
++  }
++  
++  const delta_to_flip_s = Math.abs(et_raw - boundary);
++  
++  return { delta_to_flip_s, actual_display: actualDisplay, flip_direction };
++}
