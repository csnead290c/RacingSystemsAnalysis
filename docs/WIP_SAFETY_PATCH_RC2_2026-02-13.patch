++  writeFileSync(`./reports/${caseId}_step_ref.csv`, vb6CSV, 'utf-8');
++  
++  console.log(`✓ ./reports/${caseId}_step_ts.csv`);
++  console.log(`✓ ./reports/${caseId}_step_ref.csv`);
++}
++
++/**
++ * Convert steps to CSV
++ */
++function stepsToCSV(steps: StepSnapshot[]): string {
++  const headers = [
++    'step', 'time_s', 'time_abs_s', 'dist_ft', 'dist_abs_ft', 'vel_fps',
++    'accel_ftps2', 'accel_g', 'gear', 'rpm', 'engine_hp', 'engine_tq',
++    'wheel_tq', 'tire_force', 'drag_force', 'roll_force', 'net_force'
++  ];
++  
++  const lines = [headers.join(',')];
++  
++  for (const step of steps) {
++    const values = headers.map(h => {
++      const v = (step as any)[h];
++      return v !== undefined ? String(v) : '';
++    });
++    lines.push(values.join(','));
++  }
++  
++  return lines.join('\n');
++}
