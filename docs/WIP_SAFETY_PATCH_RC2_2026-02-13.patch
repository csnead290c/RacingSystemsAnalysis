++  const trackLen = RACE_LENGTH_INFO[raceLength as keyof typeof RACE_LENGTH_INFO]?.lengthFt ?? 0;
++  const visible = milePts.filter(p => p.dist_ft <= trackLen);
++
++  const results: Array<{ label: string; dist_ft: number; time_s: number; mph: number }> = [];
++  for (const pt of visible) {
++    const interp = interpolateTraceAtDist(traces, pt.dist_ft);
