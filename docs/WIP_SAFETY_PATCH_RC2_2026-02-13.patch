++/**
++ * Effective Clutch Resolver
++ *
++ * Pure helper that resolves a vehicle's "effective clutch" by checking
++ * (in priority order):
++ *   1. clutchInstall  — pinned asset from the library, with optional overrides
++ *   2. clutchManual   — manual entry (no asset link)
++ *   3. legacy fields  — clutchSlipRPM / clutchLaunchRPM / clutchSlippage on the vehicle
++ *
++ * Returns a normalized object so consumers don't need to know the source.
++ *
++ * Design: pure function, no side-effects, no React dependency.
++ */
++
++import type {
++  ClutchAsset,
++  ClutchOverridePatch,
++} from '../library/clutchAssets';
++
++// ── Output types ────────────────────────────────────────────────────
++
++export type EffectiveClutchSource = 'install' | 'manual' | 'legacy' | 'none';
++
++export interface EffectiveClutch {
++  source: EffectiveClutchSource;
++  slipRPM?: number;
++  launchRPM?: number;
++  slippage?: number;
++  lockup?: boolean;
++  /** Info about the installed asset (only when source === 'install') */
++  installed?: {
++    assetId: string;
++    pinnedRevision: number;
++    name: string;
++    kind: ClutchAsset['kind'];
++  };
++  /** Whether override patch is actively applied */
++  overridesActive: boolean;
++}
++
++// ── Minimal vehicle shape we need ───────────────────────────────────
++
++export interface VehicleClutchFields {
++  clutchInstall?: {
++    clutchAssetId: string;
++    pinnedRevision: number;
++    overrides?: ClutchOverridePatch;
++  };
++  clutchManual?: {
++    slipRPM: number;
++    launchRPM?: number;
++    slippage?: number;
++    lockup?: boolean;
++  };
++  // Legacy fields
++  clutchSlipRPM?: number;
++  clutchLaunchRPM?: number;
++  clutchSlippage?: number;
++  clutchLockup?: boolean;
++}
++
++/** Function signature for looking up a clutch asset by ID. */
++export type GetClutchAssetFn = (id: string) => ClutchAsset | undefined;
++
++// ── Resolver ────────────────────────────────────────────────────────
++
++/**
++ * Resolve the effective clutch configuration for a vehicle.
++ *
++ * Priority: clutchInstall > clutchManual > legacy fields.
++ */
++export interface ResolveClutchOptions {
++  /** When false, skip clutchInstall and fall through to manual/legacy (non-Pro path). Default: true */
++  allowInstall?: boolean;
++}
++
++export function resolveVehicleClutch(
++  vehicle: VehicleClutchFields,
++  getAsset: GetClutchAssetFn,
++  options: ResolveClutchOptions = {},
++): EffectiveClutch {
++  const { allowInstall = true } = options;
++
++  // ── 1. Installed asset ──────────────────────────────────────────
++  if (allowInstall && vehicle.clutchInstall) {
++    const { clutchAssetId, pinnedRevision, overrides } = vehicle.clutchInstall;
++    const asset = getAsset(clutchAssetId);
++
++    if (asset) {
++      const hasOverrides = overrides != null && Object.keys(overrides).length > 0;
++
++      // Extract base values from asset payload
++      let slipRPM: number;
++      let launchRPM: number | undefined;
++      let slippage: number | undefined;
++      let lockup: boolean | undefined;
++
++      if (asset.kind === 'sim') {
++        const s = asset.payload.clutchSimResultSummary;
++        slipRPM = s.slipRPM;
++        launchRPM = s.launchRPM;
++        slippage = s.slippage;
++        lockup = s.lockup;
++      } else {
++        // manual or measured
++        slipRPM = asset.payload.slipRPM;
++        launchRPM = asset.payload.launchRPM;
++        slippage = asset.payload.slippage;
++        lockup = asset.payload.lockup;
++      }
++
++      // Apply overrides
++      if (overrides) {
++        if (overrides.slipRPM != null) slipRPM = overrides.slipRPM;
++        if (overrides.launchRPM != null) launchRPM = overrides.launchRPM;
++        if (overrides.slippage != null) slippage = overrides.slippage;
++        if (overrides.lockup != null) lockup = overrides.lockup;
++      }
++
++      return {
++        source: 'install',
++        slipRPM,
++        launchRPM,
++        slippage,
++        lockup,
++        installed: {
++          assetId: clutchAssetId,
++          pinnedRevision,
++          name: asset.name,
++          kind: asset.kind,
++        },
++        overridesActive: hasOverrides,
++      };
++    }
++
++    // Asset not found — fall through gracefully
++  }
++
++  // ── 2. Manual entry ─────────────────────────────────────────────
++  if (vehicle.clutchManual) {
++    return {
++      source: 'manual',
++      slipRPM: vehicle.clutchManual.slipRPM,
++      launchRPM: vehicle.clutchManual.launchRPM,
++      slippage: vehicle.clutchManual.slippage,
++      lockup: vehicle.clutchManual.lockup,
++      overridesActive: false,
++    };
++  }
++
++  // ── 3. Legacy fields ────────────────────────────────────────────
++  if (vehicle.clutchSlipRPM != null && vehicle.clutchSlipRPM > 0) {
++    return {
++      source: 'legacy',
++      slipRPM: vehicle.clutchSlipRPM,
++      launchRPM: vehicle.clutchLaunchRPM,
++      slippage: vehicle.clutchSlippage,
++      lockup: vehicle.clutchLockup,
++      overridesActive: false,
++    };
++  }
++
++  // ── 4. Nothing ──────────────────────────────────────────────────
++  return {
++    source: 'none',
++    overridesActive: false,
++  };
++}
+diff --git a/src/domain/vehicles/effectiveEngine.ts b/src/domain/vehicles/effectiveEngine.ts
+new file mode 100644
