++++ b/src/domain/vehicles/effectiveEngine.ts
+@@ -0,0 +1,224 @@
++/**
++ * Effective Engine Resolver
++ *
++ * Single pure helper that resolves a vehicle's "effective engine input" by
++ * checking (in priority order):
++ *   1. engineInstall  — pinned asset from the library, with optional overrides
++ *   2. engineManual   — manual entry (peak or dyno curve, no asset link)
++ *   3. legacy fields  — powerHP / rpmAtPeakHP / hpCurve on the vehicle itself
++ *
++ * Returns a normalized object that any sim page can consume without knowing
++ * which source the data came from.
++ *
++ * Design: pure function, no side-effects, no React dependency.
++ * The caller injects a `getAssetFn` so this module has no direct dependency
++ * on localStorage or any store.
++ */
++
++import type {
++  EngineAsset,
++  EngineOverridePatch,
++  DynoCurvePoint,
++} from '../library/engineAssets';
++import {
++  toQuarterJrEngineInput,
++  toQuarterProEngineInput,
++} from '../library/engineAssets';
++
++// ── Output types ────────────────────────────────────────────────────
++
++export type EffectiveEngineSource = 'install' | 'manual' | 'legacy' | 'none';
++export type EffectiveEngineMode = 'manual_peak' | 'dyno_curve';
++
++export interface EffectiveEngine {
++  source: EffectiveEngineSource;
++  mode: EffectiveEngineMode;
++  /** QuarterJr-compatible peak values (always present when source !== 'none') */
++  quarterJr?: {
++    peakHP: number;
++    peakHpRpm: number;
++    peakTQ?: number;
++    peakTqRpm?: number;
++  };
++  /** QuarterPro-compatible dyno points (present when mode === 'dyno_curve') */
++  quarterPro?: {
++    points: DynoCurvePoint[];
++  };
++  /** Info about the installed asset (only when source === 'install') */
++  installed?: {
++    assetId: string;
++    pinnedRevision: number;
++    name: string;
++    kind: EngineAsset['kind'];
++  };
++  /** Whether override patch is actively applied */
++  overridesActive: boolean;
++}
++
++// ── Minimal vehicle shape we need ───────────────────────────────────
++
++export interface VehicleEngineFields {
++  engineInstall?: {
++    engineAssetId: string;
++    pinnedRevision: number;
++    overrides?: EngineOverridePatch;
++  };
++  engineManual?: {
++    mode: 'manual_peak' | 'dyno_curve';
++    manualPeak?: {
++      peakHP: number;
++      peakHpRpm: number;
++      peakTQ?: number;
++      peakTqRpm?: number;
++    };
++    dynoCurve?: {
++      points: DynoCurvePoint[];
++    };
++  };
++  // Legacy fields
++  powerHP?: number;
++  rpmAtPeakHP?: number;
++  hpCurve?: Array<{ rpm: number; hp: number }>;
++  hpTorqueMultiplier?: number;
++}
++
++/** Function signature for looking up an engine asset by ID. */
++export type GetEngineAssetFn = (id: string) => EngineAsset | undefined;
++
++// ── Resolver ────────────────────────────────────────────────────────
++
++/**
++ * Resolve the effective engine configuration for a vehicle.
++ *
++ * Priority: engineInstall > engineManual > legacy fields.
++ *
++ * @param vehicle  - Vehicle (or partial) with engine-related fields
++ * @param getAsset - Injected lookup function (keeps this module pure)
++ */
++export interface ResolveEngineOptions {
++  /** When false, skip engineInstall and fall through to manual/legacy (non-Pro path). Default: true */
++  allowInstall?: boolean;
++}
++
++export function resolveVehicleEngine(
++  vehicle: VehicleEngineFields,
++  getAsset: GetEngineAssetFn,
++  options: ResolveEngineOptions = {},
++): EffectiveEngine {
++  const { allowInstall = true } = options;
++
++  // ── 1. Installed asset ──────────────────────────────────────────
++  if (allowInstall && vehicle.engineInstall) {
++    const { engineAssetId, pinnedRevision, overrides } = vehicle.engineInstall;
++    const asset = getAsset(engineAssetId);
++
++    if (asset) {
++      const jr = toQuarterJrEngineInput(asset, overrides);
++      const pro = toQuarterProEngineInput(asset, overrides);
++      const hasOverrides = overrides != null && Object.keys(overrides).length > 0;
++
++      // Determine mode: dyno_curve if asset is dyno_curve kind, else manual_peak
++      const mode: EffectiveEngineMode =
++        asset.kind === 'dyno_curve' ? 'dyno_curve' : 'manual_peak';
++
++      return {
++        source: 'install',
++        mode,
++        quarterJr: {
++          peakHP: jr.peakHP,
++          peakHpRpm: jr.peakHpRpm,
++          peakTQ: jr.peakTQ,
++          peakTqRpm: jr.peakTqRpm,
++        },
++        quarterPro: { points: pro.dynoPoints },
++        installed: {
++          assetId: engineAssetId,
++          pinnedRevision,
++          name: asset.name,
++          kind: asset.kind,
++        },
++        overridesActive: hasOverrides,
++      };
++    }
++
++    // Asset not found — fall through to manual/legacy with install metadata
++    // (graceful degradation: don't crash, just use whatever else is available)
++  }
++
++  // ── 2. Manual entry ─────────────────────────────────────────────
++  if (vehicle.engineManual) {
++    const { mode, manualPeak, dynoCurve } = vehicle.engineManual;
++
++    if (mode === 'dyno_curve' && dynoCurve?.points && dynoCurve.points.length > 0) {
++      // Derive peak from curve
++      let maxHp = 0, maxTq = 0, hpRpm = 0, tqRpm = 0;
++      for (const pt of dynoCurve.points) {
++        if (pt.hp > maxHp) { maxHp = pt.hp; hpRpm = pt.rpm; }
++        if (pt.tq > maxTq) { maxTq = pt.tq; tqRpm = pt.rpm; }
++      }
++      return {
++        source: 'manual',
++        mode: 'dyno_curve',
++        quarterJr: { peakHP: maxHp, peakHpRpm: hpRpm, peakTQ: maxTq, peakTqRpm: tqRpm },
++        quarterPro: { points: dynoCurve.points },
++        overridesActive: false,
++      };
++    }
++
++    if (mode === 'manual_peak' && manualPeak) {
++      return {
++        source: 'manual',
++        mode: 'manual_peak',
++        quarterJr: {
++          peakHP: manualPeak.peakHP,
++          peakHpRpm: manualPeak.peakHpRpm,
++          peakTQ: manualPeak.peakTQ,
++          peakTqRpm: manualPeak.peakTqRpm,
++        },
++        overridesActive: false,
++      };
++    }
++  }
++
++  // ── 3. Legacy fields ────────────────────────────────────────────
++  if (vehicle.hpCurve && vehicle.hpCurve.length >= 2) {
++    // Full HP curve → dyno_curve mode
++    const mult = vehicle.hpTorqueMultiplier ?? 1;
++    const points: DynoCurvePoint[] = vehicle.hpCurve.map(pt => ({
++      rpm: pt.rpm,
++      hp: pt.hp * mult,
++      tq: pt.rpm > 0 ? (pt.hp * mult * 5252) / pt.rpm : 0,
++    }));
++    let maxHp = 0, maxTq = 0, hpRpm = 0, tqRpm = 0;
++    for (const pt of points) {
++      if (pt.hp > maxHp) { maxHp = pt.hp; hpRpm = pt.rpm; }
++      if (pt.tq > maxTq) { maxTq = pt.tq; tqRpm = pt.rpm; }
++    }
++    return {
++      source: 'legacy',
++      mode: 'dyno_curve',
++      quarterJr: { peakHP: maxHp, peakHpRpm: hpRpm, peakTQ: maxTq, peakTqRpm: tqRpm },
++      quarterPro: { points },
++      overridesActive: false,
++    };
++  }
++
++  if (vehicle.powerHP != null && vehicle.powerHP > 0) {
++    return {
++      source: 'legacy',
++      mode: 'manual_peak',
++      quarterJr: {
++        peakHP: vehicle.powerHP,
++        peakHpRpm: vehicle.rpmAtPeakHP ?? 6500,
++      },
++      overridesActive: false,
++    };
++  }
++
++  // ── 4. Nothing ──────────────────────────────────────────────────
++  return {
++    source: 'none',
++    mode: 'manual_peak',
++    overridesActive: false,
++  };
++}
