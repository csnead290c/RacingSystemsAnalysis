++Attribute VB_Name = "TraceLog"
++'==============================================================================
++' TraceLog.bas - Buffered CSV Step Trace Logger for VB6 Parity Analysis
++'==============================================================================
++' Purpose: Write step-by-step simulation state to CSV for TS comparison
++' Usage:
++'   Call TraceOpen("QuarterProTest1", "C:\path\to\reports\vb6_step_traces\QuarterProTest1.csv")
++'   Call TraceWriteRow(step, time_s, dist_ft, ...) ' each integration step
++'   Call TraceClose()
++'==============================================================================
++
++Option Explicit
++
++' Module-level variables
++Private m_FileNum As Integer
++Private m_IsOpen As Boolean
++Private m_CaseId As String
++Private m_FilePath As String
++
++'==============================================================================
++' TraceOpen - Initialize trace file and write header
++'==============================================================================
++Public Sub TraceOpen(caseId As String, filePath As String)
++    On Error GoTo ErrorHandler
++    
++    ' Close any existing file
++    If m_IsOpen Then
++        Call TraceClose
++    End If
++    
++    m_CaseId = caseId
++    m_FilePath = filePath
++    m_FileNum = FreeFile
++    
++    ' Open file for output (overwrites if exists)
++    Open m_FilePath For Output As #m_FileNum
++    
++    ' Write CSV header (EXACT order required)
++    Print #m_FileNum, "case_id,step,time_s,dist_ft,vel_fps,mph,accel_g,jerk_g,gear,engine_rpm,driveshaft_rpm," & _
++                      "eng_tq,eng_hp,clutch_slip,converter_slip,trq_mult," & _
++                      "tire_force_lbf,drag_lbf,roll_res_lbf,grade_lbf,net_force_lbf," & _
++                      "rear_wt_lbf,traction_limit_lbf,is_traction_limited," & _
++                      "dt_s,trigger_fired"
++    
++    m_IsOpen = True
++    Exit Sub
++    
++ErrorHandler:
++    MsgBox "TraceOpen Error: " & Err.Description & vbCrLf & "Path: " & filePath, vbCritical
++    m_IsOpen = False
++End Sub
++
++'==============================================================================
++' TraceWriteRow - Write one step to CSV (culture-invariant formatting)
++'==============================================================================
++Public Sub TraceWriteRow( _
++    stepNum As Long, _
++    time_s As Double, _
++    dist_ft As Double, _
++    vel_fps As Double, _
++    mph As Double, _
++    accel_g As Double, _
++    jerk_g As Double, _
++    gear As Integer, _
++    engine_rpm As Double, _
++    driveshaft_rpm As Double, _
++    eng_tq As Double, _
++    eng_hp As Double, _
++    clutch_slip As Double, _
++    converter_slip As Double, _
++    trq_mult As Double, _
++    tire_force_lbf As Double, _
++    drag_lbf As Double, _
++    roll_res_lbf As Double, _
++    grade_lbf As Double, _
++    net_force_lbf As Double, _
++    rear_wt_lbf As Double, _
++    traction_limit_lbf As Double, _
++    is_traction_limited As Integer, _
++    dt_s As Double, _
++    trigger_fired As String)
++    
++    On Error GoTo ErrorHandler
++    
++    If Not m_IsOpen Then
++        Exit Sub ' Silently skip if not open
++    End If
++    
++    ' Format all numbers with "." decimal separator (culture-invariant)
++    ' Use CStr and Replace to ensure "." not ","
++    Dim row As String
++    row = m_CaseId & "," & _
++          CStr(stepNum) & "," & _
++          FormatNum(time_s) & "," & _
++          FormatNum(dist_ft) & "," & _
++          FormatNum(vel_fps) & "," & _
++          FormatNum(mph) & "," & _
++          FormatNum(accel_g) & "," & _
++          FormatNum(jerk_g) & "," & _
++          CStr(gear) & "," & _
++          FormatNum(engine_rpm) & "," & _
++          FormatNum(driveshaft_rpm) & "," & _
++          FormatNum(eng_tq) & "," & _
++          FormatNum(eng_hp) & "," & _
++          FormatNum(clutch_slip) & "," & _
++          FormatNum(converter_slip) & "," & _
++          FormatNum(trq_mult) & "," & _
++          FormatNum(tire_force_lbf) & "," & _
++          FormatNum(drag_lbf) & "," & _
++          FormatNum(roll_res_lbf) & "," & _
++          FormatNum(grade_lbf) & "," & _
++          FormatNum(net_force_lbf) & "," & _
++          FormatNum(rear_wt_lbf) & "," & _
++          FormatNum(traction_limit_lbf) & "," & _
++          CStr(is_traction_limited) & "," & _
++          FormatNum(dt_s) & "," & _
++          trigger_fired
++    
++    Print #m_FileNum, row
++    Exit Sub
++    
++ErrorHandler:
++    ' Don't crash simulation - just stop logging
++    m_IsOpen = False
++End Sub
++
++'==============================================================================
++' TraceClose - Flush and close trace file
++'==============================================================================
++Public Sub TraceClose()
++    On Error Resume Next
++    
++    If m_IsOpen Then
++        Close #m_FileNum
++        m_IsOpen = False
++    End If
++End Sub
++
++'==============================================================================
++' FormatNum - Culture-invariant number formatting (always use "." for decimal)
++'==============================================================================
++Private Function FormatNum(value As Double) As String
++    Dim s As String
++    s = CStr(value)
++    ' Replace comma with period if locale uses comma
++    s = Replace(s, ",", ".")
++    FormatNum = s
++End Function
++
++'==============================================================================
++' IsTraceOpen - Check if trace is currently active
++'==============================================================================
++Public Function IsTraceOpen() As Boolean
++    IsTraceOpen = m_IsOpen
++End Function
