++' Helper function to get Single bit pattern as hex string
++Private Function SingleToHex(ByVal sngValue As Single) As String
++    Dim lngBits As Long
++    CopyMemory lngBits, sngValue, 4
++    SingleToHex = "0x" & Right$("00000000" & Hex$(lngBits), 8)
++End Function
