++    checkpointData = (QUARTERPRO_CHECKPOINTS_EXTRACTED as any[]).find((c: any) => c.caseId === caseId);
++  } else if (model === 'BonnevillePro') {
++    checkpointData = (BONNEVILLEPRO_CHECKPOINTS_EXTRACTED as any[]).find((c: any) => c.caseId === caseId);
