++/**
++ * Checkpoint Comparator for VB6 ↔ TS parity testing.
++ * 
++ * Aligns VB6 reference checkpoints with TS simulation traces by dist_ft,
++ * then compares fields with configurable per-field tolerances.
++ * Produces a readable diff report on failure.
++ */
++
++import type { NormalizedCheckpoint } from './user_vb6_fixture_adapter';
++
++// ============================================================================
++// Tolerance configuration
++// ============================================================================
++
++export interface FieldTolerance {
++  /** Absolute tolerance (e.g., ±0.5 for time_s means 0.5s window) */
++  abs: number;
++  /** Relative tolerance as fraction (e.g., 0.02 = 2%). Applied as max(abs, rel*expected). */
++  rel?: number;
++}
++
++export interface CheckpointTolerances {
++  /** Distance window for aligning VB6 checkpoint to nearest TS trace point */
++  distAlign_ft: number;
++  /** Per-field tolerances */
++  time_s: FieldTolerance;
++  mph: FieldTolerance;
++  accel_g: FieldTolerance;
++  gear: FieldTolerance;
++  rpm: FieldTolerance;
++}
++
++/**
++ * Default tolerances — intentionally loose for initial bring-up.
++ * Tighten these as parity improves.
++ */
++export const DEFAULT_TOLERANCES: CheckpointTolerances = {
++  distAlign_ft: 5.0,       // ±5 ft window for alignment
++  time_s:  { abs: 0.50, rel: 0.03 },  // ±0.50s or ±3%
++  mph:     { abs: 3.0,  rel: 0.03 },  // ±3.0 mph or ±3%
++  accel_g: { abs: 0.15, rel: 0.10 },  // ±0.15g or ±10%
++  gear:    { abs: 0 },                 // exact match
++  rpm:     { abs: 200,  rel: 0.05 },  // ±200 RPM or ±5%
++};
++
++/**
++ * Tight tolerances for well-tuned fixtures.
++ */
++export const TIGHT_TOLERANCES: CheckpointTolerances = {
++  distAlign_ft: 2.0,
++  time_s:  { abs: 0.10, rel: 0.01 },
++  mph:     { abs: 1.0,  rel: 0.01 },
++  accel_g: { abs: 0.05, rel: 0.05 },
++  gear:    { abs: 0 },
++  rpm:     { abs: 100,  rel: 0.02 },
++};
++
++// ============================================================================
++// Comparison result types
++// ============================================================================
++
++export interface FieldDiff {
++  field: string;
++  vb6: number;
++  ts: number;
++  delta: number;
++  tolerance: number;
++  pass: boolean;
++}
++
++export interface CheckpointComparison {
++  index: number;
++  vb6: NormalizedCheckpoint;
++  ts: NormalizedCheckpoint;
++  distError_ft: number;
++  fields: FieldDiff[];
++  pass: boolean;
++}
++
++export interface ComparisonResult {
++  caseId: string;
++  pass: boolean;
++  totalCheckpoints: number;
++  passedCheckpoints: number;
++  failedCheckpoints: number;
++  unmatchedCheckpoints: number;
++  comparisons: CheckpointComparison[];
++  unmatched: { index: number; vb6: NormalizedCheckpoint; reason: string }[];
++  /** First failing comparison index (or -1 if all pass) */
++  firstFailureIndex: number;
++}
++
++// ============================================================================
++// Core comparison logic
++// ============================================================================
++
++/**
++ * Linearly interpolate between two checkpoints at a target distance.
++ */
++export function lerpCheckpoint(
++  a: NormalizedCheckpoint,
++  b: NormalizedCheckpoint,
++  targetDist: number,
++): NormalizedCheckpoint {
++  if (Math.abs(b.dist_ft - a.dist_ft) < 1e-9) return a;
++  const t = (targetDist - a.dist_ft) / (b.dist_ft - a.dist_ft);
++  return {
++    dist_ft: targetDist,
++    time_s: a.time_s + t * (b.time_s - a.time_s),
++    mph: a.mph + t * (b.mph - a.mph),
++    accel_g: a.accel_g + t * (b.accel_g - a.accel_g),
++    gear: Math.round(a.gear + t * (b.gear - a.gear)),  // snap to nearest int
++    rpm: a.rpm + t * (b.rpm - a.rpm),
++  };
++}
++
++/**
++ * Find or interpolate a TS trace point at a given VB6 checkpoint distance.
++ * 
++ * Strategy:
++ * 1. Find the two bracketing TS trace points (before and after vb6Dist).
++ * 2. Linearly interpolate all fields between them.
++ * 3. If vb6Dist is beyond the TS trace range, return null.
++ */
++export function interpolateAtDist(
++  vb6Dist: number,
++  tsTraces: NormalizedCheckpoint[],
++): NormalizedCheckpoint | null {
++  if (tsTraces.length === 0) return null;
++
++  // Exact or very close match — use directly
++  for (const t of tsTraces) {
++    if (Math.abs(t.dist_ft - vb6Dist) < 0.5) return t;
++  }
++
++  // Find bracketing pair
++  for (let i = 0; i < tsTraces.length - 1; i++) {
++    const a = tsTraces[i];
++    const b = tsTraces[i + 1];
++    if (a.dist_ft <= vb6Dist && b.dist_ft >= vb6Dist) {
++      return lerpCheckpoint(a, b, vb6Dist);
++    }
++  }
++
++  // Beyond range — check if close to first or last
++  if (vb6Dist < tsTraces[0].dist_ft && Math.abs(vb6Dist - tsTraces[0].dist_ft) < 10) {
++    return tsTraces[0];
++  }
++  const last = tsTraces[tsTraces.length - 1];
++  if (vb6Dist > last.dist_ft && Math.abs(vb6Dist - last.dist_ft) < 10) {
++    return last;
++  }
++
++  return null;
++}
++
++/**
++ * Check if a value is within tolerance of the expected value.
++ */
++function withinTolerance(actual: number, expected: number, tol: FieldTolerance): { pass: boolean; tolerance: number } {
++  const relTol = tol.rel ? Math.abs(expected) * tol.rel : 0;
++  const tolerance = Math.max(tol.abs, relTol);
++  const pass = Math.abs(actual - expected) <= tolerance;
++  return { pass, tolerance };
++}
++
++/**
++ * Compare a single VB6 checkpoint against its matched TS trace point.
++ */
++function compareCheckpoint(
++  index: number,
++  vb6: NormalizedCheckpoint,
++  ts: NormalizedCheckpoint,
++  tol: CheckpointTolerances,
++): CheckpointComparison {
++  const fields: FieldDiff[] = [];
++
++  const compareField = (name: string, vb6Val: number, tsVal: number, fieldTol: FieldTolerance) => {
++    const { pass, tolerance } = withinTolerance(tsVal, vb6Val, fieldTol);
++    fields.push({
++      field: name,
++      vb6: vb6Val,
++      ts: tsVal,
++      delta: tsVal - vb6Val,
++      tolerance,
++      pass,
++    });
++  };
++
++  compareField('time_s', vb6.time_s, ts.time_s, tol.time_s);
++  compareField('mph', vb6.mph, ts.mph, tol.mph);
++  compareField('accel_g', vb6.accel_g, ts.accel_g, tol.accel_g);
++  compareField('gear', vb6.gear, ts.gear, tol.gear);
++  compareField('rpm', vb6.rpm, ts.rpm, tol.rpm);
++
++  const allPass = fields.every(f => f.pass);
++
++  return {
++    index,
++    vb6,
++    ts,
++    distError_ft: Math.abs(ts.dist_ft - vb6.dist_ft),
++    fields,
++    pass: allPass,
++  };
++}
++
++/**
++ * Compare VB6 checkpoints against TS simulation traces.
++ * 
++ * @param caseId - Fixture case ID for reporting
++ * @param vb6Checkpoints - Normalized VB6 reference checkpoints
++ * @param tsTraces - Normalized TS simulation trace points
++ * @param tolerances - Per-field tolerances (default: DEFAULT_TOLERANCES)
++ * @param skipRollout - Skip rollout rows (default: true, since rollout timing differs)
++ */
++export function compareCheckpoints(
++  caseId: string,
++  vb6Checkpoints: NormalizedCheckpoint[],
++  tsTraces: NormalizedCheckpoint[],
++  tolerances: CheckpointTolerances = DEFAULT_TOLERANCES,
++  skipRollout = true,
++): ComparisonResult {
++  const comparisons: CheckpointComparison[] = [];
++  const unmatched: { index: number; vb6: NormalizedCheckpoint; reason: string }[] = [];
++
++  const filteredVB6 = skipRollout
++    ? vb6Checkpoints.filter(cp => !cp.isRollout)
++    : vb6Checkpoints;
++
++  for (let i = 0; i < filteredVB6.length; i++) {
++    const vb6 = filteredVB6[i];
++    const interpolated = interpolateAtDist(vb6.dist_ft, tsTraces);
++
++    if (!interpolated) {
++      unmatched.push({
++        index: i,
++        vb6,
++        reason: `dist=${vb6.dist_ft} ft is outside TS trace range ` +
++          `[${tsTraces[0]?.dist_ft.toFixed(1)}..${tsTraces[tsTraces.length - 1]?.dist_ft.toFixed(1)}] ft`,
++      });
++      continue;
++    }
++
++    comparisons.push(compareCheckpoint(i, vb6, interpolated, tolerances));
++  }
++
++  const passedCheckpoints = comparisons.filter(c => c.pass).length;
++  const failedCheckpoints = comparisons.filter(c => !c.pass).length;
++  const firstFailureIndex = comparisons.findIndex(c => !c.pass);
++  const allPass = failedCheckpoints === 0 && unmatched.length === 0;
++
++  return {
++    caseId,
++    pass: allPass,
++    totalCheckpoints: filteredVB6.length,
++    passedCheckpoints,
++    failedCheckpoints,
++    unmatchedCheckpoints: unmatched.length,
++    comparisons,
++    unmatched,
++    firstFailureIndex,
++  };
++}
