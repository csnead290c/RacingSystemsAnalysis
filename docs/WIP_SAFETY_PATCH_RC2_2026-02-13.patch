++function calcHP_Corrected_VB6Semantics(
++  HPTQMult: number,
++  HP: number,
++  hpc: number
++): number {
++  // gc_HPTQMult.Value is CValue (Double), HP/hpc are Single → computed in Double
++  // HP is Single → truncated on assignment
++  return vb6AssignSingle(HPTQMult * HP / hpc);
++}
++
++/**
++ * Apply ClutchSlip using VB6 semantics
++ * VB6 line 1178: HP = HP * ClutchSlip
++ */
++function calcHP_WithClutchSlip_VB6Semantics(HP: number, ClutchSlip: number): number {
++  // HP * ClutchSlip: Single * Single → Single expression
++  // HP is Single → truncated on assignment
++  return vb6AssignSingle(HP * ClutchSlip);
++}
