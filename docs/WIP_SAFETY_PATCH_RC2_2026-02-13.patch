++/**
++ * Normalize VB6 fixture checkpoints to a common format.
++ * Skips the rollout row (distance="Rollout") since it uses a different time basis.
++ */
++export function normalizeVB6Checkpoints(checkpoints: FixtureCheckpoint[]): NormalizedCheckpoint[] {
++  const result: NormalizedCheckpoint[] = [];
++
++  for (const cp of checkpoints) {
++    // Skip rollout rows (they use time_abs_s, not time_s, and distance is "Rollout")
++    if (cp.distance === 'Rollout' || cp.label === 'Rollout') {
++      result.push({
++        dist_ft: 0,
++        time_s: cp.time_abs_s ?? 0,
++        mph: cp.mph,
++        accel_g: cp.accel,
++        gear: cp.gear,
++        rpm: cp.rpm,
++        label: 'Rollout',
++        isRollout: true,
++      });
++      continue;
++    }
++
++    const dist = cp.distance_ft;
++    const time = cp.time_s;
++    if (dist == null || time == null) continue; // skip malformed rows
++
++    result.push({
++      dist_ft: dist,
++      time_s: time,
++      mph: cp.mph,
++      accel_g: cp.accel,
++      gear: cp.gear,
++      rpm: cp.rpm,
++    });
++  }
++
++  return result;
++}
