++/**
++ * Timestep Selection & Jerk Calculation Truncation Boundary Semantic Tests
++ * 
++ * This test validates that VB6 type coercion rules are correctly applied
++ * to the timestep selection and jerk calculation in vb6SimulationStep.ts.
++ * 
++ * VB6 Source: TIMESLIP.FRM lines 1082-1088
++ * 
++ * VB6 Variable Types:
++ *   TimeStep - Single (line 526)
++ *   TSMax    - Single (line 513)
++ *   AgsMax   - Single (line 507)
++ *   Ags0     - Single (line 527)
++ *   Jerk     - Single (line 513)
++ *   Work     - Single (line 539)
++ *   JMin     - Const = -4 (Double, no suffix, line 543)
++ *   JMax     - Const = 2 (Double, no suffix, line 544)
++ * 
++ * VB6 Coercion Rules:
++ *   1. Literal 4 in exponent is Double → expression computed in Double
++ *   2. Truncation to Single occurs ONLY at assignment
++ *   3. JMin/JMax are Double constants → comparison promotes Single to Double
++ */
++
++import { describe, it, expect } from 'vitest';
++import { vb6AssignSingle } from '../exactMath';
++import { JMin, JMax } from '../constants';
++
++/**
++ * Calculate adaptive timestep using VB6 semantics
++ * VB6 line 1082: TimeStep = TSMax * (AgsMax / Ags0) ^ 4
++ */
++function calcTimeStep_VB6Semantics(
++  TSMax: number,
++  AgsMax: number,
++  Ags0: number
++): number {
++  if (Ags0 <= 0) {
++    return vb6AssignSingle(TSMax);
++  }
++  // TSMax/AgsMax/Ags0 are Single, literal 4 is Double → computed in Double
++  // TimeStep is Single → truncated on assignment
++  return vb6AssignSingle(TSMax * Math.pow(AgsMax / Ags0, 4));
++}
++
++/**
++ * Calculate jerk using VB6 semantics
++ * VB6 lines 1084-1088
++ */
++function calcJerk_VB6Semantics(
++  AGS_current: number,
++  Ags0_previous: number,
++  time_current: number,
++  Time0_previous: number
++): number {
++  // VB6 line 1084: Jerk = 0
++  let Jerk = vb6AssignSingle(0);
++  
++  // VB6 line 1085: Work = time(L) - Time0
++  // time(L) and Time0 are both Single → expression is Single
++  const Work = vb6AssignSingle(time_current - Time0_previous);
