# RSA Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Clerk Authentication (OAuth)
# =============================================================================
# Get these from https://dashboard.clerk.com
# Publishable key is safe to expose in frontend code.
#
# DEV:  Use pk_test_* from your Clerk Development instance.
# PROD: Use pk_live_* from your Clerk Production instance.
#       Set this in .env.production (or your hosting provider's env vars).
#       A runtime guard will warn if pk_test_ is used in a production build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# =============================================================================
# Stripe Payments (Subscriptions)
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
# DEV:  Use pk_test_* from Stripe test mode.
# PROD: Use pk_live_* from Stripe live mode.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL for Stripe and other server-side operations
VITE_API_URL=https://racingsystemsanalysis.com/api

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable/disable features during development
# VITE_ENABLE_DEV_TOOLS=true
